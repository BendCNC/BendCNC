QT_QPA_PLATFORM=eglfs
QT_QPA_EGLFS_INTEGRATION=eglfs_kms
QT_QPA_EGLFS_KMS_CONFIG=/etc/bendcnc/eglfs-kms.json
# Keep a software pointer visible for commissioning and USB mouse operation.
# eglfs-kms.json disables the hardware cursor because RK3566 support varies.
QT_QPA_EGLFS_HIDECURSOR=0
QT_QPA_EGLFS_ALWAYS_SET_MODE=1
QT_LOGGING_RULES=qt.qpa.egldeviceintegration=true;qt.qpa.input=true
QSG_INFO=1
QML_XHR_ALLOW_FILE_READ=1
QML_XHR_ALLOW_FILE_WRITE=1
BENDCNC_QT_HOME=/data/bendcnc-qt-state
BENDCNC_IMPORT_DIR=/data/bendcnc-qt-state/imports
XDG_RUNTIME_DIR=/run/bendcnc
XDG_DATA_HOME=/data/bendcnc-qt-state/data
XDG_CONFIG_HOME=/data/bendcnc-qt-state/config
XDG_STATE_HOME=/data/bendcnc-qt-state/state
