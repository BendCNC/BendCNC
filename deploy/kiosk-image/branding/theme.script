Window.SetBackgroundTopColor(0.133, 0.133, 0.133);
Window.SetBackgroundBottomColor(0.133, 0.133, 0.133);

image = Image("loading.png");
scale = Math.Min(Window.GetWidth() / image.GetWidth(), Window.GetHeight() / image.GetHeight());
image = image.Scale(image.GetWidth() * scale, image.GetHeight() * scale);

sprite = Sprite(image);
sprite.SetX(Window.GetWidth() / 2 - image.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - image.GetHeight() / 2);
sprite.SetZ(15);
