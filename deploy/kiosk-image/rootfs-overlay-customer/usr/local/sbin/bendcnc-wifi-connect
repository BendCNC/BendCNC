#!/bin/bash
# Root helper for the setup wizard: connect to a Wi-Fi network without relying
# on polkit (the wizard runs as a service with no login session).
# Usage: bendcnc-wifi-connect <ssid>   (password, if any, on stdin)
set -u
SSID=${1:-}
[[ -n $SSID && ${#SSID} -le 32 ]] || { echo "invalid SSID" >&2; exit 2; }
IFS= read -r PASS || true
LOG=/data/bendcnc-qt-state/logs/wifi.log
mkdir -p "${LOG%/*}" 2>/dev/null || LOG=/dev/null
log() { echo "$(date -Is) $*" >> "$LOG"; }

nmcli radio wifi on >/dev/null 2>&1 || true
IFACE=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
[[ -n $IFACE ]] || { log "no wifi device"; echo "No Wi-Fi adapter found" >&2; exit 3; }
nmcli dev set "$IFACE" managed yes >/dev/null 2>&1 || true
# Replace any stale profile with this name (wrong password from a prior try).
nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: -v s="$SSID" '$1==s && $2 ~ /wireless/{print $1}' |
    while IFS= read -r c; do nmcli con delete id "$c" >/dev/null 2>&1; done
# Fresh scan so NM knows the AP security (avoids "key-mgmt missing").
nmcli dev wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
for _ in 1 2 3 4 5; do
    nmcli -t -f SSID dev wifi list ifname "$IFACE" 2>/dev/null | grep -Fxq -- "$SSID" && break
    sleep 2
done
args=(--wait 45 dev wifi connect "$SSID" ifname "$IFACE")
[[ -n $PASS ]] && args+=(password "$PASS")
out=$(nmcli "${args[@]}" 2>&1); rc=$?
log "connect ssid=$SSID iface=$IFACE rc=$rc: $out"
if (( rc != 0 )); then
    nmcli con delete id "$SSID" >/dev/null 2>&1 || true
    echo "$out" | sed 's/^Error: //' | tail -n 1 >&2
fi
exit $rc
