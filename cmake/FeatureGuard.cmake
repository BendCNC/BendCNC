# cmake -DROOT=<qt dir> -P FeatureGuard.cmake
# Fails when a marker listed in tools/feature-guard.txt is missing.
file(STRINGS "${ROOT}/tools/feature-guard.txt" lines ENCODING UTF-8)
set(missing "")
set(count 0)
foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    string(FIND "${line}" "|" bar)
    if(bar LESS 0)
        message(FATAL_ERROR "feature-guard: malformed line: ${line}")
    endif()
    string(SUBSTRING "${line}" 0 ${bar} rel)
    math(EXPR start "${bar} + 1")
    string(SUBSTRING "${line}" ${start} -1 marker)
    string(STRIP "${rel}" rel)
    string(STRIP "${marker}" marker)
    if(NOT EXISTS "${ROOT}/${rel}")
        list(APPEND missing "${rel}: file missing")
        continue()
    endif()
    file(READ "${ROOT}/${rel}" content)
    string(FIND "${content}" "${marker}" pos)
    if(pos LESS 0)
        list(APPEND missing "${rel}: '${marker}'")
    endif()
    math(EXPR count "${count} + 1")
endforeach()
if(missing)
    list(JOIN missing "\n  " text)
    message(FATAL_ERROR "FEATURE REGRESSION GUARD FAILED - features missing:\n  ${text}\n"
        "Restore the file (git diff / git checkout) or, if removal is intended, edit tools/feature-guard.txt.")
endif()
message(STATUS "feature-guard: ${count} markers OK")
