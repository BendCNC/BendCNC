        var r = finite(translateR, 0)
        bounds.minX = Math.min(bounds.minX, cached.minX)
        bounds.maxX = Math.max(bounds.maxX, cached.maxX)
        bounds.minR = Math.min(bounds.minR, cached.minR + r)
        bounds.maxR = Math.max(bounds.maxR, cached.maxR + r)
