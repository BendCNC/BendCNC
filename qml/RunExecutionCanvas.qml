        var orderedPanels = orderedLivePanelsForPaint(frontPanels)
        var entries = []
        // Panels whose plane cuts the punch paint over the whole punch, then
        // the punch part on their camera side is repainted over them.
        var cutEntries = plan && plan.cut ? plan.cut : []
        var cutPanels = []
        for (var cutIndex = 0; cutIndex < cutEntries.length; cutIndex++)
            cutPanels.push(cutEntries[cutIndex].panel)
        var orderedCut = orderedLivePanelsForPaint(cutPanels)
        for (var orderedIndex = 0; orderedIndex < orderedCut.length; orderedIndex++) {
            var cutEntry = cutEntries[cutPanels.indexOf(orderedCut[orderedIndex])]
            entries.push({ panel: cutEntry.panel, clipToPunch: false,
                           punchFootprint: cutEntry.footprint })
