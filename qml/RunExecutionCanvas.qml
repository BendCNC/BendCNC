    function drawRoundRect(ctx, x, y, w, h, r, fill, stroke) {
        ctx.beginPath()
        ctx.moveTo(x + r, y)
        ctx.lineTo(x + w - r, y)
        ctx.quadraticCurveTo(x + w, y, x + w, y + r)
        ctx.lineTo(x + w, y + h - r)
        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h)
        ctx.lineTo(x + r, y + h)
        ctx.quadraticCurveTo(x, y + h, x, y + h - r)
        ctx.lineTo(x, y + r)
        ctx.quadraticCurveTo(x, y, x + r, y)
        ctx.closePath()
        if (fill) ctx.fill()
        if (stroke) ctx.stroke()
    }

    function addPlacementLoopPath(ctx, points, left, top, scale) {
        if (!points || points.length < 3)
            return false
        ctx.moveTo(left + points[0].x * scale, top + points[0].y * scale)
        for (var i = 1; i < points.length; i++)
            ctx.lineTo(left + points[i].x * scale, top + points[i].y * scale)
        ctx.closePath()
        return true
    }

    function isDrawablePlacementHoleLoop(points) {
