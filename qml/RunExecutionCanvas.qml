    function punchPaintPlanKey(model, punchProfile, segments) {
        var segmentKey = []
        for (var index = 0; segments && index < segments.length; index++)
            segmentKey.push(String(finite(segments[index].startXIn, 0))
                + ":" + String(finite(segments[index].endXIn, 0)))
        return liveStaticSceneKeyFor()
            + "|camera=" + normalizedLiveCameraOrientation()
            + "|projection=" + String(liveProjectionMode).toUpperCase()
            + "|model=" + String(model ? model._cachePath || "" : "")
            + ":" + String(dxfModelGeometryCount(model))
            + "|tip=" + String(finite(punchProfile ? punchProfile.tipLocalX : 0, 0))
            + ":" + String(finite(punchProfile ? punchProfile.tipLocalY : 0, 0))
            + "|segments=" + segmentKey.join(",")
            + "|flipX=" + String(activeLivePunchFlipX())
    }

    function preparedPunchFaceGeometry(model, punchProfile, flipX) {
        var result = { polylines: [], lines: [], circles: [], arcs: [] }
        if (!model)
            return result
        var sign = flipX === true ? -1 : 1
        function localPoint(x, y) {
            return { x: sign * (x - punchProfile.tipLocalX),
                     r: y - punchProfile.tipLocalY }
        }
        for (var p = 0; p < model.polylines.length; p++) {
            var poly = model.polylines[p]
            var source = poly.points || poly
            var points = []
            for (var i = 0; i < source.length; i++)
                points.push(localPoint(source[i].x, source[i].y))
            var closed = poly.closed || (source.length > 2
                && Math.abs(source[0].x - source[source.length - 1].x) < 0.001
                && Math.abs(source[0].y - source[source.length - 1].y) < 0.001)
            result.polylines.push({ points: points, closed: closed })
        }
        for (var l = 0; l < model.lines.length; l++) {
            result.lines.push({
                a: localPoint(model.lines[l].x1, model.lines[l].y1),
                b: localPoint(model.lines[l].x2, model.lines[l].y2)
            })
        }
        for (var c = 0; model.circles && c < model.circles.length; c++) {
            result.circles.push({
                center: localPoint(model.circles[c].cx, model.circles[c].cy),
                radius: model.circles[c].radius
            })
        }
        for (var a = 0; model.arcs && a < model.arcs.length; a++) {
            var arc = model.arcs[a]
            var extent = arc.endDeg - arc.startDeg
            if (extent < 0)
                extent += 360
            var samples = Math.max(8, Math.ceil(Math.abs(extent) / 8))
            var arcPoints = []
            for (var s = 0; s <= samples; s++) {
                var radians = (arc.startDeg + extent * s / samples) * Math.PI / 180
                arcPoints.push(localPoint(
                    arc.cx + Math.cos(radians) * arc.radius,
                    arc.cy + Math.sin(radians) * arc.radius))
            }
            result.arcs.push(arcPoints)
        }
        return result
    }

    function buildLivePunchPaintPlan(model, punchProfile, segments, flipX) {
        if (!model)
            return null
        var contour = toolingSegmentExteriorContour(
            model, punchProfile.tipLocalX, punchProfile.tipLocalY,
            0, 0, 1, flipX === true, false, 0)
        var runs = normalizedToolingSegmentRuns(segments)
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        if (runs.length === 0) {
            var vector = isometricToolingExtrusionVector()
            runs.push({ startXIn: 0, endXIn: 0, seamPositionsIn: [],
                        fallbackVector: vector })
        } else {
            runs.sort(function(left, right) {
                var leftDepth = (toolingStationCoordinate(left.startXIn)
                    + toolingStationCoordinate(left.endXIn)) * 0.5 * cameraSign
                var rightDepth = (toolingStationCoordinate(right.startXIn)
                    + toolingStationCoordinate(right.endXIn)) * 0.5 * cameraSign
                return leftDepth - rightDepth
            })
        }
        var preparedRuns = []
        for (var runIndex = 0; runIndex < runs.length; runIndex++) {
            var run = runs[runIndex]
            var startOffset = run.fallbackVector
                ? { x: 0, r: 0 }
                : toolingStationDisplayOffset(run.startXIn, "ISOMETRIC")
            var endOffset = run.fallbackVector
                ? run.fallbackVector
                : toolingStationDisplayOffset(run.endXIn, "ISOMETRIC")
            var startDepth = toolingStationCoordinate(run.startXIn) * cameraSign
            var endDepth = toolingStationCoordinate(run.endXIn) * cameraSign
            var farOffset = startDepth <= endDepth ? startOffset : endOffset
            var nearOffset = startDepth <= endDepth ? endOffset : startOffset
            var vector = { x: nearOffset.x - farOffset.x,
                           r: nearOffset.r - farOffset.r }
            var seams = []
            for (var seamIndex = 0; seamIndex < run.seamPositionsIn.length; seamIndex++)
                seams.push(toolingStationDisplayOffset(
                    run.seamPositionsIn[seamIndex], "ISOMETRIC"))
            preparedRuns.push({
                farOffset: farOffset, nearOffset: nearOffset, vector: vector,
                visibleEdges: visibleExtrusionEdgeIndices(contour, vector),
                seamOffsets: seams
            })
        }
        return {
            face: preparedPunchFaceGeometry(model, punchProfile, flipX),
            contour: contour,
            runs: preparedRuns
        }
    }

    function drawPreparedPunchWalls(ctx, plan, run, sx, sy, punchTipR, sideColor, seamColor) {
        if (!plan || !run || run.visibleEdges.length === 0)
            return 0
        ctx.save()
        ctx.fillStyle = sideColor
        ctx.strokeStyle = "rgba(30,41,59,0.42)"
        ctx.lineWidth = 0.75
        // Painter order: walls farther along the extrusion direction first,
        // so nearer walls cover the edge lines of hidden ones.
        var depthX = run.farOffset.x - run.nearOffset.x
        var depthR = run.farOffset.r - run.nearOffset.r
        var ordered = run.visibleEdges.slice(0).sort(function(left, right) {
            function key(i) {
                var p = plan.contour[i], q = plan.contour[(i + 1) % plan.contour.length]
                return (p.x + q.x) * depthX + (p.r + q.r) * depthR
            }
            return key(right) - key(left)
        })
        for (var edgeIndex = 0; edgeIndex < ordered.length; edgeIndex++) {
            var index = ordered[edgeIndex]
            var nextIndex = (index + 1) % plan.contour.length
            var a = plan.contour[index]
            var b = plan.contour[nextIndex]
            ctx.beginPath()
            ctx.moveTo(sx(a.x + run.farOffset.x), sy(a.r + run.farOffset.r + punchTipR))
            ctx.lineTo(sx(b.x + run.farOffset.x), sy(b.r + run.farOffset.r + punchTipR))
            ctx.lineTo(sx(b.x + run.nearOffset.x), sy(b.r + run.nearOffset.r + punchTipR))
            ctx.lineTo(sx(a.x + run.nearOffset.x), sy(a.r + run.nearOffset.r + punchTipR))
            ctx.closePath(); ctx.fill()
            ctx.beginPath()
            ctx.moveTo(sx(a.x + run.farOffset.x), sy(a.r + run.farOffset.r + punchTipR))
            ctx.lineTo(sx(a.x + run.nearOffset.x), sy(a.r + run.nearOffset.r + punchTipR))
            ctx.moveTo(sx(b.x + run.farOffset.x), sy(b.r + run.farOffset.r + punchTipR))
            ctx.lineTo(sx(b.x + run.nearOffset.x), sy(b.r + run.nearOffset.r + punchTipR))
            ctx.stroke()
            // Seams drawn with their wall so nearer walls occlude them.
            if (seamColor && run.seamOffsets.length > 0) {
                ctx.save(); ctx.strokeStyle = seamColor; ctx.lineWidth = 0.9; ctx.beginPath()
                for (var s = 0; s < run.seamOffsets.length; s++) {
                    var o = run.seamOffsets[s]
                    ctx.moveTo(sx(a.x + o.x), sy(a.r + o.r + punchTipR))
                    ctx.lineTo(sx(b.x + o.x), sy(b.r + o.r + punchTipR))
                }
                ctx.stroke(); ctx.restore()
            }
        }
        ctx.restore()
        return run.visibleEdges.length
    }

    function drawPreparedPunchSeams(ctx, plan, run, sx, sy, punchTipR, strokeColor) {
        if (!plan || !run || run.seamOffsets.length === 0)
            return 0
        ctx.save(); ctx.strokeStyle = strokeColor; ctx.lineWidth = 0.9; ctx.beginPath()
        for (var seamIndex = 0; seamIndex < run.seamOffsets.length; seamIndex++) {
            var offset = run.seamOffsets[seamIndex]
            for (var edgeIndex = 0; edgeIndex < run.visibleEdges.length; edgeIndex++) {
                var index = run.visibleEdges[edgeIndex]
                var nextIndex = (index + 1) % plan.contour.length
                ctx.moveTo(sx(plan.contour[index].x + offset.x),
                           sy(plan.contour[index].r + offset.r + punchTipR))
                ctx.lineTo(sx(plan.contour[nextIndex].x + offset.x),
                           sy(plan.contour[nextIndex].r + offset.r + punchTipR))
            }
        }
        ctx.stroke(); ctx.restore()
        return run.seamOffsets.length
    }

    function drawPreparedPunchFace(ctx, face, sx, sy, offset, punchTipR,
                                   strokeColor, fillColor) {
        if (!face)
            return false
        ctx.save(); ctx.strokeStyle = strokeColor; ctx.fillStyle = fillColor; ctx.lineWidth = 1.15
        for (var p = 0; p < face.polylines.length; p++) {
            var poly = face.polylines[p]
            if (poly.points.length < 2)
                continue
            ctx.beginPath()
            ctx.moveTo(sx(poly.points[0].x + offset.x), sy(poly.points[0].r + offset.r + punchTipR))
            for (var i = 1; i < poly.points.length; i++)
                ctx.lineTo(sx(poly.points[i].x + offset.x), sy(poly.points[i].r + offset.r + punchTipR))
            if (poly.closed) ctx.closePath()
            if (fillColor && poly.closed) ctx.fill()
            ctx.stroke()
        }
        for (var l = 0; l < face.lines.length; l++) {
            ctx.beginPath()
            ctx.moveTo(sx(face.lines[l].a.x + offset.x), sy(face.lines[l].a.r + offset.r + punchTipR))
            ctx.lineTo(sx(face.lines[l].b.x + offset.x), sy(face.lines[l].b.r + offset.r + punchTipR))
            ctx.stroke()
        }
        for (var c = 0; c < face.circles.length; c++) {
            var circle = face.circles[c]
            var cx = circle.center.x + offset.x
            var cr = circle.center.r + offset.r + punchTipR
            ctx.beginPath()
            ctx.ellipse(sx(cx), sy(cr), Math.abs(sx(cx + circle.radius) - sx(cx)),
                        Math.abs(sy(cr + circle.radius) - sy(cr)), 0, 0, Math.PI * 2)
            ctx.stroke()
        }
        for (var a = 0; a < face.arcs.length; a++) {
            var arc = face.arcs[a]
            ctx.beginPath()
            for (var s = 0; s < arc.length; s++) {
                var x = sx(arc[s].x + offset.x)
                var r = sy(arc[s].r + offset.r + punchTipR)
                if (s === 0) ctx.moveTo(x, r); else ctx.lineTo(x, r)
            }
            ctx.stroke()
        }
        ctx.restore()
        return true
    }

    // Imported unfold plans: the planner's tool frame has +X toward the
    // backgauge and LIVE +X toward the operator, so a planner punch with
    // mirror=false is drawn X-reflected here (gooseneck relief on the side
    // the planner collision-checked). Legacy programs keep the raw DXF.
    // Orientation is a property of the mounted tool, not of one bend: a
    // physical punch never turns around between strokes of a program. It is
    // resolved from the whole program (planned bends win) so a transiently
    // empty selectedBend (program restart/loop, bend switch) or unplanned
    // rows in a mixed program can no longer flip the gooseneck mid-run.
    property var programBends: []
    property var livePunchFlipMemo: ({ key: "", value: false })
    function programPunchPlan(punchName) {
        var bends = programBends || []
        var planned = false
        var mirror = false
        for (var i = 0; i < bends.length; i++) {
            var b = bends[i]
            if (!b || b.unfoldPlanned !== true)
                continue
            if (punchName && b.punch && String(b.punch) !== punchName)
                continue
            planned = true
            mirror = b.unfoldPunchMirror === true
            break
        }
        return { planned: planned, mirror: mirror }
    }

    // Orientation comes only from the Fusion unfold plan (no hardcoded
    // default): the catalog maps DXF +X (left-view right) to the operator
    // front, so an unmirrored plan shows the DXF as drawn (flipX = mirror);
    // programs without a plan show the raw DXF.
    function livePunchFlipX(plannerMirror) {
        var bend = selectedBend
        var hasBend = bend && (bend.name !== undefined || bend.punch !== undefined)
        var plan = programPunchPlan(hasBend && bend.punch ? String(bend.punch) : "")
        var planned = plan.planned || (hasBend && bend.unfoldPlanned === true)
        if (!planned) {
            if (!hasBend && (programBends || []).length === 0)
                return livePunchFlipMemo.value
            return false
        }
        return plannerMirror === true
    }

    function activeLivePunchFlipX() {
        var bend = selectedBend
        var hasBend = bend && (bend.name !== undefined || bend.punch !== undefined)
        var plan = programPunchPlan(hasBend && bend.punch ? String(bend.punch) : "")
        var key = String(programName) + "|" + (hasBend ? String(bend.punch || "") : "")
        if (!hasBend && livePunchFlipMemo.key.indexOf(String(programName) + "|") === 0)
            return livePunchFlipMemo.value
        // The selected bend's own planner orientation wins: one punch can be
        // turned around for a single stroke (Clamp SM B6 mirrored, B1-B5 not).
        var mirror = (hasBend && bend.unfoldPlanned === true) ? bend.unfoldPunchMirror === true
            : plan.planned ? plan.mirror
            : (hasBend && bend.unfoldPunchMirror === true)
        var value = livePunchFlipX(mirror)
        if (livePunchFlipMemo.key !== key || livePunchFlipMemo.value !== value) {
            if (livePunchFlipMemo.value !== value)
                console.info("LIVE-PUNCH-ORIENTATION flipX=" + value + " key=" + key
                    + " bend=" + String(currentSelectedBendIndex() + 1))
            livePunchFlipMemo = { key: key, value: value }
        }
        return value
    }

    function currentLivePunchPaintPlan() {
        var staticScene = liveStaticSceneCache
        var punchModel = staticScene && staticScene.punchModel ? staticScene.punchModel : loadDxfModel(dxfAssetPath("punch", selectedToolToken("punch")))
        var punchProfile = staticScene && staticScene.punchProfile ? staticScene.punchProfile : resolvePunchProfile(punchModel)
        var plan = livePunchPaintPlanCache
        if (!plan || !staticScene || livePunchPaintPlanScene !== staticScene || plan._flipX !== activeLivePunchFlipX()) {
            var segments = toolingSegmentsForLive("punch")
            var cacheKey = punchPaintPlanKey(punchModel, punchProfile, segments)
            if (!plan || livePunchPaintPlanCacheKey !== cacheKey) {
                plan = buildLivePunchPaintPlan(punchModel, punchProfile, segments, activeLivePunchFlipX())
                if (plan) plan._flipX = activeLivePunchFlipX()
                livePunchPaintPlanCacheKey = cacheKey
                livePunchPaintPlanCache = plan
            }
            livePunchPaintPlanScene = staticScene
        }
        return plan
    }

    function drawLivePunchDxf(ctx, sx, sy, pose) {
        var prepareStarted = runCanvasTimingActive ? Date.now() : 0
        var palette = liveToolingAppearancePalette()
        var staticScene = liveStaticSceneCache
        var punchModel = staticScene && staticScene.punchModel ? staticScene.punchModel : loadDxfModel(dxfAssetPath("punch", selectedToolToken("punch")))
        var punchProfile = staticScene && staticScene.punchProfile ? staticScene.punchProfile : resolvePunchProfile(punchModel)
        var plan = livePunchPaintPlanCache
        if (!plan || !staticScene || livePunchPaintPlanScene !== staticScene || plan._flipX !== activeLivePunchFlipX()) {
            var segments = toolingSegmentsForLive("punch")
            var cacheKey = punchPaintPlanKey(punchModel, punchProfile, segments)
            if (!plan || livePunchPaintPlanCacheKey !== cacheKey) {
                plan = buildLivePunchPaintPlan(punchModel, punchProfile, segments, activeLivePunchFlipX())
                if (plan) plan._flipX = activeLivePunchFlipX()
                livePunchPaintPlanCacheKey = cacheKey
                livePunchPaintPlanCache = plan
            }
            livePunchPaintPlanScene = staticScene
        }
        if (runCanvasTimingActive)
            canvasTimingPunchPrepareMs += Date.now() - prepareStarted
        if (!plan)
            return false
        var wallsStarted = runCanvasTimingActive ? Date.now() : 0
        for (var wallIndex = 0; wallIndex < plan.runs.length; wallIndex++)
            drawPreparedPunchWalls(ctx, plan, plan.runs[wallIndex], sx, sy,
                                   pose.punchTipR, palette.sideFill, palette.punchStroke)
        if (runCanvasTimingActive)
            canvasTimingPunchWallsMs += Date.now() - wallsStarted
        var faceStarted = runCanvasTimingActive ? Date.now() : 0
        var punchDrawn = false
        for (var faceIndex = 0; faceIndex < plan.runs.length; faceIndex++)
            punchDrawn = drawPreparedPunchFace(
                ctx, plan.face, sx, sy, plan.runs[faceIndex].nearOffset,
                pose.punchTipR, palette.punchStroke, palette.punchFill) || punchDrawn
        if (runCanvasTimingActive)
            canvasTimingPunchFaceMs += Date.now() - faceStarted
        return punchDrawn
    }

    function retainedPunchPolygonArea(points) {
        var area = 0
        for (var index = 0; points && index < points.length; index++) {
            var next = points[(index + 1) % points.length]
            area += points[index].x * next.r - next.x * points[index].r
        }
        return area * 0.5
    }

    function retainedPunchPointInTriangle(point, a, b, c, orientation) {
        function cross(p0, p1, p2) {
            return (p1.x - p0.x) * (p2.r - p0.r)
                - (p1.r - p0.r) * (p2.x - p0.x)
        }
        var tolerance = 1.0e-9
        var ab = cross(a, b, point) * orientation
        var bc = cross(b, c, point) * orientation
        var ca = cross(c, a, point) * orientation
        return ab >= -tolerance && bc >= -tolerance && ca >= -tolerance
    }

    function retainedPunchPolygonIsSimple(points) {
        function orientation(a, b, c) {
            return (b.x - a.x) * (c.r - a.r)
                - (b.r - a.r) * (c.x - a.x)
        }
        function between(value, first, second) {
            return value >= Math.min(first, second) - 1.0e-9
                && value <= Math.max(first, second) + 1.0e-9
        }
        function onSegment(a, b, point) {
            return Math.abs(orientation(a, b, point)) <= 1.0e-9
                && between(point.x, a.x, b.x)
                && between(point.r, a.r, b.r)
        }
        function intersects(a, b, c, d) {
            var abC = orientation(a, b, c)
            var abD = orientation(a, b, d)
            var cdA = orientation(c, d, a)
            var cdB = orientation(c, d, b)
            if (((abC > 1.0e-9 && abD < -1.0e-9)
                    || (abC < -1.0e-9 && abD > 1.0e-9))
                    && ((cdA > 1.0e-9 && cdB < -1.0e-9)
                        || (cdA < -1.0e-9 && cdB > 1.0e-9)))
                return true
            return onSegment(a, b, c) || onSegment(a, b, d)
                || onSegment(c, d, a) || onSegment(c, d, b)
        }
        function adjacentRetraces(a, shared, b) {
            if (Math.abs(orientation(a, shared, b)) > 1.0e-9)
                return false
            var incomingX = a.x - shared.x
            var incomingR = a.r - shared.r
            var outgoingX = b.x - shared.x
            var outgoingR = b.r - shared.r
            return incomingX * outgoingX + incomingR * outgoingR > 1.0e-9
        }
        for (var vertex = 0; points && vertex < points.length; vertex++) {
            var previous = points[(vertex + points.length - 1) % points.length]
            var next = points[(vertex + 1) % points.length]
            if (adjacentRetraces(previous, points[vertex], next))
                return false
        }
        for (var first = 0; points && first < points.length; first++) {
            var firstNext = (first + 1) % points.length
            for (var second = first + 1; second < points.length; second++) {
                var secondNext = (second + 1) % points.length
                if (first === second || firstNext === second
                        || secondNext === first)
                    continue
                if (intersects(points[first], points[firstNext],
                               points[second], points[secondNext]))
                    return false
            }
        }
        return true
    }

    function triangulateRetainedPunchPolygon(sourcePoints) {
        var points = []
        for (var sourceIndex = 0; sourcePoints
                && sourceIndex < sourcePoints.length; sourceIndex++) {
            var sourcePoint = sourcePoints[sourceIndex]
            if (!sourcePoint || !isFinite(sourcePoint.x) || !isFinite(sourcePoint.r))
                return null
            var point = { x: Number(sourcePoint.x), r: Number(sourcePoint.r) }
            var previous = points.length > 0 ? points[points.length - 1] : null
            if (!previous || Math.hypot(point.x - previous.x,
                                        point.r - previous.r) > 1.0e-9)
                points.push(point)
        }
        if (points.length > 2 && Math.hypot(
                points[0].x - points[points.length - 1].x,
                points[0].r - points[points.length - 1].r) <= 1.0e-9)
            points.pop()
        if (points.length < 3)
            return null
        if (!retainedPunchPolygonIsSimple(points))
            return null
        var signedArea = retainedPunchPolygonArea(points)
        if (!isFinite(signedArea) || Math.abs(signedArea) <= 1.0e-9)
            return null
        var orientation = signedArea > 0 ? 1 : -1
        var remaining = []
        for (var pointIndex = 0; pointIndex < points.length; pointIndex++)
            remaining.push(pointIndex)
        var vertices = []
        var guard = points.length * points.length
        while (remaining.length > 3 && guard-- > 0) {
            var earFound = false
            for (var candidate = 0; candidate < remaining.length; candidate++) {
                var beforeIndex = remaining[(candidate + remaining.length - 1)
                    % remaining.length]
                var currentIndex = remaining[candidate]
                var afterIndex = remaining[(candidate + 1) % remaining.length]
                var before = points[beforeIndex]
                var current = points[currentIndex]
                var after = points[afterIndex]
                var convexity = ((current.x - before.x) * (after.r - before.r)
                    - (current.r - before.r) * (after.x - before.x)) * orientation
                if (convexity <= 1.0e-9)
                    continue
                var containsPoint = false
                for (var testIndex = 0; testIndex < remaining.length; testIndex++) {
                    var polygonIndex = remaining[testIndex]
                    if (polygonIndex === beforeIndex || polygonIndex === currentIndex
                            || polygonIndex === afterIndex)
                        continue
                    if (retainedPunchPointInTriangle(
                            points[polygonIndex], before, current, after,
                            orientation)) {
                        containsPoint = true
                        break
                    }
                }
                if (containsPoint)
                    continue
                vertices.push(before.x, before.r, current.x, current.r,
                              after.x, after.r)
                remaining.splice(candidate, 1)
                earFound = true
                break
            }
            if (!earFound)
                return null
        }
        if (remaining.length !== 3)
            return null
        var finalA = points[remaining[0]]
        var finalB = points[remaining[1]]
        var finalC = points[remaining[2]]
        if (Math.abs((finalB.x - finalA.x) * (finalC.r - finalA.r)
                - (finalB.r - finalA.r) * (finalC.x - finalA.x)) <= 1.0e-9)
            return null
        for (var finalIndex = 0; finalIndex < 3; finalIndex++) {
            var finalPoint = points[remaining[finalIndex]]
            vertices.push(finalPoint.x, finalPoint.r)
        }
        return vertices
    }

    function buildRetainedOpaquePunchBatches(plan, palette) {
        if (!plan || !palette)
            return null
        var batches = []
        for (var runIndex = 0; runIndex < plan.runs.length; runIndex++) {
            var run = plan.runs[runIndex]
            var wallVertices = []
            for (var edgeIndex = 0; edgeIndex < run.visibleEdges.length; edgeIndex++) {
                var contourIndex = run.visibleEdges[edgeIndex]
                var nextIndex = (contourIndex + 1) % plan.contour.length
                var a = plan.contour[contourIndex]
                var b = plan.contour[nextIndex]
                wallVertices.push(
                    a.x + run.farOffset.x, a.r + run.farOffset.r,
                    b.x + run.farOffset.x, b.r + run.farOffset.r,
                    b.x + run.nearOffset.x, b.r + run.nearOffset.r,
                    a.x + run.farOffset.x, a.r + run.farOffset.r,
                    b.x + run.nearOffset.x, b.r + run.nearOffset.r,
                    a.x + run.nearOffset.x, a.r + run.nearOffset.r)
            }
            if (wallVertices.length > 0)
                batches.push({ xyVertices: wallVertices, color: palette.sideFill })
            var faceVertices = []
            for (var polylineIndex = 0;
                    polylineIndex < plan.face.polylines.length; polylineIndex++) {
                var polyline = plan.face.polylines[polylineIndex]
                if (!polyline.closed)
                    continue
                var translated = []
                for (var pointIndex = 0; pointIndex < polyline.points.length;
                        pointIndex++) {
                    translated.push({
                        x: polyline.points[pointIndex].x + run.nearOffset.x,
                        r: polyline.points[pointIndex].r + run.nearOffset.r
                    })
                }
                var triangles = triangulateRetainedPunchPolygon(translated)
                if (!triangles)
                    return null
                for (var triangleIndex = 0; triangleIndex < triangles.length;
                        triangleIndex++)
                    faceVertices.push(triangles[triangleIndex])
            }
            if (faceVertices.length > 0)
                batches.push({ xyVertices: faceVertices, color: palette.punchFill })
        }
        return batches.length > 0 ? batches : null
    }

    function retainedPunchViewportTransform(liveFrame) {
        if (!liveFrame || !liveFrame.bounds || !liveFrame.pose)
            return null
        var bounds = liveFrame.bounds
        var marginX = 8
        var marginY = 6
        var scale = Math.min(
            (previewCanvas.width - marginX * 2)
                / Math.max(1.0e-6, bounds.maxX - bounds.minX),
            (previewCanvas.height - marginY * 2)
                / Math.max(1.0e-6, bounds.maxR - bounds.minR))
        if (!isFinite(scale) || scale <= 0)
            return null
        var sceneWidthPx = (bounds.maxX - bounds.minX) * scale
        var sceneHeightPx = (bounds.maxR - bounds.minR) * scale
        var left = (previewCanvas.width - sceneWidthPx) * 0.5
        var top = Math.max(marginY,
                           previewCanvas.height - marginY - sceneHeightPx)
        var cameraBasis = isometricCameraBasis()
        var m11 = cameraBasis.screenXSign < 0 ? -scale : scale
        return {
            m11: m11, m12: 0, m21: 0, m22: -scale,
            dx: cameraBasis.screenXSign < 0
                ? left + bounds.maxX * scale
                : left - bounds.minX * scale,
            dy: top + bounds.maxR * scale
                - finite(liveFrame.pose.punchTipR, 0) * scale
        }
    }

    function rebuildRetainedPunchShadow() {
        if (!retainedPunchShadowRequested || sceneMode !== "LIVE"
                || !sceneData || !sceneData.ready
                || retainedPunchShadowLoader.status !== Loader.Ready
                || !retainedPunchShadowLoader.item)
            return false
        var liveFrame = runRenderFrame && runRenderFrame.live
            ? runRenderFrame.live : null
        if (!liveFrame || !liveFrame.ready)
            return false
        try {
            var staticScene = liveFrame.staticScene || liveStaticSceneCache
            var punchModel = staticScene && staticScene.punchModel
                ? staticScene.punchModel
                : loadDxfModel(dxfAssetPath("punch", selectedToolToken("punch")))
            var punchProfile = staticScene && staticScene.punchProfile
                ? staticScene.punchProfile : resolvePunchProfile(punchModel)
            var segments = toolingSegmentsForLive("punch")
            var planKey = punchPaintPlanKey(punchModel, punchProfile, segments)
            var installKey = planKey
                + "|palette=" + JSON.stringify(liveToolingAppearancePalette())
            var plan = livePunchPaintPlanCache
            if (!plan || livePunchPaintPlanCacheKey !== planKey) {
                plan = buildLivePunchPaintPlan(punchModel, punchProfile, segments)
                livePunchPaintPlanCacheKey = planKey
                livePunchPaintPlanCache = plan
                livePunchPaintPlanScene = staticScene
            }
            if (installKey !== retainedPunchInstallKey) {
                var batches = buildRetainedOpaquePunchBatches(
                    plan, liveToolingAppearancePalette())
                if (!batches || !retainedPunchShadowLoader.item
                        .installOpaqueBatches(batches))
                    throw new Error(retainedPunchShadowLoader.item.packetError
                        || "opaque punch compilation failed")
                retainedPunchInstallKey = installKey
                retainedPunchBatchCount = batches.length
            }
            var transform = retainedPunchViewportTransform(liveFrame)
            if (!transform)
                throw new Error("opaque punch viewport transform is invalid")
            var revision = retainedPunchRevision + 1
            if (!retainedPunchShadowLoader.item.submitOpaqueTransform(
                    retainedPunchBatchCount,
                    transform.m11, transform.m12, transform.m21, transform.m22,
                    transform.dx, transform.dy, revision))
                throw new Error(retainedPunchShadowLoader.item.packetError
                    || "opaque punch transform submission failed")
            retainedPunchRevision = revision
            retainedPunchUsable = true
            retainedPunchError = ""
            return true
        } catch (error) {
            retainedPunchUsable = false
            retainedPunchError = String(error)
            retainedPunchInstallKey = ""
            retainedPunchBatchCount = 0
            if (retainedPunchShadowLoader.item)
                retainedPunchShadowLoader.item.cancelOpaqueInstall()
