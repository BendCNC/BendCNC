    }

    function collectDxfModelPoints(model) {
        var points = []
        if (!model)
            return points
        for (var p = 0; p < model.polylines.length; p++) {
            var polyPoints = model.polylines[p].points || model.polylines[p]
            for (var i = 0; i < polyPoints.length; i++)
                points.push(polyPoints[i])
