        ctx.fill()
        ctx.globalCompositeOperation = "source-over"
        ctx.strokeStyle = "rgba(45,131,178,0.68)"
        ctx.stroke()
        ctx.stroke()
        ctx.restore()
        if (runCanvasTimingActive) {
            var fallbackAt = Date.now()
            canvasTimingGaugeGeometryMs += geometryAt - gaugeStartedAt
            canvasTimingGaugeSolidMs += fallbackAt - geometryAt
        }
    }

    function drawBackgaugeFingerReadout(
            ctx, sx, sy, faceX, contactR, workX,
            resolvedFingerGeometry) {
        var readoutStartedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        var fingerGeometry = resolvedFingerGeometry !== undefined
            ? resolvedFingerGeometry : liveBackgaugeFingerGeometry()
        var profile = fingerGeometry && fingerGeometry.profile
            ? fingerGeometry.profile : ({})
        var anchorLocalX = finite(profile.anchorLocalX, 4.0)
        var anchorLocalY = finite(profile.anchorLocalY, 0.375)
        var bodyMinWorldX = faceX + 0.48 - anchorLocalX
        var bodyMaxWorldX = faceX + 3.08 - anchorLocalX
        var bodyMinWorldR = contactR + 0.05 - anchorLocalY
        var bodyMaxWorldR = contactR + 0.70 - anchorLocalY
