    // 3D: the stack menu lists pieces left->right as the operator sees them;
    // the 3D depth axis runs the other way, so mirror about the stack centre.
    function mirroredToolingSegments(source) {
        if (!source || source.length < 2)
            return source || []
        var lo = Infinity, hi = -Infinity, i
        for (i = 0; i < source.length; i++) {
            lo = Math.min(lo, finite(source[i].startXIn, 0))
            hi = Math.max(hi, finite(source[i].endXIn, 0))
        }
        var mirrored = []
        for (i = source.length - 1; i >= 0; i--) {
            var copy = Object.assign({}, source[i])
            copy.startXIn = lo + hi - finite(source[i].endXIn, 0)
            copy.endXIn = lo + hi - finite(source[i].startXIn, 0)
            mirrored.push(copy)
        }
        return mirrored
    }

    function activeToolingSegmentsForLive(kind, phase) {
        // Planner intervals already describe the physical setup order.
        // toolingStationCoordinate() is the single planner-to-live transform;
        // reflecting intervals here as well reverses unequal inventories such
        // as Battery Plate N1's 8/1 arrangement only in ISOMETRIC.
        var source = kind === "die" ? (phase.installedDieSegments || [])
                                     : (phase.installedSegments || [])
        if (source.length < 2 || String(liveProjectionMode).toUpperCase() !== "ISOMETRIC")
            return source
        // The station->depth transform flips per bend edge, so decide from
        // the projected depth: the first stack piece must be the near one.
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        var first = source[0], last = source[source.length - 1]
        var firstDepth = toolingStationCoordinate(
            (finite(first.startXIn, 0) + finite(first.endXIn, 0)) / 2) * cameraSign
        var lastDepth = toolingStationCoordinate(
            (finite(last.startXIn, 0) + finite(last.endXIn, 0)) / 2) * cameraSign
        if (firstDepth >= lastDepth)
            return source
        // ISOMETRIC is a left view: the operator-left piece of the stack
        // (first in the CAD/toolbar order) must be the near one. Mirror the
        // piece order about the stack centre while keeping its span.
        var lo = Infinity, hi = -Infinity, i
        for (i = 0; i < source.length; i++) {
            lo = Math.min(lo, finite(source[i].startXIn, 0))
            hi = Math.max(hi, finite(source[i].endXIn, 0))
        }
        var mirrored = []
        for (i = source.length - 1; i >= 0; i--) {
            var copy = Object.assign({}, source[i])
            copy.startXIn = lo + hi - finite(source[i].endXIn, 0)
            copy.endXIn = lo + hi - finite(source[i].startXIn, 0)
            mirrored.push(copy)
        }
        return mirrored
    }

    // ---- LIVE 3D feed (consumed by LiveScene3D.qml) ----------------------
    // Static part topology: flat-pattern panels (render-simplified loops) and
    // graph edges with finite-radius parameters. Cached by revision.
    property var live3DTopologyCache: null
