    function drawLivePanelPunchFrontEntries(ctx, entries, sx, sy,
                                            facePresentation, punchDepth, pose) {
        for (var entryIndex = 0; entries && entryIndex < entries.length; entryIndex++) {
            var entry = entries[entryIndex]
            if (entry.punchFootprint) {
