        // spans of the same CAD bend are completed/future per the plan.
        var preview = parsePreview()
        var stagePlan = preview && Array.isArray(preview.stagePlan) ? preview.stagePlan : []
        var stageIndex = currentSelectedBendIndex()
        var stage = stagePlan[stageIndex] || null
        if (stage && stage.spanFrom && stage.relationId) {
            states = Object.assign({}, states)
            for (var rel in stage.spanFrom) {
                var child = rel.substring(rel.indexOf(":") + 1)
                if (states[child] !== "current" || rel === String(stage.relationId))
                    continue
                states[child] = Number(stage.spanFrom[rel]) >= 0.999 ? "completed" : "future"
            }
        }
        var nextStage = stagePlan[stageIndex + 1] || null
        var nextRel = nextStage && nextStage.spanFrom && nextStage.relationId
            ? String(nextStage.relationId) : ""
        return {
            nextChildId: nextRel ? nextRel.substring(nextRel.indexOf(":") + 1) : "",
            transforms: compiled.transforms,
            angles: compiled.anglesByChildId,
            frame: artifacts.v5SectionFrame,
            centerX: finite(pose.centerX, 0),
            centerR: finite(pose.centerR, 0),
            panelStates: states,
            punchTipR: finite(pose.punchTipR, 0),
            gaugeFaceX: finite(pose.gaugeFaceX, 0),
            fingerContactR: finite(backgaugeFingerContactR(pose), 0),
            phase: String(pose.phase || ""),
            collision: !!(artifacts.collisions && artifacts.collisions.any),
            status: live.status || null,
            tonnageText: String(live.tonnageText || ""),
            bendLabel: String(currentSelectedBendIndex() + 1),
            renderedBend: renderedPreviewBendIndex
        }
    }

