    // Phase 3.3b: collision summary label — 1:1 with Java CollisionKind.label().
    function collisionSummaryLabel(collisions) {
        if (!collisions || !collisions.any)
            return "COLLISION"
        var kind = collisions.detail ? collisions.detail.kind : "NONE"
        switch (kind) {
            case "SHEET_BACKGAUGE": return "COLLISION / SHEET-BG"
            case "FLANGE_BACKGAUGE": return "COLLISION / FLANGE-BG"
            case "BACKGAUGE_PUNCH": return "COLLISION / BG-PUNCH"
            case "BACKGAUGE_DIE": return "COLLISION / BG-DIE"
            case "SHEET_PUNCH": return "COLLISION / SHEET-PUNCH"
            case "SHEET_DIE": return "COLLISION / SHEET-DIE"
            default: return "COLLISION"
        }
    }

    // Phase 3.3b: collision crosshair marker — 1:1 with Java drawCollisionMarker.
    // point is {x, r} in live world coords (R vertical).
    function drawCollisionMarker(ctx, sx, sy, point) {
        if (!point)
            return
        var x = sx(point.x)
        var y = sy(point.r)
        ctx.save()
        ctx.fillStyle = "rgba(254,226,226,0.65)"
        ctx.beginPath()
        ctx.arc(x, y, 8, 0, Math.PI * 2)
        ctx.fill()
        ctx.strokeStyle = "#dc2626"
        ctx.lineWidth = 1.8
        ctx.beginPath()
        ctx.arc(x, y, 6, 0, Math.PI * 2)
        ctx.stroke()
        ctx.beginPath()
        ctx.moveTo(x - 5, y); ctx.lineTo(x + 5, y)
        ctx.moveTo(x, y - 5); ctx.lineTo(x, y + 5)
        ctx.stroke()
        ctx.restore()
    }

    function liveCurrentAxisCoord(bend, rawX, rawY) {
        return String(bend ? bend.axis : "X").toUpperCase() === "X" ? finite(rawX, 0) : finite(rawY, 0)
    }

    function liveCompletedAnchorPoint(data, liveGeometry, completed, currentBend) {
        if (!liveGeometry || !liveGeometry.centerline || liveGeometry.centerline.length < 5) {
            return {
                point: { x: 0, r: 0 },
                armDirX: 1,
                armDirR: 0,
                gaugeSide: false,
                clampedToSection: false
            }
        }
        var currentCoord = liveSectionCoord(currentBend)
        var completedCoord = liveSectionCoord(completed)
        var gaugeSide = gaugeSideNegative(currentBend) ? completedCoord < currentCoord : completedCoord > currentCoord
        var halfOpen = finite(liveGeometry.dieHalfWidth, 0)
        var shortArm = finite(liveGeometry.shortArm, halfOpen)
        var visibleLongArm = finite(liveGeometry.visibleLongArm, halfOpen)
        var riseEndGauge = liveGeometry.centerline[0]
        var shoulderGauge = liveGeometry.centerline[1]
        var shoulderFront = liveGeometry.centerline[3]
        var riseEndFront = liveGeometry.centerline[4]

        var gaugeShoulderCoord = gaugeSideNegative(currentBend) ? currentCoord - halfOpen : currentCoord + halfOpen
        var gaugeEndCoord = gaugeSideNegative(currentBend) ? currentCoord - shortArm : currentCoord + shortArm
        var frontShoulderCoord = gaugeSideNegative(currentBend) ? currentCoord + halfOpen : currentCoord - halfOpen
        var frontEndCoord = gaugeSideNegative(currentBend) ? currentCoord + visibleLongArm : currentCoord - visibleLongArm

        var rawStart = gaugeSide ? gaugeShoulderCoord : frontShoulderCoord
        var rawEnd = gaugeSide ? gaugeEndCoord : frontEndCoord
        var startPoint = gaugeSide ? shoulderGauge : shoulderFront
        var endPoint = gaugeSide ? riseEndGauge : riseEndFront
        var clampedCoord = clampValue(completedCoord, Math.min(rawStart, rawEnd), Math.max(rawStart, rawEnd))
        var point = interpolateLivePoint(startPoint, endPoint, rawStart, rawEnd, clampedCoord)
        var armDx = endPoint.x - startPoint.x
        var armDr = endPoint.r - startPoint.r
        var armLen = Math.hypot(armDx, armDr)
        var armDirX = armLen > 1e-6 ? armDx / armLen : (gaugeSide ? -1 : 1)
        var armDirR = armLen > 1e-6 ? armDr / armLen : 0
        return {
            point: point,
            armDirX: armDirX,
            armDirR: armDirR,
            gaugeSide: gaugeSide,
            clampedToSection: Math.abs(clampedCoord - completedCoord) > 1e-5
        }
    }

    // Java parity: resolveOutboardLegIn (RunExecutionPreviewRenderer). The outboard leg
    // is the one AWAY from the closest (gauge) edge.
    function liveOutboardLegIn(bend) {
        if (!bend)
            return 0.0
        var negGauge = gaugeSideNegative(bend)
        var left = finite(firstDefined(bend, ["contourLeftLegFlat_in", "contourLeftLegFlatIn"], NaN), NaN)
        var right = finite(firstDefined(bend, ["contourRightLegFlat_in", "contourRightLegFlatIn"], NaN), NaN)
        // NEG gauge -> outboard = right leg; POS gauge -> outboard = left leg
        if (!negGauge && isFinite(left))
            return left
        if (negGauge && isFinite(right))
            return right
        return finite(firstDefined(bend, ["distanceFromEdge_in", "distanceFromEdgeIn"], 0), 0)
    }

    // Java parity: resolveCompletedFlangeHeightIn. Returns the formed-flange FOLD HEIGHT
    // (a few inches), NOT the inter-bend span. Using the span made completed flanges draw
    // as full-length (~29") diagonal arms that filled the side view like a top-view fan.
    function completedFlangeFoldHeight(completed, currentBend, visibleLongArm) {
        if (!completed)
            return 0.5
        var foldLen
        if (bendReferenceType(completed).toUpperCase() === "PREVIOUS_BEND" && bendReferenceDistance(completed, 0) > 0.05) {
            foldLen = bendReferenceDistance(completed, 0)
        } else {
            var edge = finite(firstDefined(completed, ["distanceFromEdge_in", "distanceFromEdgeIn"], NaN), NaN)
            if (isFinite(edge) && edge > 0.05)
                foldLen = edge
            else {
                var ref = bendReferenceDistance(completed, NaN)
                foldLen = (isFinite(ref) && ref > 0.05) ? ref : liveOutboardLegIn(completed)
            }
        }
        // buildCompletedFlangeSegments cap: proportional, allows tall folds on large parts
        // but prevents a runaway full-leg projection.
        var maxFoldLen = Math.max(3.5, Math.abs(finite(visibleLongArm, 0)) * 0.85)
        return Math.min(Math.max(finite(foldLen, 0.05), 0.05), maxFoldLen)
    }

    function completedFlangeDirection(anchorProjection, completed, currentBend) {
        var gaugeSide = anchorProjection ? anchorProjection.gaugeSide === true : false
        var armDirX = anchorProjection ? finite(anchorProjection.armDirX, 1) : 1
        var armDirR = anchorProjection ? finite(anchorProjection.armDirR, 0) : 0
        var foldAngleDeg = clampValue(bendAngleDeg(completed, selectedBend.angle || 90), 0, 179)
        var riseRad = foldAngleDeg * Math.PI / 180
        var perpX = -armDirR
        var perpR = armDirX
        var bendDown = bendDirection(completed) === "DOWN"
        var sign = gaugeSide ? (bendDown ? 1.0 : -1.0) : (bendDown ? -1.0 : 1.0)
        var foldDirX = armDirX * Math.cos(riseRad) + sign * perpX * Math.sin(riseRad)
        var foldDirR = armDirR * Math.cos(riseRad) + sign * perpR * Math.sin(riseRad)
        var length = Math.hypot(foldDirX, foldDirR)
        if (length < 1e-6)
            return { x: armDirX, r: armDirR }
        return { x: foldDirX / length, r: foldDirR / length }
    }

    function drawLiveStatusCard(ctx, status) {
        if (!liveStatusCardVisible)
            return
        var safeTitle = sanitizeGuideText(status && status.title ? status.title : "OPERATION STATUS")
        var safePhase = sanitizeGuideText(status && status.phaseLine ? status.phaseLine : "")
        var safeDirection = sanitizeGuideText(status && status.directionLine ? status.directionLine : "")
        ctx.save()
        ctx.fillStyle = "rgba(244,246,248,0.94)"
        ctx.strokeStyle = "rgba(203,213,225,0.95)"
        ctx.lineWidth = 1.0
        var cardX = 12
        var cardY = 12
        drawRoundRect(ctx, cardX, cardY, 214, 66, 12, true, true)
        ctx.fillStyle = "#1f2937"
        ctx.font = "800 11px sans-serif"
        ctx.fillText(safeTitle, cardX + 12, cardY + 15)
        ctx.font = "600 11px sans-serif"
        ctx.fillText(safePhase, cardX + 12, cardY + 36)
        ctx.fillText(safeDirection, cardX + 12, cardY + 54)
        ctx.restore()
    }

    function transformDxfPoint(localX, localY, originWorldX, originWorldY, anchorLocalX, anchorLocalY, flipX, flipY, rotationCwDeg, scaleFactor) {
        var dx = (flipX ? -(localX - anchorLocalX) : (localX - anchorLocalX)) * scaleFactor
        var dy = (flipY ? -(localY - anchorLocalY) : (localY - anchorLocalY)) * scaleFactor
        var radians = finite(rotationCwDeg, 0) * Math.PI / 180
        return {
            x: originWorldX + dx * Math.cos(radians) - dy * Math.sin(radians),
            r: originWorldY + dx * Math.sin(radians) + dy * Math.cos(radians)
        }
    }

    function drawDxfModel(ctx, model, sx, sy, anchorLocalX, anchorLocalY, worldX, worldR, scaleFactor, strokeColor, fillColor, flipX, flipY, rotationCwDeg) {
        if (!model)
            return false
        ctx.save()
        ctx.strokeStyle = strokeColor
        ctx.fillStyle = fillColor
        ctx.lineWidth = 1.15
        function tp(x, y) { return transformDxfPoint(x, y, worldX, worldR, anchorLocalX, anchorLocalY, !!flipX, !!flipY, finite(rotationCwDeg, 0), finite(scaleFactor, 1)) }
        for (var p = 0; p < model.polylines.length; p++) {
            var poly = model.polylines[p]
            var points = poly.points || poly
            if (points.length < 2)
                continue
            ctx.beginPath()
            var first = tp(points[0].x, points[0].y)
            ctx.moveTo(sx(first.x), sy(first.r))
            for (var i = 1; i < points.length; i++) {
                var next = tp(points[i].x, points[i].y)
                ctx.lineTo(sx(next.x), sy(next.r))
            }
            var closed = poly.closed || (points.length > 2 && Math.abs(points[0].x - points[points.length - 1].x) < 0.001 && Math.abs(points[0].y - points[points.length - 1].y) < 0.001)
            if (closed)
                ctx.closePath()
            if (fillColor && closed)
                ctx.fill()
            ctx.stroke()
        }
        for (var l = 0; l < model.lines.length; l++) {
            var a = tp(model.lines[l].x1, model.lines[l].y1)
            var b = tp(model.lines[l].x2, model.lines[l].y2)
            ctx.beginPath()
            ctx.moveTo(sx(a.x), sy(a.r))
            ctx.lineTo(sx(b.x), sy(b.r))
            ctx.stroke()
        }
        for (var c = 0; model.circles && c < model.circles.length; c++) {
            var center = tp(model.circles[c].cx, model.circles[c].cy)
            var r = model.circles[c].radius * finite(scaleFactor, 1)
            var px = sx(center.x)
            var py = sy(center.r)
            var rx = Math.abs(sx(center.x + r) - sx(center.x))
            var ry = Math.abs(sy(center.r + r) - sy(center.r))
            ctx.beginPath()
            ctx.ellipse(px, py, rx, ry, 0, 0, Math.PI * 2)
            ctx.stroke()
        }
        for (var ar = 0; model.arcs && ar < model.arcs.length; ar++) {
            var arc = model.arcs[ar]
            var samples = Math.max(8, Math.ceil(Math.abs(arc.endDeg - arc.startDeg) / 8))
            var start = arc.startDeg
            var extent = arc.endDeg - arc.startDeg
            if (extent < 0)
                extent += 360
            ctx.beginPath()
            for (var s = 0; s <= samples; s++) {
                var deg = start + extent * s / samples
                var rad = deg * Math.PI / 180
                var point = tp(arc.cx + Math.cos(rad) * arc.radius, arc.cy + Math.sin(rad) * arc.radius)
                if (s === 0)
                    ctx.moveTo(sx(point.x), sy(point.r))
                else
                    ctx.lineTo(sx(point.x), sy(point.r))
            }
            ctx.stroke()
        }
        ctx.restore()
        return true
    }

    function normalizedLiveCameraOrientation(value) {
        var normalized = String(value || liveCameraOrientation || "").toUpperCase()
        var allowed = [
            "ISO_TOP_LEFT", "ISO_TOP_RIGHT", "ISO_BOTTOM_LEFT", "ISO_BOTTOM_RIGHT",
            "ISO_TOP", "ISO_BOTTOM", "ISO_LEFT", "ISO_RIGHT", "ISO_FRONT", "ISO_BACK"
        ]
        return allowed.indexOf(normalized) >= 0 ? normalized : "ISO_TOP_LEFT"
    }

    function isometricCameraBasis(orientation) {
        var normalized = normalizedLiveCameraOrientation(orientation)
        var depthX = isometricDepthXPerIn
        var depthR = isometricDepthRPerIn
        var viewAxisSign = 1
        var screenXSign = 1
        switch (normalized) {
        case "ISO_TOP_RIGHT":
            depthX = -isometricDepthXPerIn
            break
        case "ISO_BOTTOM_LEFT":
            depthR = -isometricDepthRPerIn
            break
        case "ISO_BOTTOM_RIGHT":
            depthX = -isometricDepthXPerIn
            depthR = -isometricDepthRPerIn
            break
        case "ISO_TOP":
            depthX = 0
            break
        case "ISO_BOTTOM":
            depthX = 0
            depthR = -isometricDepthRPerIn
            break
        case "ISO_LEFT":
            depthR = 0
            break
        case "ISO_RIGHT":
            depthX = -isometricDepthXPerIn
            depthR = 0
            break
        case "ISO_FRONT":
            depthX = 0
            depthR = 0
            break
        case "ISO_BACK":
            depthX = 0
            depthR = 0
            viewAxisSign = -1
            screenXSign = -1
            break
        }
        return {
            orientation: normalized,
            depthXPerIn: depthX,
            depthRPerIn: depthR,
            viewAxisSign: viewAxisSign,
            screenXSign: screenXSign,
            toolingDepthXPerIn: depthX,
            toolingDepthRPerIn: depthR,
            label: normalized.substring(4).replace(/_/g, " ")
        }
    }

    function isometricDisplayDepthVector(depthIn, mode, orientation) {
        if (String(mode || liveProjectionMode).toUpperCase() !== "ISOMETRIC")
            return { x: 0, r: 0 }
        var depth = Math.max(0, finite(depthIn, 0))
        var basis = isometricCameraBasis(orientation)
        return {
            x: basis.depthXPerIn * depth,
            r: basis.depthRPerIn * depth
        }
    }

    function isometricToolingExtrusionVector(mode, direction, depthIn, orientation) {
        var depth = depthIn === undefined ? toolingVisualDepthIn : depthIn
        var vector = isometricDisplayDepthVector(depth, mode, orientation)
        // Installed tooling and material share one physical longitudinal axis.
        // Extrude toward the positive station direction by default so the
        // punch/die body occupies the same projected span as the workpiece,
        // rather than extending from the contact plane in the opposite direction.
        var sign = finite(direction, 1) < 0 ? -1 : 1
        return { x: vector.x * sign, r: vector.r * sign }
    }

    function normalizedToolingAppearance(value) {
        return String(value || toolingAppearance).toUpperCase() === "TRANSLUCENT"
            ? "TRANSLUCENT" : "SOLID"
    }

    function toolingAppearancePalette(value) {
        var solid = normalizedToolingAppearance(value) === "SOLID"
        return {
            solid: solid,
            rearStroke: solid ? "#334155" : "rgba(51,65,85,0.58)",
            rearFill: solid ? "#475569" : "rgba(71,85,105,0.13)",
            sideFill: solid ? "#64748b" : "rgba(100,116,139,0.22)",
            tableStroke: solid ? "#374151" : "rgba(55,65,81,0.86)",
            tableFill: solid ? "#4b5563" : "rgba(75,85,99,0.20)",
            holderStroke: solid ? "#374151" : "rgba(55,65,81,0.88)",
            holderFill: solid ? "#4b5563" : "rgba(75,85,99,0.20)",
            dieStroke: solid ? "#111827" : "rgba(17,24,39,0.92)",
            dieFill: solid ? "#1f2937" : "rgba(31,41,55,0.22)",
            punchStroke: solid ? "#111827" : "rgba(17,24,39,0.94)",
            punchFill: solid ? "#64748b" : "rgba(100,116,139,0.20)"
        }
    }

    function liveToolingAppearancePalette() {
        // LIVE represents installed steel tooling. It must remain opaque so
        // station depth and material occlusion are communicated by geometry
        // and draw order rather than by hidden profiles showing through it.
        var palette = toolingAppearancePalette("SOLID")
        // Uniform light outlines: the near face must not stand out with a
        // darker contour than the seams of the other segments.
        palette.punchStroke = palette.rearStroke
        palette.dieStroke = palette.rearStroke
        return palette
    }

    function backgaugeFingerAppearancePalette(value) {
        var solid = normalizedToolingAppearance(value) === "SOLID"
        return {
            solid: solid,
            frontStroke: solid ? "#164e63" : "rgba(22,78,99,0.82)",
            frontFill: solid ? "#5aa6c9" : "rgba(45,131,178,0.24)",
            rearStroke: solid ? "#164e63" : "rgba(22,78,99,0.58)",
            rearFill: solid ? "#357b9d" : "rgba(45,131,178,0.13)",
            outerSideFill: solid ? "#438eaf" : "rgba(45,131,178,0.22)",
            holeSideFill: solid ? "#285f7a" : "rgba(30,86,112,0.26)"
        }
    }

    function fingerSideSolidProfile(model) {
        if (!model || !model.bounds)
            return null
        // The finger side DXF is intentionally LINE + ARC + CIRCLE rather than a
        // closed polyline. Reconstruct the canonical silhouette of the original
        // STEP finger (docs/backgauge-finger-original.md): step face at 3.028 in
        // with a 0.05 in chamfer, tongue tip at 4.0 in; the DXF primitives are
        // overlaid later as the exact edge-detail authority.
        var outer = backgaugeFingerOriginal ? [
            { x: 0.375, y: 0.75 }, { x: 2.978, y: 0.75 },
            { x: 3.028, y: 0.75 }, { x: 3.028, y: 0.375 },
            { x: 4.00, y: 0.375 },
            { x: 4.00, y: 0.00 },
            { x: 0.375, y: 0.00 }
        ] : [
            // FLAT finger (assets/Finger Side.dxf): step face at 3.00 in.
            { x: 0.375, y: 0.75 }, { x: 2.95, y: 0.75 },
            { x: 3.00, y: 0.75 }, { x: 3.00, y: 0.375 },
            { x: 3.95, y: 0.375 }, { x: 4.00, y: 0.375 },
            { x: 4.00, y: 0.00 }, { x: 3.95, y: 0.00 },
            { x: 0.375, y: 0.00 }
        ]
        for (var arcStep = 0; arcStep <= 20; arcStep++) {
            var arcAngle = (270 - 180 * arcStep / 20) * Math.PI / 180
            outer.push({
                x: 0.375 + Math.cos(arcAngle) * 0.375,
                y: 0.375 + Math.sin(arcAngle) * 0.375
            })
        }
        var hole = []
        for (var holeStep = 0; holeStep < 28; holeStep++) {
            var holeAngle = Math.PI * 2 * holeStep / 28
            hole.push({
                x: 0.375 + Math.cos(holeAngle) * 0.15625,
                y: 0.375 + Math.sin(holeAngle) * 0.15625
            })
        }
        var result = {
            outerLoop: outer,
            holeLoops: [hole],
            anchorLocalX: model.bounds.maxX,
            anchorLocalY: resolveSupportSurfaceY(model, false, 0.20)
        }
        return result
    }

    function fingerSolidDepthIn() {
        var topModel = loadDxfModel(dxfAssetPath("fingerTop", ""))
        if (!topModel || !topModel.bounds)
            return toolingVisualDepthIn
        return Math.max(0.1, Math.abs(
            finite(topModel.bounds.maxY, 0) - finite(topModel.bounds.minY, 0)))
    }

    function backgaugeFingerExtrusionVector(mode, orientation) {
        return isometricToolingExtrusionVector(
            mode, 1, fingerSolidDepthIn(), orientation)
    }

    function backgaugeFingerVisibleFaceOffset(mode, orientation) {
        var vector = backgaugeFingerExtrusionVector(mode, orientation)
        return Math.hypot(vector.x, vector.r) > 1.0e-6
            ? vector : { x: 0, r: 0 }
    }

    function drawDisplayProfilePath(ctx, points, sx, sy, anchorLocalX,
                                    anchorLocalY, worldX, worldR, offset) {
        if (!points || points.length < 3)
            return false
        var first = transformDxfPoint(
            points[0].x, points[0].y, worldX, worldR,
            anchorLocalX, anchorLocalY, false, false, 0, 1)
        ctx.beginPath()
        ctx.moveTo(sx(first.x + finite(offset ? offset.x : 0, 0)),
                   sy(first.r + finite(offset ? offset.r : 0, 0)))
        for (var pointIndex = 1; pointIndex < points.length; pointIndex++) {
            var point = transformDxfPoint(
                points[pointIndex].x, points[pointIndex].y, worldX, worldR,
                anchorLocalX, anchorLocalY, false, false, 0, 1)
            ctx.lineTo(sx(point.x + finite(offset ? offset.x : 0, 0)),
                       sy(point.r + finite(offset ? offset.r : 0, 0)))
        }
        ctx.closePath()
        return true
    }

    function drawDisplayProfileFace(ctx, profile, sx, sy, worldX, worldR,
                                    offset, fillColor, strokeColor) {
        if (!profile || !drawDisplayProfilePath(
                ctx, profile.outerLoop, sx, sy,
                profile.anchorLocalX, profile.anchorLocalY,
                worldX, worldR, offset))
            return false
        ctx.fillStyle = fillColor
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 1.15
        ctx.fill()
        ctx.stroke()
        for (var holeIndex = 0; holeIndex < profile.holeLoops.length; holeIndex++) {
            ctx.save()
            ctx.globalCompositeOperation = "destination-out"
            drawDisplayProfilePath(
                ctx, profile.holeLoops[holeIndex], sx, sy,
                profile.anchorLocalX, profile.anchorLocalY,
                worldX, worldR, offset)
            ctx.fill()
            ctx.restore()
            ctx.strokeStyle = strokeColor
            drawDisplayProfilePath(
                ctx, profile.holeLoops[holeIndex], sx, sy,
                profile.anchorLocalX, profile.anchorLocalY,
                worldX, worldR, offset)
            ctx.stroke()
        }
        return true
    }

    function drawDisplayProfileWalls(ctx, loops, sx, sy, anchorLocalX,
                                     anchorLocalY, worldX, worldR, vector,
                                     fillColor, strokeColor) {
        var wallCount = 0
        ctx.fillStyle = fillColor
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 0.75
        for (var loopIndex = 0; loops && loopIndex < loops.length; loopIndex++) {
            var loop = loops[loopIndex]
            for (var pointIndex = 0; loop && pointIndex < loop.length; pointIndex++) {
                var nextIndex = (pointIndex + 1) % loop.length
                var frontA = transformDxfPoint(
                    loop[pointIndex].x, loop[pointIndex].y,
                    worldX, worldR, anchorLocalX, anchorLocalY,
                    false, false, 0, 1)
                var frontB = transformDxfPoint(
                    loop[nextIndex].x, loop[nextIndex].y,
                    worldX, worldR, anchorLocalX, anchorLocalY,
                    false, false, 0, 1)
                ctx.beginPath()
                ctx.moveTo(sx(frontA.x), sy(frontA.r))
                ctx.lineTo(sx(frontB.x), sy(frontB.r))
                ctx.lineTo(sx(frontB.x + vector.x), sy(frontB.r + vector.r))
                ctx.lineTo(sx(frontA.x + vector.x), sy(frontA.r + vector.r))
                ctx.closePath()
                ctx.fill()
                ctx.stroke()
                wallCount++
            }
        }
        return wallCount
    }

    function displayProfileWorldLoop(points, anchorLocalX, anchorLocalY,
                                     worldX, worldR) {
        var result = []
        for (var pointIndex = 0; points && pointIndex < points.length;
                pointIndex++) {
            result.push(transformDxfPoint(
                points[pointIndex].x, points[pointIndex].y,
