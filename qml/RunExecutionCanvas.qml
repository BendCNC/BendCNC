    }

    function drawLiveSegmentedDxfModel(ctx, model, sx, sy, anchorLocalX,
                                       anchorLocalY, worldX, worldR, scaleFactor,
                                       strokeColor, fillColor, flipX, flipY,
                                       rotationCwDeg, segments, showDivisions) {
        if (!model || !segments || segments.length === 0)
            return drawLiveDxfModel(ctx, model, sx, sy, anchorLocalX, anchorLocalY,
                                    worldX, worldR, scaleFactor, strokeColor,
                                    fillColor, flipX, flipY, rotationCwDeg)
        var palette = liveToolingAppearancePalette()
        var isometric = String(liveProjectionMode).toUpperCase() === "ISOMETRIC"
        // SIDE intentionally overlays all stations at one machine section. In
        // ISOMETRIC, each configured segment gets its own physical depth span,
        // exposing every installed punch/die segment and the seams between them.
