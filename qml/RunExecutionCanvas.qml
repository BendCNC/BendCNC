            var transformed = transformDxfPoint(points[i].x, points[i].y,
                                                worldX, worldR,
                                                anchorLocalX, anchorLocalY,
                                                !!flipX, !!flipY,
                                                finite(rotationCwDeg, 0),
                                                finite(scaleFactor, 1))
