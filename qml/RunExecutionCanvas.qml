        for (var pointIndex = 0; pointIndex < outer.length; pointIndex++) {
            transformed.push(transformDxfPoint(
                outer[pointIndex].x, outer[pointIndex].y,
                worldX, worldR, anchorLocalX, anchorLocalY,
                !!flipX, !!flipY, finite(rotationCwDeg, 0),
                finite(scaleFactor, 1)))
