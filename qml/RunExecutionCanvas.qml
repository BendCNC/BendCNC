        var meshPoints = null
        if (backgaugeFingerOriginal && OriginalFingerMesh.ensure(loadText)) {
            var raw = OriginalFingerMesh.positions
            var local = []
            for (var p = 0; p + 2 < raw.length; p += 3)
                local.push({ x: raw[p], y: raw[p + 1] })
            var world = displayProfileWorldLoop(local, profile.anchorLocalX,
                                                profile.anchorLocalY, 0, 0)
            meshPoints = []
            for (var q = 0; q < world.length; q++)
                meshPoints.push({ x: world[q].x, r: world[q].r, z: raw[q * 3 + 2] })
        }
        return {
            outerLoop: outer,
            holeLoops: holes,
            meshPoints: meshPoints,
            meshTriangles: meshPoints ? OriginalFingerMesh.triangles : null,
            isometricVector: vector,
            outerVisibleEdges: outerVisibleEdges,
            holeVisibleEdges: holeVisibleEdges
        }
    }

    function drawPreparedDisplayProfilePath(ctx, points, sx, sy,
                                             worldX, worldR, offset) {
        if (!points || points.length < 3)
            return false
        var offsetX = finite(offset ? offset.x : 0, 0)
        var offsetR = finite(offset ? offset.r : 0, 0)
        ctx.beginPath()
        ctx.moveTo(sx(worldX + points[0].x + offsetX),
                   sy(worldR + points[0].r + offsetR))
        for (var pointIndex = 1; pointIndex < points.length; pointIndex++) {
            ctx.lineTo(sx(worldX + points[pointIndex].x + offsetX),
                       sy(worldR + points[pointIndex].r + offsetR))
        }
        ctx.closePath()
        return true
    }

    function drawPreparedBackgaugeFingerWalls(ctx, loops, visibleEdgesByLoop,
                                                sx, sy, worldX, worldR, vector,
                                                fillColor, strokeColor) {
        var wallCount = 0
        ctx.save()
        ctx.fillStyle = fillColor
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 0.75
        for (var loopIndex = 0; loops && loopIndex < loops.length; loopIndex++) {
            var contour = loops[loopIndex]
            var visibleEdges = visibleEdgesByLoop[loopIndex] || []
            for (var edgeIndex = 0; edgeIndex < visibleEdges.length; edgeIndex++) {
                var index = visibleEdges[edgeIndex]
                var nextIndex = (index + 1) % contour.length
                ctx.beginPath()
                ctx.moveTo(sx(worldX + contour[index].x),
                           sy(worldR + contour[index].r))
                ctx.lineTo(sx(worldX + contour[nextIndex].x),
                           sy(worldR + contour[nextIndex].r))
                ctx.lineTo(sx(worldX + contour[nextIndex].x + vector.x),
                           sy(worldR + contour[nextIndex].r + vector.r))
                ctx.lineTo(sx(worldX + contour[index].x + vector.x),
                           sy(worldR + contour[index].r + vector.r))
                ctx.closePath()
                ctx.fill()
                ctx.stroke()
                wallCount++
            }
        }
        ctx.restore()
        return wallCount
    }

    function drawPreparedBackgaugeFingerSolid(ctx, prepared, sx, sy,
                                               faceX, contactR) {
        if (!prepared)
            return { drawn: false, outerWalls: 0, holeWalls: 0 }
        var palette = backgaugeFingerAppearancePalette()
        var isometric = String(liveProjectionMode).toUpperCase() === "ISOMETRIC"
        var vector = isometric ? prepared.isometricVector : { x: 0, r: 0 }
        var extruded = Math.hypot(vector.x, vector.r) > 1.0e-6
        var outerWalls = 0
        var holeWalls = 0
        if (extruded) {
            outerWalls = drawPreparedBackgaugeFingerWalls(
                ctx, [prepared.outerLoop], [prepared.outerVisibleEdges],
                sx, sy, faceX, contactR, vector,
                palette.outerSideFill, palette.frontStroke)
            holeWalls = drawPreparedBackgaugeFingerWalls(
                ctx, prepared.holeLoops, prepared.holeVisibleEdges,
                sx, sy, faceX, contactR, vector,
                palette.holeSideFill, palette.frontStroke)
        }
        var visibleOffset = extruded ? vector : { x: 0, r: 0 }
        if (!drawPreparedDisplayProfilePath(
                ctx, prepared.outerLoop, sx, sy,
                faceX, contactR, visibleOffset)) {
            return { drawn: false, outerWalls: outerWalls, holeWalls: holeWalls }
        }
        ctx.fillStyle = palette.frontFill
        ctx.strokeStyle = palette.frontStroke
        ctx.lineWidth = 1.15
        ctx.fill()
        ctx.stroke()
        for (var holeIndex = 0;
                holeIndex < prepared.holeLoops.length; holeIndex++) {
            ctx.save()
            ctx.globalCompositeOperation = "destination-out"
            drawPreparedDisplayProfilePath(
                ctx, prepared.holeLoops[holeIndex], sx, sy,
                faceX, contactR, visibleOffset)
            ctx.fill()
            ctx.restore()
            ctx.strokeStyle = palette.frontStroke
            drawPreparedDisplayProfilePath(
                ctx, prepared.holeLoops[holeIndex], sx, sy,
                faceX, contactR, visibleOffset)
            ctx.stroke()
        }
        return {
            drawn: true,
            extruded: extruded,
            vector: vector,
            visibleFaceOffset: visibleOffset,
            outerWalls: outerWalls,
            holeWalls: holeWalls
        }
    }

    function drawBackgaugeFingerSide(
            ctx, sx, sy, faceX, contactR, resolvedFingerGeometry) {
        var gaugeStartedAt = runCanvasTimingActive ? Date.now() : 0
        var fingerGeometry = resolvedFingerGeometry !== undefined
            ? resolvedFingerGeometry : liveBackgaugeFingerGeometry()
        var fingerModel = fingerGeometry ? fingerGeometry.model : null
        var profile = fingerGeometry ? fingerGeometry.profile : null
        var geometryAt = runCanvasTimingActive ? Date.now() : 0
        var preparedProfile = fingerGeometry
            ? fingerGeometry.preparedProfile : null
        var solid = preparedProfile
            ? drawPreparedBackgaugeFingerSolid(
                ctx, preparedProfile, sx, sy, faceX, contactR)
            : drawBackgaugeFingerSolid(ctx, profile, sx, sy, faceX, contactR)
        if (preparedProfile && !solid.drawn)
            solid = drawBackgaugeFingerSolid(
                ctx, profile, sx, sy, faceX, contactR)
        var solidAt = runCanvasTimingActive ? Date.now() : 0
        if (fingerModel && solid.drawn) {
            var palette = backgaugeFingerAppearancePalette()
            var visibleFaceOffset = solid.visibleFaceOffset || { x: 0, r: 0 }
            drawDxfModel(ctx, fingerModel, sx, sy,
                         profile.anchorLocalX, profile.anchorLocalY,
                         faceX + finite(visibleFaceOffset.x, 0),
                         contactR + finite(visibleFaceOffset.r, 0), 1,
                         palette.frontStroke, "")
            if (runCanvasTimingActive) {
                var dxfAt = Date.now()
                canvasTimingGaugeGeometryMs += geometryAt - gaugeStartedAt
                canvasTimingGaugeSolidMs += solidAt - geometryAt
                canvasTimingGaugeDxfMs += dxfAt - solidAt
            }
            return
        }
        var anchorLocalX = 4.0
        var anchorLocalY = 0.375
        function local(localX, localY) { return { x: faceX + (localX - anchorLocalX), r: contactR + (localY - anchorLocalY) } }
        var outer = [
            local(0.375, 0.75), local(2.95, 0.75), local(3.00, 0.75), local(3.00, 0.375),
            local(3.95, 0.375), local(4.00, 0.375), local(4.00, 0.00), local(3.95, 0.00), local(0.375, 0.00)
        ]
        for (var step = 0; step <= 20; step++) {
            var t = step / 20
            var angle = (270 - 180 * t) * Math.PI / 180
            outer.push(local(0.375 + Math.cos(angle) * 0.375, 0.375 + Math.sin(angle) * 0.375))
        }
