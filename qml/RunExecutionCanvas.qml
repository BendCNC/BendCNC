            ctx.beginPath()
            for (var circleSample = 0; circleSample <= samples; circleSample++) {
                var angle = Math.PI * 2 * circleSample / samples
                var localX = circle.cx + Math.cos(angle) * circle.radius
                var localY = circle.cy + Math.sin(angle) * circle.radius
                var transformed = transformDxfPoint(localX, localY,
                    worldX, worldR, anchorLocalX, anchorLocalY,
                    !!flipX, !!flipY, finite(rotationCwDeg, 0), finite(scaleFactor, 1))
                if (circleSample === 0)
                    ctx.moveTo(sx(transformed.x), sy(transformed.r))
                else
                    ctx.lineTo(sx(transformed.x), sy(transformed.r))
            }
            for (var rearSample = samples; rearSample >= 0; rearSample--) {
                var rearAngle = Math.PI * 2 * rearSample / samples
                var rearLocalX = circle.cx + Math.cos(rearAngle) * circle.radius
                var rearLocalY = circle.cy + Math.sin(rearAngle) * circle.radius
                var rearTransformed = transformDxfPoint(rearLocalX, rearLocalY,
                    worldX, worldR, anchorLocalX, anchorLocalY,
                    !!flipX, !!flipY, finite(rotationCwDeg, 0), finite(scaleFactor, 1))
