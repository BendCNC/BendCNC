        // at display cadence. The old physical 100 ms interval capped visible
        // motion at 10 FPS even when frame construction was fast.
        // The pose/command builder is JavaScript on the GUI thread and the
        // target presents at 60 Hz. A 16 ms Timer competes with the previous
        // frame's QSG work and creates uneven callback bursts. Thirty visual
        // updates per second is the production floor and leaves one complete
        // display interval for packet parsing/presentation between poses.
        id: liveTickTimer
        interval: runCanvasRoot.liveFrameIntervalMs
