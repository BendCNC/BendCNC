            var frontA = transformDxfPoint(outer[index].x, outer[index].y,
                worldX, worldR, anchorLocalX, anchorLocalY,
                !!flipX, !!flipY, finite(rotationCwDeg, 0), finite(scaleFactor, 1))
            var frontB = transformDxfPoint(outer[nextIndex].x, outer[nextIndex].y,
                worldX, worldR, anchorLocalX, anchorLocalY,
                !!flipX, !!flipY, finite(rotationCwDeg, 0), finite(scaleFactor, 1))
            ctx.beginPath()
            ctx.moveTo(sx(frontA.x), sy(frontA.r))
            ctx.lineTo(sx(frontB.x), sy(frontB.r))
            ctx.lineTo(sx(frontB.x + vector.x), sy(frontB.r + vector.r))
            ctx.lineTo(sx(frontA.x + vector.x), sy(frontA.r + vector.r))
            ctx.closePath()
            ctx.fill()
            ctx.stroke()
            sideCount++
