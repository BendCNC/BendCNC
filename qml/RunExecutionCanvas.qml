            includeTransformedDxfBounds(staticBounds, dieModel, activeDieFace.anchorLocalX, activeDieFace.anchorLocalY, 0, 0, false, false, activeDieFace.rotationCwDeg, 1, extrusion)
        if (punchModel) {
            var punchProfile = staticScene && staticScene.punchProfile ? staticScene.punchProfile : resolvePunchProfile(punchModel)
            includeTransformedDxfBounds(punchBounds, punchModel, punchProfile.tipLocalX, punchProfile.tipLocalY, 0, 0, false, false, 0, 1, extrusion)
        }
        for (var offsetIndex = 0; offsetIndex < toolingOffsets.length; offsetIndex++) {
            var offset = toolingOffsets[offsetIndex]
