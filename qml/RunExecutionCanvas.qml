            ? runFrameTiming.timingTimestampNanoseconds() : -1
        var cacheKey = liveToolingBoundsIdentityKey
        if (cacheKey.length === 0) {
            cacheKey = liveStaticSceneKeyFor()
                + "|projection=" + String(liveProjectionMode).toUpperCase()
                + "|camera=" + normalizedLiveCameraOrientation()
                + "|coverage=" + String(finite(punchCoverageSideToleranceIn, 0))
