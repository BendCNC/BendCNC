                    && livePointDistanceToSegment(b, cap.a, cap.b) <= tolerance)
                return true
        }
        return false
    }

    function livePanelScreenGeometry(panel, sx, sy) {
        if (!panel)
            return null
        var source = panel.polygon && panel.polygon.length >= 3
            ? panel.polygon : panel.corners
        if (!source || source.length < 3)
            return null
        var viewportKey = String(sx(0)) + "|" + String(sx(1))
            + "|" + String(sy(0)) + "|" + String(sy(1))
        var panelKey = String(panel.liveScreenGeometryId || "")
        var key = panelKey.length > 0 ? panelKey + "|screen=" + viewportKey : ""
        var retained = key.length > 0
            ? livePanelScreenGeometryCache[key] : null
        if (retained && retained.viewportKey === viewportKey)
            return retained
        var points = []
        var minX = Infinity, minY = Infinity
        var maxX = -Infinity, maxY = -Infinity
        for (var pointIndex = 0; pointIndex < source.length; pointIndex++) {
            var point = {
                x: sx(source[pointIndex].x),
                y: sy(source[pointIndex].r)
            }
            points.push(point)
            minX = Math.min(minX, point.x)
            minY = Math.min(minY, point.y)
            maxX = Math.max(maxX, point.x)
            maxY = Math.max(maxY, point.y)
        }
        var holeLoops = []
        for (var holeIndex = 0; panel.holeLoops
                && holeIndex < panel.holeLoops.length; holeIndex++) {
            var sourceHole = panel.holeLoops[holeIndex]
            if (!sourceHole || sourceHole.length < 3)
                continue
            var screenHole = []
            for (var holePointIndex = 0;
                    holePointIndex < sourceHole.length; holePointIndex++) {
                screenHole.push({
                    x: sx(sourceHole[holePointIndex].x),
                    y: sy(sourceHole[holePointIndex].r)
                })
            }
            holeLoops.push(screenHole)
        }
        retained = {
            key: key,
            viewportKey: viewportKey,
            source: source,
            holeLoopsSource: panel.holeLoops,
            points: points,
            holeLoops: holeLoops,
            minX: minX,
            minY: minY,
            maxX: maxX,
            maxY: maxY
        }
        if (key.length > 0) {
            var cache = livePanelScreenGeometryCache
            var order = livePanelScreenGeometryCacheOrder
            if (!cache[key])
                order.push(key)
            cache[key] = retained
            while (order.length > livePanelScreenGeometryCacheLimit) {
                var evictedKey = order.shift()
                delete cache[evictedKey]
            }
        }
        return retained
    }

    function appendScreenHolePaths(ctx, screenGeometry) {
        var holes = screenGeometry && screenGeometry.holeLoops
            ? screenGeometry.holeLoops : []
        for (var holeIndex = 0; holeIndex < holes.length; holeIndex++) {
            var hole = holes[holeIndex]
            ctx.moveTo(hole[0].x, hole[0].y)
            for (var pointIndex = 1; pointIndex < hole.length; pointIndex++)
                ctx.lineTo(hole[pointIndex].x, hole[pointIndex].y)
            ctx.closePath()
        }
        return holes.length
    }

    function drawLivePanelPolygon(ctx, points, sx, sy, fillColor, strokeColor, internalCaps) {
        if (!points || points.length < 3)
            return
        ctx.beginPath()
        ctx.moveTo(sx(points[0].x), sy(points[0].r))
        for (var pointIndex = 1; pointIndex < points.length; pointIndex++)
            ctx.lineTo(sx(points[pointIndex].x), sy(points[pointIndex].r))
        ctx.closePath()
        ctx.fillStyle = fillColor
        ctx.fill()
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 1.7
        ctx.beginPath()
        for (var edgeIndex = 0; edgeIndex < points.length; edgeIndex++) {
            var edgeStart = points[edgeIndex]
            var edgeEnd = points[(edgeIndex + 1) % points.length]
            if (livePanelEdgeIsInternalSharedCap(edgeStart, edgeEnd, internalCaps))
                continue
            ctx.moveTo(sx(edgeStart.x), sy(edgeStart.r))
            ctx.lineTo(sx(edgeEnd.x), sy(edgeEnd.r))
        }
        ctx.stroke()
    }

    function operationMaterialFace(bend) {
        var explicitFace = String(firstNonBlank(
            bend, ["materialFace", "sheetFace"], "")).toUpperCase()
        if (explicitFace === "TOP" || explicitFace === "BOTTOM")
            return explicitFace
        var preview = parsePreview()
        var preview2d = preview && preview.flatPattern
            ? preview.flatPattern.preview2d : null
        var sourceFace = String(firstNonBlank(
            preview2d, ["sourceFace", "profileSourceFace"], "")).toLowerCase()
        if (sourceFace === "bottomface" || sourceFace === "bottom")
            return "BOTTOM"
        if (sourceFace === "topface" || sourceFace === "top")
            return "TOP"
        return "UNKNOWN"
    }

    function materialFacePresentation(bend) {
        var face = operationMaterialFace(bend)
        return {
            face: face,
            label: face === "BOTTOM" ? "MATERIAL FACE BOTTOM"
                : (face === "TOP" ? "MATERIAL FACE TOP" : "MATERIAL FACE UNKNOWN"),
            symbol: face === "BOTTOM" ? "▼" : (face === "TOP" ? "▲" : "?"),
            pattern: face === "BOTTOM" ? "cross" : (face === "TOP" ? "chevron" : "dash")
        }
    }

    function cachedMaterialFacePresentation(bend) {
        var faceStarted = runCanvasTimingActive ? Date.now() : 0
        var materialFace = String(bend && bend.materialFace !== undefined
                                  && bend.materialFace !== null
                                  ? bend.materialFace : "")
        var sheetFace = String(bend && bend.sheetFace !== undefined
                               && bend.sheetFace !== null
                               ? bend.sheetFace : "")
        if (runCanvasTimingActive)
            canvasTimingPresentationFaceKeyMs += Date.now() - faceStarted
        if (liveMaterialFacePresentationCacheInputsValid
                && liveMaterialFacePresentationCache
                && liveMaterialFacePresentationCacheMaterialFace === materialFace
                && liveMaterialFacePresentationCacheSheetFace === sheetFace) {
            if (runCanvasTimingActive)
                canvasTimingPresentationFaceMs += Date.now() - faceStarted
            return liveMaterialFacePresentationCache
        }
        var buildStarted = runCanvasTimingActive ? Date.now() : 0
        // Presentation depends only on these two bend fields and the preview's
        // global source face. Program changes invalidate all live caches, so
        // retaining the exact scalar inputs avoids rebuilding a revision/id
        // string while preserving every presentation result.
        liveMaterialFacePresentationCacheMaterialFace = materialFace
        liveMaterialFacePresentationCacheSheetFace = sheetFace
        liveMaterialFacePresentationCacheInputsValid = true
        liveMaterialFacePresentationCache = materialFacePresentation(bend)
        liveMaterialFacePresentationBuildCount += 1
        if (runCanvasTimingActive) {
            canvasTimingPresentationFaceBuildMs += Date.now() - buildStarted
            canvasTimingPresentationFaceMs += Date.now() - faceStarted
        }
        return liveMaterialFacePresentationCache
    }

    function panelMaterialFacePresentation(presentation, panel) {
        if (!presentation || !panel || panel.oppositePhysicalFace !== true)
            return presentation
        var face = presentation.face === "TOP" ? "BOTTOM"
            : (presentation.face === "BOTTOM" ? "TOP" : "UNKNOWN")
        return {
            face: face,
            label: face === "BOTTOM" ? "MATERIAL FACE BOTTOM"
                : (face === "TOP" ? "MATERIAL FACE TOP" : "MATERIAL FACE UNKNOWN"),
            symbol: face === "BOTTOM" ? "▼" : (face === "TOP" ? "▲" : "?"),
            // The darker fill already identifies the exterior face.
            pattern: "none"
        }
    }

    function livePanelFacePalette(panel) {
        var opposite = String(liveProjectionMode).toUpperCase() === "ISOMETRIC"
            && panel && panel.oppositePhysicalFace === true
        if (panel && panel.current) {
            return {
                fill: opposite ? "#709ccf" : "#bfdbfe",
                stroke: "rgba(37,99,235,0.82)"
            }
        }
        if (panel && panel.down) {
            return {
                fill: opposite ? "#c99d7c" : "#fde8d8",
                stroke: "rgba(154,52,18,0.78)"
            }
        }
        return {
            fill: opposite ? "#8bbe9d" : "#dcfce7",
            stroke: "rgba(22,101,52,0.78)"
        }
    }

    function drawLiveMaterialFacePattern(ctx, panel, sx, sy, facePresentation,
                                         holeStrokeColor, retainedScreenGeometry) {
        if (String(liveProjectionMode).toUpperCase() !== "ISOMETRIC" || !panel)
            return
        if (!facePresentation || facePresentation.pattern === "none")
            return
        var screenGeometry = retainedScreenGeometry === undefined
            ? livePanelScreenGeometry(panel, sx, sy) : retainedScreenGeometry
        if (!screenGeometry)
            return
        var points = screenGeometry.points
        ctx.save()
        ctx.beginPath()
        ctx.moveTo(points[0].x, points[0].y)
        for (var pointIndex = 1; pointIndex < points.length; pointIndex++)
            ctx.lineTo(points[pointIndex].x, points[pointIndex].y)
        ctx.closePath()
        appendScreenHolePaths(ctx, screenGeometry)
        ctx.fillRule = Qt.OddEvenFill
        ctx.clip()
        ctx.strokeStyle = facePresentation.face === "BOTTOM"
            ? "rgba(124,45,18,0.34)" : "rgba(21,94,117,0.31)"
        ctx.lineWidth = 1.05
        var spacing = 28
        var halfMark = 4.5
        ctx.beginPath()
        for (var y = screenGeometry.minY + spacing / 2;
            y <= screenGeometry.maxY; y += spacing) {
            for (var x = screenGeometry.minX + spacing / 2;
                x <= screenGeometry.maxX; x += spacing) {
                if (facePresentation.pattern === "cross") {
                    ctx.moveTo(x - halfMark, y - halfMark)
                    ctx.lineTo(x + halfMark, y + halfMark)
                    ctx.moveTo(x + halfMark, y - halfMark)
                    ctx.lineTo(x - halfMark, y + halfMark)
                } else if (facePresentation.pattern !== "chevron") {
                    ctx.moveTo(x - halfMark, y)
                    ctx.lineTo(x + halfMark, y)
                }
            }
        }
        ctx.stroke()
        ctx.restore()
    }

    function liveMaterialFaceLegendPosition() {
        return { x: 12, y: 12 }
    }

    function liveMaterialFaceLegendDescriptor(presentation, activeDieFace) {
        var orientation = normalizedLiveCameraOrientation()
        var dieName = String(activeDieFace && activeDieFace.name
            ? activeDieFace.name : "TOP")
        var cacheKey = String(presentation.face)
            + "|" + String(presentation.symbol)
            + "|" + String(presentation.label)
            + "|" + orientation
            + "|" + dieName
        if (liveMaterialFaceLegendCache
                && liveMaterialFaceLegendCacheKey === cacheKey)
            return liveMaterialFaceLegendCache
        var face = String(presentation.face)
        liveMaterialFaceLegendCacheKey = cacheKey
        liveMaterialFaceLegendCache = {
            border: face === "BOTTOM" ? "#9a3412"
                : (face === "TOP" ? "#0e7490" : "#64748b"),
            accent: face === "BOTTOM" ? "#9a3412"
                : (face === "TOP" ? "#155e75" : "#475569"),
            title: String(presentation.symbol) + "  "
                + String(presentation.label),
            view: "ISOMETRIC · " + isometricCameraBasis(orientation).label
                + " VIEW",
            die: "DIE FACE " + dieName
        }
        return liveMaterialFaceLegendCache
    }

    function drawLiveMaterialFaceLegend(ctx, presentation, activeDieFace) {
        if (String(liveProjectionMode).toUpperCase() !== "ISOMETRIC")
            return
        var descriptor = liveMaterialFaceLegendDescriptor(
            presentation, activeDieFace)
        var cardWidth = 184
        var cardHeight = 70
        var position = liveMaterialFaceLegendPosition()
        var x = position.x
        var y = position.y
        ctx.save()
        ctx.fillStyle = "rgba(248,250,252,0.96)"
        ctx.strokeStyle = descriptor.border
        ctx.lineWidth = 1.4
        drawRoundRect(ctx, x, y, cardWidth, cardHeight, 11, true, true)
        ctx.fillStyle = descriptor.accent
        ctx.textAlign = "left"
        ctx.textBaseline = "middle"
        ctx.font = "800 11px sans-serif"
        ctx.fillText(descriptor.title, x + 12, y + 19)
        ctx.fillStyle = "#475569"
        ctx.font = "700 11px sans-serif"
        ctx.fillText(descriptor.view, x + 12, y + 37)
        ctx.font = "600 11px sans-serif"
        ctx.fillText(descriptor.die, x + 12, y + 51)
        ctx.strokeStyle = "#5b21b6"
        ctx.lineWidth = 1.4
        ctx.setLineDash([4, 3])
        ctx.beginPath()
        ctx.moveTo(x + 12, y + 63)
        ctx.lineTo(x + 34, y + 63)
        ctx.stroke()
        ctx.setLineDash([])
        ctx.strokeStyle = "#b45309"
        ctx.lineWidth = 1.6
        ctx.beginPath()
        ctx.moveTo(x + 95, y + 63)
        ctx.lineTo(x + 117, y + 63)
        ctx.stroke()
        ctx.fillStyle = "#475569"
        ctx.font = "700 11px sans-serif"
        ctx.fillText("PUNCH", x + 39, y + 63)
        ctx.fillText("DIE", x + 122, y + 63)
        ctx.restore()
    }

    function updateLiveMaterialFaceLegendOverlay(presentation, activeDieFace) {
        liveMaterialFaceLegendOverlayDescriptor = presentation
            ? liveMaterialFaceLegendDescriptor(presentation, activeDieFace)
            : null
    }

    function drawLiveSectionPanel(ctx, panel, sx, sy, fillColor, strokeColor) {
        if (!panel || !panel.sectionSegment)
            return
        var polygon = liveSectionSegmentPolygon(panel.sectionSegment)
        if (polygon.length < 4)
            return
        drawLivePanelPolygon(ctx, polygon, sx, sy, fillColor, strokeColor,
                             panel.internalSharedCaps || [])
    }

    function drawLiveOrthogonalPanel(ctx, panel, sx, sy, facePresentation) {
        if (!panel || (!panel.sectionSegment && (!panel.corners || panel.corners.length < 3)))
            return
        var palette = livePanelFacePalette(panel)
        var screenGeometry = livePanelScreenGeometry(panel, sx, sy)
        var shapeStarted = runCanvasTimingActive ? Date.now() : 0
        drawLiveOrthogonalPanelShape(ctx, panel, sx, sy,
                                     palette.fill, palette.stroke,
                                     screenGeometry)
        if (runCanvasTimingActive)
            canvasTimingMaterialShapeMs += Date.now() - shapeStarted
        var patternStarted = runCanvasTimingActive ? Date.now() : 0
        drawLiveMaterialFacePattern(ctx, panel, sx, sy,
                                    panelMaterialFacePresentation(facePresentation, panel),
                                    palette.stroke, screenGeometry)
        if (runCanvasTimingActive)
            canvasTimingMaterialPatternMs += Date.now() - patternStarted
        var holesStarted = runCanvasTimingActive ? Date.now() : 0
        drawLivePanelHoleContours(ctx, panel, sx, sy, palette.stroke,
                      screenGeometry)
        if (runCanvasTimingActive)
            canvasTimingMaterialHolesMs += Date.now() - holesStarted
    }

    function livePanelCameraDepthInterval(panel, cameraSign) {
        var resolvedCameraSign = isFinite(Number(cameraSign))
            ? Number(cameraSign) : finite(isometricCameraBasis().viewAxisSign, 1)
        var first = finite(panel ? panel.viewDepthMin : NaN,
                           finite(panel ? panel.viewDepthCentroid : NaN, 0)) * resolvedCameraSign
        var second = finite(panel ? panel.viewDepthMax : NaN,
                            finite(panel ? panel.viewDepthCentroid : NaN, 0)) * resolvedCameraSign
        return {
            far: Math.min(first, second),
            near: Math.max(first, second),
            centroid: finite(panel ? panel.viewDepthCentroid : NaN, 0) * resolvedCameraSign
        }
    }

    function orderedLivePanelsForPaint(panels) {
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        for (var cacheIndex = 0; livePaintOrderCache
                && cacheIndex < livePaintOrderCache.length; cacheIndex++) {
            var cachedOrder = livePaintOrderCache[cacheIndex]
            if (cachedOrder && cachedOrder.panels === panels
                    && cachedOrder.cameraSign === cameraSign)
                return cachedOrder.ordered
        }
        var sortStarted = runCanvasTimingActive ? Date.now() : 0
        var decoratedPanels = []
        for (var panelIndex = 0; panels && panelIndex < panels.length; panelIndex++) {
            var panel = panels[panelIndex]
            decoratedPanels.push({
                panel: panel,
                depth: livePanelCameraDepthInterval(panel, cameraSign)
            })
        }
        decoratedPanels.sort(function(leftEntry, rightEntry) {
            var left = leftEntry.panel
            var right = rightEntry.panel
            if (left && right && left.completed === true
                    && right.completed === true
                    && Number(left.ownerSequence) !== Number(right.ownerSequence))
                return Number(right.ownerSequence) - Number(left.ownerSequence)
            var leftDepth = leftEntry.depth
            var rightDepth = rightEntry.depth
            return leftDepth.near - rightDepth.near
                || leftDepth.centroid - rightDepth.centroid
                || leftDepth.far - rightDepth.far
                || String(left ? (left.graphPanelId || left.badgeKey || "") : "")
                    .localeCompare(String(right ? (right.graphPanelId || right.badgeKey || "") : ""))
        })
        var orderedPanels = []
        for (var orderedIndex = 0; orderedIndex < decoratedPanels.length; orderedIndex++)
            orderedPanels.push(decoratedPanels[orderedIndex].panel)
        if (runCanvasTimingActive) {
            canvasTimingSortCount += 1
            canvasTimingSortMs += Date.now() - sortStarted
        }
        livePaintOrderCache.push({
            panels: panels,
            cameraSign: cameraSign,
            ordered: orderedPanels
        })
        return orderedPanels
    }

    function drawLivePanelCollection(ctx, panels, sx, sy, facePresentation) {
        // Inclusive collection time attributes ordering, traversal, dispatch,
        // and panel drawing. Existing sort/shape/pattern/hole counters allow
        // the otherwise invisible collection overhead to be derived without
        // changing painter order or Canvas commands.
        var collectionStarted = runCanvasTimingActive ? Date.now() : 0
        var orderedPanels = orderedLivePanelsForPaint(panels)
        for (var panelIndex = 0; panelIndex < orderedPanels.length; panelIndex++)
            drawLiveOrthogonalPanel(ctx, orderedPanels[panelIndex], sx, sy,
                                    facePresentation)
        if (runCanvasTimingActive)
            canvasTimingMaterialCollectionMs += Date.now() - collectionStarted
    }

    function drawLiveDepthClippedPanelCollection(ctx, panels, sx, sy,
                                                 facePresentation, punchDepth,
                                                 keepFront) {
        var orderedPanels = orderedLivePanelsForPaint(panels)
        for (var panelIndex = 0; panelIndex < orderedPanels.length; panelIndex++) {
            var panel = orderedPanels[panelIndex]
            var source = panel && panel.polygon && panel.polygon.length >= 3
                ? panel.polygon : (panel ? panel.corners : null)
            var screenPoints = []
            for (var pointIndex = 0; source && pointIndex < source.length; pointIndex++)
                screenPoints.push({ x: sx(source[pointIndex].x), y: sy(source[pointIndex].r) })
            var plane = livePanelScreenDepthPlane(panel, sx, sy)
            if (!plane) {
                // Edge-on representatives and degenerate display polygons do
                // not always define an affine screen-depth plane. Never drop
                // their opaque material body: paint it on the pass selected by
                // its camera-space centroid instead.
                var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
                var centroidDepth = finite(panel ? panel.viewDepthCentroid : NaN,
                                           finite(punchDepth, 0)) * cameraSign
                var toolingDepth = finite(punchDepth, 0) * cameraSign
                if (keepFront === (centroidDepth >= toolingDepth))
                    drawLiveOrthogonalPanel(ctx, panel, sx, sy, facePresentation)
                continue
            }
            var clipped = clipScreenPolygonByDepth(
                screenPoints, plane, punchDepth, keepFront)
            if (clipped.length < 3)
                continue
            ctx.save()
            ctx.beginPath()
            ctx.moveTo(clipped[0].x, clipped[0].y)
            for (var clippedIndex = 1; clippedIndex < clipped.length; clippedIndex++)
                ctx.lineTo(clipped[clippedIndex].x, clipped[clippedIndex].y)
            ctx.closePath()
            ctx.clip()
            drawLiveOrthogonalPanel(ctx, panel, sx, sy, facePresentation)
            ctx.restore()
        }
    }

    function drawQualifiedV5FilletCues(ctx, sx, sy, cues, visiblePanelIds) {
        if (String(liveProjectionMode).toUpperCase() !== "ISOMETRIC"
                || !cues || cues.length === 0)
            return
        ctx.save()
        ctx.lineCap = "round"
        for (var cueIndex = 0; cueIndex < cues.length; cueIndex++) {
            var cue = cues[cueIndex]
            if (visiblePanelIds && !visiblePanelIds[String(cue.panelId)])
                continue
            ctx.strokeStyle = cue.contact === "PUNCH"
                ? "rgba(91,33,182,0.92)" : "rgba(180,83,9,0.92)"
            ctx.lineWidth = cue.contact === "PUNCH" ? 1.45 : 1.65
            ctx.setLineDash([])
            ctx.beginPath()
            for (var lineIndex = 0; cue.lines && lineIndex < cue.lines.length; lineIndex++) {
                var line = cue.lines[lineIndex]
                if (!line || !line.a || !line.b)
                    continue
                ctx.moveTo(sx(line.a.x), sy(line.a.r))
                ctx.lineTo(sx(line.b.x), sy(line.b.r))
            }
            ctx.stroke()
        }
        ctx.setLineDash([])
        ctx.restore()
    }

    function appendLivePanelHolePaths(ctx, panel, sx, sy) {
        var holes = panel && panel.holeLoops ? panel.holeLoops : []
        var appended = 0
        for (var holeIndex = 0; holeIndex < holes.length; holeIndex++) {
            var hole = holes[holeIndex]
            if (!hole || hole.length < 3)
                continue
            ctx.moveTo(sx(hole[0].x), sy(hole[0].r))
            for (var pointIndex = 1; pointIndex < hole.length; pointIndex++)
                ctx.lineTo(sx(hole[pointIndex].x), sy(hole[pointIndex].r))
            ctx.closePath()
            appended++
        }
        return appended
    }

    function drawLivePanelHoleContours(ctx, panel, sx, sy, strokeColor,
                                       retainedScreenGeometry) {
        ctx.save()
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 1.1
        ctx.beginPath()
        var screenGeometry = retainedScreenGeometry === undefined
            ? livePanelScreenGeometry(panel, sx, sy) : retainedScreenGeometry
        var count = appendScreenHolePaths(
            ctx, screenGeometry)
        if (count > 0)
            ctx.stroke()
        ctx.restore()
        return count
    }

    function drawLiveOrthogonalPanelShape(ctx, panel, sx, sy, fillColor,
                                          strokeColor, retainedScreenGeometry) {
        if (panel && panel.sectionSegment) {
            drawLiveSectionPanel(ctx, panel, sx, sy, fillColor, strokeColor)
            return
        }
        // Use the transported, locally clamped CAD contour. It contains valid
        // chamfers and 45-degree union segments that are absent from corners.
        // Normalize its contour walk before closing it, matching the Java
        // renderer's validated repeated-excursion cleanup.
        var sourceOutline = panel.polygon && panel.polygon.length >= 3 ? panel.polygon : panel.corners
        var outline = panel.liveContourNormalized ? sourceOutline : cleanLiveContourOutlineForStroke(sourceOutline)
        if (!outline || outline.length < 3)
            return
        var screenGeometry = panel.liveContourNormalized
            ? (retainedScreenGeometry === undefined
                ? livePanelScreenGeometry(panel, sx, sy)
                : retainedScreenGeometry)
            : null
        ctx.save()
        ctx.beginPath()
        ctx.moveTo(screenGeometry ? screenGeometry.points[0].x : sx(outline[0].x),
                   screenGeometry ? screenGeometry.points[0].y : sy(outline[0].r))
        for (var outlineIndex = 1; outlineIndex < outline.length; outlineIndex++) {
            ctx.lineTo(screenGeometry ? screenGeometry.points[outlineIndex].x
                                      : sx(outline[outlineIndex].x),
                       screenGeometry ? screenGeometry.points[outlineIndex].y
                                      : sy(outline[outlineIndex].r))
        }
        ctx.closePath()
        if (screenGeometry)
            appendScreenHolePaths(ctx, screenGeometry)
        else
            appendLivePanelHolePaths(ctx, panel, sx, sy)
        ctx.fillRule = Qt.OddEvenFill
        ctx.fillStyle = fillColor
        ctx.fill()
        ctx.restore()
        ctx.strokeStyle = strokeColor
        ctx.lineWidth = 1.7
        ctx.beginPath()
        for (var edgeIndex = 0; edgeIndex < outline.length; edgeIndex++) {
            var edgeStart = outline[edgeIndex]
            var edgeEnd = outline[(edgeIndex + 1) % outline.length]
            if (livePanelEdgeIsInternalSharedCap(
                    edgeStart, edgeEnd, panel.internalSharedCaps || []))
                continue
            ctx.moveTo(screenGeometry ? screenGeometry.points[edgeIndex].x
                                      : sx(edgeStart.x),
                       screenGeometry ? screenGeometry.points[edgeIndex].y
                                      : sy(edgeStart.r))
            var nextIndex = (edgeIndex + 1) % outline.length
            ctx.lineTo(screenGeometry ? screenGeometry.points[nextIndex].x
                                      : sx(edgeEnd.x),
                       screenGeometry ? screenGeometry.points[nextIndex].y
                                      : sy(edgeEnd.r))
        }
        ctx.stroke()
    }

    function intervalsOverlap(aStart, aEnd, bStart, bEnd, tolerance) {
        return Math.max(aStart, bStart) <= Math.min(aEnd, bEnd) + tolerance
    }

    function shouldSuppressOrthogonalProjectionToolingCollision(current) {
        if (!current || !current.allowedPunchWindow || !current.installedSegments || current.installedSegments.length === 0)
            return false
        var allowed = current.allowedPunchWindow
        if (allowed.endXIn - allowed.startXIn <= 0.05)
            return false
        for (var i = 0; i < current.installedSegments.length; i++) {
            var segment = current.installedSegments[i]
            if (!segment)
                return false
            if (segment.startXIn < allowed.startXIn - 0.02 || segment.endXIn > allowed.endXIn + 0.02)
                return false
            if (current.forbiddenZones) {
                for (var zoneIndex = 0; zoneIndex < current.forbiddenZones.length; zoneIndex++) {
                    var zone = current.forbiddenZones[zoneIndex]
                    if (zone && intervalsOverlap(segment.startXIn, segment.endXIn, zone.startXIn, zone.endXIn, 0.01))
                        return false
                }
            }
        }
        return true
    }

    function drawLivePunchOcclusionOverlay(ctx, sx, sy, currentTooling, orthogonalPanels, collisions) {
        if (!orthogonalPanels || orthogonalPanels.length === 0 || !currentTooling)
            return
        if (!shouldSuppressOrthogonalProjectionToolingCollision(currentTooling))
            return
        if (collisions && (collisions.sheetPunch || collisions.sheetDie))
            return
        for (var i = 0; i < orthogonalPanels.length; i++)
            drawLiveOrthogonalPanelShape(ctx, orthogonalPanels[i], sx, sy, "rgba(187,247,208,0.92)", "#059669")
    }

    // Phase 3.2: orange joint dots for the live branch skeleton. 1:1 with Java
    // RunExecutionPreviewRenderer.drawPlacementJointGraphOverlay: only the current
    // bend's joints are drawn (filled oval radius 4 + stroked outer ring radius+2).
    function drawPlacementJointGraphOverlay(ctx, sx, sy, data, graph) {
        if (!graph || !graph.joints || !data || !data.currentBend)
            return
        var currentId = bendId(data.currentBend)
        for (var i = 0; i < graph.joints.length; i++) {
            var joint = graph.joints[i]
            if (!joint || !joint.livePoint)
                continue
            var current = joint.bendId === currentId
            if (!current)
                continue
            var radius = 4.0
            var x = sx(joint.livePoint.x)
            var y = sy(joint.livePoint.y)
            ctx.fillStyle = "rgba(249,115,22,0.95)"
            ctx.beginPath()
            ctx.arc(x, y, radius, 0, Math.PI * 2)
            ctx.fill()
            ctx.strokeStyle = "rgba(249,115,22,0.95)"
            ctx.lineWidth = current ? 1.6 : 1.2
            ctx.beginPath()
            ctx.arc(x, y, radius + 2.0, 0, Math.PI * 2)
            ctx.stroke()
        }
    }

    // Phase 3.3: live branch skeleton edges. 1:1 with Java
    // RunExecutionPreviewRenderer.drawLiveBranchSkeletonOverlay panel loop:
    //   mount edge  Blue  #1e3a8a 2.8px dash 6-4 + endpoint dots,
    //   free edge   Cyan  #06b6d4 2.4px solid   + endpoint dots,
    //   chevron     Magenta #d946ef 2.0px dash 4-4 from mount-mid to closest pt on free edge.
    // Works on adapted panels (polygon {x,y} where y = world R), drawn via sx/sy.
    function drawWorldSkeletonDot(ctx, sx, sy, point, color) {
        if (!point)
            return
        ctx.fillStyle = color
        ctx.beginPath()
        ctx.arc(sx(point.x), sy(point.y), 2.0, 0, Math.PI * 2)
        ctx.fill()
    }

    function drawWorldSkeletonChevron(ctx, sx, sy, fromPoint, toPoint, color) {
        if (!fromPoint || !toPoint)
            return
        var fx = sx(fromPoint.x), fy = sy(fromPoint.y)
        var tx = sx(toPoint.x), ty = sy(toPoint.y)
        var dx = tx - fx, dy = ty - fy
        var len = Math.sqrt(dx * dx + dy * dy)
        if (len < 0.0001)
            return
        var ux = dx / len, uy = dy / len
        var size = 6.0
        var ax = tx - ux * size, ay = ty - uy * size
        var nx = -uy, ny = ux
        ctx.strokeStyle = color
        ctx.lineWidth = 2.0
        ctx.setLineDash([])
        ctx.beginPath()
        ctx.moveTo(ax + nx * (size * 0.5), ay + ny * (size * 0.5))
        ctx.lineTo(tx, ty)
        ctx.lineTo(ax - nx * (size * 0.5), ay - ny * (size * 0.5))
        ctx.stroke()
    }

    function drawLiveBranchSkeletonEdges(ctx, sx, sy, orthogonalPanels) {
        if (!orthogonalPanels || orthogonalPanels.length === 0)
            return
        var adapted = liveJointMapPanels(orthogonalPanels, ({}))
        for (var i = 0; i < adapted.length; i++) {
            var panel = adapted[i]
            if (!panel || !panel.anchor || !panel.anchor.attachStart || !panel.anchor.attachEnd)
                continue
            var mountEdge = LiveContactMap.resolveVisiblePanelMountEdge(panel.polygon, panel.anchor)
            if (!mountEdge)
                mountEdge = { a: panel.anchor.attachStart, b: panel.anchor.attachEnd }
            ctx.strokeStyle = "#1e3a8a"
            ctx.lineWidth = 2.8
            ctx.setLineDash([6, 4])
            ctx.beginPath()
            ctx.moveTo(sx(mountEdge.a.x), sy(mountEdge.a.y))
            ctx.lineTo(sx(mountEdge.b.x), sy(mountEdge.b.y))
            ctx.stroke()
            ctx.setLineDash([])
            drawWorldSkeletonDot(ctx, sx, sy, mountEdge.a, "#1e3a8a")
            drawWorldSkeletonDot(ctx, sx, sy, mountEdge.b, "#1e3a8a")

            var freeEdge = LiveContactMap.resolveVisiblePanelFreeEdge(panel.polygon, panel.anchor)
            if (!freeEdge)
                continue
            ctx.strokeStyle = "#06b6d4"
            ctx.lineWidth = 2.4
            ctx.setLineDash([])
            ctx.beginPath()
            ctx.moveTo(sx(freeEdge.a.x), sy(freeEdge.a.y))
            ctx.lineTo(sx(freeEdge.b.x), sy(freeEdge.b.y))
            ctx.stroke()
            drawWorldSkeletonDot(ctx, sx, sy, freeEdge.a, "#06b6d4")
            drawWorldSkeletonDot(ctx, sx, sy, freeEdge.b, "#06b6d4")

            var mountMid = LiveContactMap.midpoint(mountEdge.a, mountEdge.b)
            var freeMid = LiveContactMap.closestPointOnSegment(mountMid, freeEdge.a, freeEdge.b)
            ctx.strokeStyle = "#d946ef"
            ctx.lineWidth = 2.0
            ctx.setLineDash([4, 4])
            ctx.beginPath()
            ctx.moveTo(sx(mountMid.x), sy(mountMid.y))
            ctx.lineTo(sx(freeMid.x), sy(freeMid.y))
            ctx.stroke()
            ctx.setLineDash([])
            drawWorldSkeletonChevron(ctx, sx, sy, mountMid, freeMid, "#d946ef")
        }
    }

    function drawQualifiedV5DebugOverlay(ctx, sx, sy, overlay) {
        if (!overlay || String(overlay.authority) !== "posed-v5")
            return
        var hinges = overlay.hinges || []
        for (var hingeIndex = 0; hingeIndex < hinges.length; hingeIndex++) {
            var hinge = hinges[hingeIndex]
            if (!hinge || !hinge.a || !hinge.b)
                continue
            var hingeColor = hinge.current ? "#1d4ed8" : "rgba(30,58,138,0.72)"
            ctx.strokeStyle = hingeColor
            ctx.lineWidth = hinge.current ? 3.0 : 2.0
            ctx.setLineDash(hinge.current ? [6, 4] : [3, 4])
            ctx.beginPath()
            ctx.moveTo(sx(hinge.a.x), sy(hinge.a.r))
            ctx.lineTo(sx(hinge.b.x), sy(hinge.b.r))
            ctx.stroke()
            ctx.setLineDash([])
            drawWorldSkeletonDot(ctx, sx, sy,
                                 { x: hinge.a.x, y: hinge.a.r }, hingeColor)
            drawWorldSkeletonDot(ctx, sx, sy,
                                 { x: hinge.b.x, y: hinge.b.r }, hingeColor)
        }
        var directions = overlay.directions || []
        for (var directionIndex = 0; directionIndex < directions.length; directionIndex++) {
            var direction = directions[directionIndex]
            if (!direction || !direction.from || !direction.to)
                continue
            var directionColor = direction.current ? "#d946ef" : "rgba(192,38,211,0.62)"
            ctx.strokeStyle = directionColor
            ctx.lineWidth = direction.current ? 2.2 : 1.5
            ctx.setLineDash([4, 4])
            ctx.beginPath()
            ctx.moveTo(sx(direction.from.x), sy(direction.from.r))
            ctx.lineTo(sx(direction.to.x), sy(direction.to.r))
            ctx.stroke()
            ctx.setLineDash([])
            drawWorldSkeletonChevron(
                ctx, sx, sy,
                { x: direction.from.x, y: direction.from.r },
                { x: direction.to.x, y: direction.to.r }, directionColor)
        }
    }

    function drawLiveFlangePanelBadges(ctx, sx, sy, frameArtifacts) {
        var badgeStartedAt = runCanvasTimingActive ? Date.now() : 0
        var panels = frameArtifacts && frameArtifacts.orthogonalPanels ? frameArtifacts.orthogonalPanels : []
        var metricsNamespace = ctx && ctx._liveBadgeMetricsNamespace
            ? String(ctx._liveBadgeMetricsNamespace) : "canvas-context2d"
        var viewportKey = metricsNamespace + "|" + String(sx(0)) + "|" + String(sx(1))
            + "|" + String(sy(0)) + "|" + String(sy(1))
        var layout = frameArtifacts && frameArtifacts.liveBadgeLayout
        if (!layout || layout.viewportKey !== viewportKey) {
            layout = buildLiveFlangePanelBadgeLayout(ctx, sx, sy, panels, viewportKey)
            if (frameArtifacts)
                frameArtifacts.liveBadgeLayout = layout
        }
        var badgeBoundsAt = runCanvasTimingActive ? Date.now() : 0
        ctx.save()
        var badgeShadowLineWidth = ctx.lineWidth
        ctx.font = "bold 11px sans-serif"
        ctx.textAlign = "center"
        ctx.textBaseline = "middle"
        for (var badgeIndex = 0; layout && badgeIndex < layout.badges.length; badgeIndex++) {
            var badge = layout.badges[badgeIndex]
            drawPlacedBadge(ctx, badge, badge.text, "#dcfce7", "#166534",
                            true, badgeShadowLineWidth)
        }
        ctx.restore()
        if (runCanvasTimingActive) {
            var badgeFinishedAt = Date.now()
            canvasTimingPostBadgeBoundsMs += badgeBoundsAt - badgeStartedAt
            canvasTimingPostBadgeDrawMs += badgeFinishedAt - badgeBoundsAt
        }
    }

    function buildLiveFlangePanelBadgeLayout(ctx, sx, sy, panels, viewportKey) {
        ctx.save()
        ctx.font = "bold 11px sans-serif"
        var drawn = ({})
        var occupied = []
        var badges = []
        var minX = Infinity
        var minY = Infinity
        var maxX = -Infinity
        var maxY = -Infinity
        for (var b = 0; b < panels.length; b++) {
            var boundsPanel = panels[b]
            var boundsPoints = boundsPanel && boundsPanel.polygon && boundsPanel.polygon.length >= 3 ? boundsPanel.polygon : (boundsPanel ? boundsPanel.corners : null)
            for (var p = 0; boundsPoints && p < boundsPoints.length; p++) {
                var px = sx(boundsPoints[p].x)
                var py = sy(boundsPoints[p].r)
                minX = Math.min(minX, px)
                minY = Math.min(minY, py)
                maxX = Math.max(maxX, px)
                maxY = Math.max(maxY, py)
            }
        }
        if (!isFinite(minX) || !isFinite(minY) || !isFinite(maxX) || !isFinite(maxY)) {
            minX = 0
            minY = 0
            maxX = 4096
            maxY = 4096
        } else {
            minX -= 18
            minY -= 18
            maxX += 18
            maxY += 18
        }
        for (var i = 0; i < panels.length; i++) {
            var panel = panels[i]
            if (!livePanelBadgeEligible(panel))
                continue
            var key = panel.badgeKey || panel.label
            if (drawn[key])
                continue
            drawn[key] = true
            var widthValue = Math.max(
                28, measuredLiveBadgeTextWidth(ctx, panel.label) + 14)
            var placement = liveBadgePlacement(
                sx(panel.labelPoint.x), sy(panel.labelPoint.r), widthValue,
                minX, minY, maxX, maxY, occupied)
            placement.text = panel.label
            badges.push(placement)
        }
        ctx.restore()
        liveBadgeLayoutBuildCount++
        return { viewportKey: viewportKey, badges: badges }
    }

    function livePanelBadgeEligible(panel) {
        return !!panel && panel.completed === true
            && !!panel.label && !!panel.labelPoint
    }

    function drawLiveRailPill(ctx, x, y, text, bg, fg) {
        ctx.save()
        ctx.font = "bold 11px sans-serif"
        var widthValue = Math.max(46, ctx.measureText(text).width + 14)
        var heightValue = 18
        ctx.fillStyle = bg
        ctx.strokeStyle = "rgba(15,23,42,0.14)"
        ctx.lineWidth = 0.9
        drawRoundRect(ctx, x - widthValue, y - heightValue / 2, widthValue, heightValue, 7, true, true)
        ctx.fillStyle = fg
        ctx.textAlign = "center"
        ctx.textBaseline = "middle"
        ctx.fillText(text, x - widthValue / 2, y + 0.5)
        ctx.restore()
    }

    function drawLivePositionReferenceLines(ctx, sx, sy, minX, maxX, references, suppressGuides) {
        if (!references)
            return
        var leftX = sx(minX + 0.45)
        var rightX = sx(maxX - 0.55)
        var railX = sx(maxX - 0.22)
        var rows = [
            { label: "START", r: references.startR, stroke: "rgba(99,102,241,0.26)", dash: [6, 4], bg: "rgba(238,242,255,0.96)", fg: "#4338ca" },
            { label: "CLAMP", r: references.clampR, stroke: "rgba(8,145,178,0.40)", dash: [5, 4], bg: "rgba(236,254,255,0.96)", fg: "#0f766e" },
            { label: "FINAL", r: references.finalBendR, stroke: "rgba(220,38,38,0.34)", dash: [3, 3], bg: "rgba(254,242,242,0.96)", fg: "#b91c1c" }
        ]
        ctx.save()
        for (var i = 0; i < rows.length; i++) {
            var y = sy(rows[i].r)
            ctx.strokeStyle = rows[i].stroke
            ctx.lineWidth = 1.0
            ctx.setLineDash(rows[i].dash)
            ctx.beginPath()
            ctx.moveTo(leftX, y)
            ctx.lineTo(rightX, y)
            ctx.stroke()
            ctx.setLineDash([])
            drawLiveRailPill(ctx, railX - 4, y, rows[i].label, rows[i].bg, rows[i].fg)
        }
        if (guides && suppressGuides !== true) {
            drawLiveRailPill(ctx, railX + 44, sy(references.startR + 2.2), "HOME POSITION", "rgba(255,255,255,0.94)", "#111827")
            drawLiveRailPill(ctx, railX + 44, sy(-0.45), "TABLE", "rgba(255,255,255,0.92)", "#334155")
        }
        ctx.restore()
    }

    function resolveLiveSceneBounds(data, staticScene, pose, liveGeometry,
                                    completedSegments, orthogonalPanels,
                                    orthogonalPanelBounds) {
        var boundsStartedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        var minX = Infinity
        var maxX = -Infinity
        var minR = Infinity
        var maxR = -Infinity

        for (var sp = 0; liveGeometry && liveGeometry.sheetPolygon && sp < liveGeometry.sheetPolygon.length; sp++) {
            var sheetPoint = liveGeometry.sheetPolygon[sp]
            if (!sheetPoint)
                continue
            minX = Math.min(minX, sheetPoint.x)
            maxX = Math.max(maxX, sheetPoint.x)
            minR = Math.min(minR, sheetPoint.r)
            maxR = Math.max(maxR, sheetPoint.r)
        }

        for (var cs = 0; completedSegments && cs < completedSegments.length; cs++) {
            var segment = completedSegments[cs]
            if (!segment)
                continue
            minX = Math.min(minX, segment.start.x, segment.end.x)
            maxX = Math.max(maxX, segment.start.x, segment.end.x)
            minR = Math.min(minR, segment.start.r, segment.end.r)
            maxR = Math.max(maxR, segment.start.r, segment.end.r)
        }

        var retainedPanelBoundsValid = orthogonalPanelBounds
            && isFinite(orthogonalPanelBounds.minX)
            && isFinite(orthogonalPanelBounds.maxX)
            && isFinite(orthogonalPanelBounds.minR)
            && isFinite(orthogonalPanelBounds.maxR)
        if (retainedPanelBoundsValid) {
            minX = Math.min(minX, orthogonalPanelBounds.minX)
            maxX = Math.max(maxX, orthogonalPanelBounds.maxX)
            minR = Math.min(minR, orthogonalPanelBounds.minR)
            maxR = Math.max(maxR, orthogonalPanelBounds.maxR)
        } else {
            for (var op = 0; orthogonalPanels && op < orthogonalPanels.length; op++) {
                var panel = orthogonalPanels[op]
                if (!panel)
                    continue
                var panelBoundsPoints = panel.polygon && panel.polygon.length >= 2
                    ? panel.polygon : panel.corners
                for (var pc = 0; panelBoundsPoints
                        && pc < panelBoundsPoints.length; pc++) {
                    var corner = panelBoundsPoints[pc]
                    if (!corner)
                        continue
                    minX = Math.min(minX, corner.x)
                    maxX = Math.max(maxX, corner.x)
                    minR = Math.min(minR, corner.r)
                    maxR = Math.max(maxR, corner.r)
                }
                var sectionBounds = liveSectionSegmentPolygon(panel.sectionSegment)
                for (var sectionPointIndex = 0;
                        sectionPointIndex < sectionBounds.length;
                        sectionPointIndex++) {
                    var sectionPoint = sectionBounds[sectionPointIndex]
                    minX = Math.min(minX, sectionPoint.x)
                    maxX = Math.max(maxX, sectionPoint.x)
                    minR = Math.min(minR, sectionPoint.r)
                    maxR = Math.max(maxR, sectionPoint.r)
                }
            }
        }

        var geometryBoundsEndedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        if (runFrameTimingActive)
            runFrameTiming.recordStageNanoseconds(
                "v5-bounds-geometry",
                geometryBoundsEndedNs - boundsStartedNs)
        var toolingBoundsStartedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        // The viewport only expands (retainedLiveViewportBounds). Reserve the
        // full flange sweep up front so rising flanges never rescale the
        // camera mid-stroke, which made punch and part appear to jump.
        if (isFinite(minX) && isFinite(maxX)) {
            var sweepCenterX = finite(pose.centerX, 0)
            var sweepReach = Math.max(Math.abs(minX - sweepCenterX),
                                      Math.abs(maxX - sweepCenterX))
            minX = Math.min(minX, sweepCenterX - sweepReach)
            maxX = Math.max(maxX, sweepCenterX + sweepReach)
            maxR = Math.max(maxR, sweepReach)
        }
        var toolingBounds = { minX: minX, maxX: maxX, minR: minR, maxR: maxR }
        includeLiveToolingBounds(toolingBounds, pose, staticScene)
        var toolingBoundsEndedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        if (runFrameTimingActive)
            runFrameTiming.recordStageNanoseconds(
                "v5-bounds-tooling",
                toolingBoundsEndedNs - toolingBoundsStartedNs)
        var boundsFinalizeStartedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        minX = toolingBounds.minX
        maxX = toolingBounds.maxX
        minR = toolingBounds.minR
        maxR = toolingBounds.maxR

        var fingerWidth = 0.9
        if (data && data.fingerSide && data.fingerSide.bounds)
            fingerWidth = Math.abs(data.fingerSide.bounds.maxX - data.fingerSide.bounds.minX)
        minX = Math.min(minX, finite(pose.gaugeFaceX, 0) - fingerWidth)
        maxX = Math.max(maxX, finite(pose.centerX, 0) + 0.75)

        if (!isFinite(minX) || !isFinite(maxX)) {
            minX = -6.5
            maxX = 6.5
        } else {
            var desiredSpan = Math.max(12.0, (maxX - minX) + 1.4)
            var centerX = (minX + maxX) / 2
            minX = centerX - desiredSpan / 2
            maxX = centerX + desiredSpan / 2
        }

        if (!isFinite(minR) || !isFinite(maxR)) {
            minR = -3.2
            maxR = 5.2
        } else {
            var padding = Math.max(0.35, (maxR - minR) * 0.08)
            minR -= padding
            maxR += padding
        }

        if (staticScene && staticScene.stack)
            minR = Math.min(minR, finite(staticScene.stack.tableTopR, 0) - 0.20)
        if (data && data.punch && data.punchProfile && data.punch.bounds && data.punchProfile.tipLocalY !== undefined)
            maxR = Math.max(maxR, 2.15 + (data.punch.bounds.maxY - data.punchProfile.tipLocalY) + 0.25)

        if (runFrameTimingActive) {
            var boundsEndedNs = runFrameTiming.timingTimestampNanoseconds()
            runFrameTiming.recordStageNanoseconds(
                "v5-bounds-finalize",
                boundsEndedNs - boundsFinalizeStartedNs)
        }
        return { minX: minX, maxX: maxX, minR: minR, maxR: maxR }
    }

    function liveOffsetPolyline(points, offset) {
        var source = points || []
        if (source.length < 2)
            return source.slice(0)
        var result = []
        for (var i = 0; i < source.length; i++) {
            var prev = source[Math.max(0, i - 1)]
            var next = source[Math.min(source.length - 1, i + 1)]
            var dx = next.x - prev.x
            var dr = next.r - prev.r
            var len = Math.sqrt(dx * dx + dr * dr)
            if (len < 1e-9) {
                if (i > 0) {
                    dx = source[i].x - source[i - 1].x
                    dr = source[i].r - source[i - 1].r
                } else {
                    dx = source[1].x - source[0].x
                    dr = source[1].r - source[0].r
                }
                len = Math.sqrt(dx * dx + dr * dr)
            }
            if (len < 1e-9) {
                result.push({ x: source[i].x, r: source[i].r })
                continue
            }
            var nx = -dr / len
            var nr = dx / len
            result.push({ x: source[i].x + nx * offset, r: source[i].r + nr * offset })
        }
        return result
    }

    function drawLiveCompletedFlangeSegment(ctx, segment, halfThickness, sx, sy) {
        if (!segment || !segment.start || !segment.end)
            return
        var center = [
            { x: segment.start.x, r: segment.start.r },
            { x: segment.end.x, r: segment.end.r }
        ]
        var upper = liveOffsetPolyline(center, halfThickness)
        var lower = liveOffsetPolyline(center, -halfThickness)
        var polygon = upper.slice(0)
        for (var i = lower.length - 1; i >= 0; i--)
            polygon.push(lower[i])

        drawLivePolygon(ctx, polygon, sx, sy, "#99e6b3", "#059669")
        ctx.strokeStyle = "#059669"
        ctx.lineWidth = 2.0
        drawLivePolyline(ctx, upper, sx, sy)
        drawLivePolyline(ctx, lower, sx, sy)
        if (upper.length > 1 && lower.length > 1) {
            ctx.beginPath()
            ctx.moveTo(sx(upper[1].x), sy(upper[1].r))
            ctx.lineTo(sx(lower[1].x), sy(lower[1].r))
            ctx.stroke()
        }
    }

    function drawLiveCompletedBadge(ctx, segment, sx, sy) {
        if (!segment || !segment.bend)
            return
        var labelPoint = segment.labelPoint ? segment.labelPoint : ({
            x: (segment.start.x + segment.end.x) / 2,
            r: (segment.start.r + segment.end.r) / 2
        })
        var text = segment.label && String(segment.label).length > 0 ? segment.label : ("B" + bendSequence(segment.bend, 0) + ":done")
        drawCenteredBadge(ctx, sx(labelPoint.x), sy(labelPoint.r), text, "#dcfce7", "#166534")
    }

    function displayedLiveAngleDeg(bend, pose) {
        var targetAngle = Math.max(0, bendAngleDeg(bend, 0))
        var targetRiseDeg = Math.max(8, Math.min(75, (180 - targetAngle) / 2))
        if (targetAngle <= 0.001 || targetRiseDeg <= 0.001)
            return 0
        return targetAngle * clampValue(pose.armRiseDeg / targetRiseDeg, 0, 1)
    }

    function drawCenteredDieAngleBadge(ctx, sx, sy, bend, pose, activeDieFace) {
        var angleText = String(Math.round(displayedLiveAngleDeg(bend, pose))) + "°"
        var point = activeDieFace && activeDieFace.badgePoint ? activeDieFace.badgePoint : ({ x: 0, r: -0.18 })
        drawCenteredBadge(ctx, sx(point.x), sy(point.r), angleText, "#ecfccb", "#166534")
    }

    function tableTonnagePoint(staticScene) {
        var tableModel = staticScene && staticScene.tableModel
            ? staticScene.tableModel : null
        var stack = staticScene && staticScene.stack
            ? staticScene.stack : ({ tableTopR: -0.45 })
        if (!tableModel || !tableModel.bounds)
            return { x: 0, r: finite(stack.tableTopR, -0.45) - 0.55 }
        var anchorLocalY = staticScene && isFinite(staticScene.tableAnchorY)
            ? staticScene.tableAnchorY
            : resolveSupportSurfaceY(tableModel, true, 0.60)
        var localBodyY = anchorLocalY
            + (tableModel.bounds.minY - anchorLocalY) * 0.58
        return {
            x: 0,
            r: finite(stack.tableTopR, -0.45) + localBodyY - anchorLocalY
        }
    }

    function drawTableTonnageBadge(ctx, sx, sy, text, staticScene) {
