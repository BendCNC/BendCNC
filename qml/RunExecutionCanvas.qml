            ? runFrameTiming.timingTimestampNanoseconds() : -1
        ctx.strokeText(displayText, x, y)
        var readoutStrokeEndedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
