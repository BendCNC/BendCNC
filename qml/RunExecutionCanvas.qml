        var worldMaxX = machineCenterX + halfWidth
        var worldMinY = 0
        var worldMaxY = Math.max(topMachineDepthIn, worldBounds.maxY + 0.7)
        var scale = Math.min((previewCanvas.width - marginX * 2) / Math.max(1e-6, worldMaxX - worldMinX),
                             (previewCanvas.height - marginY * 2) / Math.max(1e-6, worldMaxY - worldMinY))
        if (!isFinite(scale) || scale <= 0)
            return null
        var left = (previewCanvas.width - (worldMaxX - worldMinX) * scale) / 2 - worldMinX * scale
        var top = marginY - worldMinY * scale
        return {
            left: left,
            top: top,
            scale: scale,
            railY: top + 0.32 * scale,
            railH: Math.max(12, 0.42 * scale),
            current: current,
            phase: phase
        }
    }

    function focusPlacementPunchBadge(canvasX, canvasY) {
        var geometry = placementPunchRailGeometry(sceneData)
        if (!geometry)
            return false
        var segments = geometry.phase.installedSegments || []
        var phaseIndex = Math.max(0, Math.round(finite(geometry.current.phaseIndex, 0)))
        for (var exactIndex = 0; exactIndex < segments.length; exactIndex++) {
            var exactSegment = segments[exactIndex]
            var exactX = geometry.left + (topMachineWidthIn / 2 + exactSegment.startXIn) * geometry.scale
            var exactW = (exactSegment.endXIn - exactSegment.startXIn) * geometry.scale
            if (exactW <= 1)
                continue
            var badgeSize = Math.min(Math.max(14, geometry.railH - 4), Math.max(10, exactW - 4))
            var centerX = exactX + exactW / 2
            var centerY = geometry.railY + geometry.railH / 2
            var hitRadius = Math.max(badgeSize / 2, 28)
            var dx = canvasX - centerX
            var dy = canvasY - centerY
            if (dx * dx + dy * dy <= hitRadius * hitRadius
                    || (canvasX >= exactX - 8 && canvasX <= exactX + exactW + 8
                        && canvasY >= geometry.railY - Math.max(18, geometry.railH * 0.9)
                        && canvasY <= geometry.railY + geometry.railH
                            + Math.max(18, geometry.railH * 0.9))) {
                focusedPlacementPunchBadgeKey = placementPunchBadgeKey(phaseIndex, exactSegment)
                placementPunchBadgeFocusTimer.restart()
                previewCanvas.requestPaint()
                return true
            }
        }
        var nearest = null
        var nearestDistance = Number.POSITIVE_INFINITY
        var railHitTop = geometry.railY - Math.max(34, geometry.railH * 1.6)
        var railHitBottom = geometry.railY + geometry.railH + Math.max(34, geometry.railH * 1.6)
        if (canvasY < railHitTop || canvasY > railHitBottom)
            return false
        for (var index = 0; index < segments.length; index++) {
            var segment = segments[index]
            var segX = geometry.left + (topMachineWidthIn / 2 + segment.startXIn) * geometry.scale
            var segW = (segment.endXIn - segment.startXIn) * geometry.scale
            if (segW <= 1)
                continue
            var clampedX = clampValue(canvasX, segX, segX + segW)
            var distance = Math.hypot(canvasX - clampedX,
                                      canvasY - (geometry.railY + geometry.railH / 2))
            if (distance < nearestDistance) {
                nearestDistance = distance
                nearest = segment
            }
        }
        if (!nearest || nearestDistance > Math.max(90, previewCanvas.width * 0.12))
            return false
        focusedPlacementPunchBadgeKey = placementPunchBadgeKey(phaseIndex, nearest)
        placementPunchBadgeFocusTimer.restart()
        previewCanvas.requestPaint()
        return true
    }

    function focusAllPlacementPunchBadges() {
        var geometry = placementPunchRailGeometry(sceneData)
        if (!geometry || !geometry.phase.installedSegments
                || geometry.phase.installedSegments.length === 0)
            return false
        focusedPlacementPunchBadgeKey = "*"
        placementPunchBadgeFocusTimer.restart()
        previewCanvas.requestPaint()
        return true
    }
    function clearPlacementPunchBadgeFocus() {
        placementPunchBadgeFocusTimer.stop()
        focusedPlacementPunchBadgeKey = ""
        previewCanvas.requestPaint()
    }

    function placementPunchBadgeSize(segW, railH, focused) {
        return Math.min(Math.max(14, railH - 4), Math.max(10, segW - 4))
            * (focused ? 2 : 1)
    }

    function placementPunchBadgeFontSize(badgeSize, focused) {
        return Math.min(focused ? 26 : 11.5, badgeSize * 0.68)
    }

    function placementPunchBadgeEllipseRect(badgeX, badgeY, badgeSize) {
        return { x: badgeX, y: badgeY, width: badgeSize, height: badgeSize }
    }

    function drawPunchSegmentWidthBadge(ctx, segX, railY, segW, railH, widthIn, focused) {
        if (segW < 7)
            return
        var badgeSize = placementPunchBadgeSize(segW, railH, focused)
        var badgeX = segX + (segW - badgeSize) / 2
        var badgeY = railY + (railH - badgeSize) / 2
        ctx.save()
        if (focused) {
            var shadowRect = placementPunchBadgeEllipseRect(badgeX + 2.5, badgeY + 3, badgeSize)
            ctx.fillStyle = "rgba(15,23,42,0.18)"
            ctx.beginPath()
            ctx.ellipse(shadowRect.x, shadowRect.y, shadowRect.width, shadowRect.height)
            ctx.fill()
        }
        var badgeFontSize = placementPunchBadgeFontSize(badgeSize, focused)
        ctx.font = "bold " + badgeFontSize.toFixed(1) + "px \"" + placementBadgeFont.name + "\""
        // Pill sized to the text so multi-digit widths never look squashed.
        var label = trimRailNumber(widthIn)
        var pillW = Math.max(badgeSize, ctx.measureText(label).width + badgeFontSize * 0.9)
        var pillX = segX + (segW - pillW) / 2
        ctx.fillStyle = "rgba(255,255,255,0.97)"
        ctx.strokeStyle = focused ? "rgba(217,119,6,0.95)" : "rgba(15,23,42,0.55)"
        ctx.lineWidth = focused ? 2.2 : 1.0
        drawRoundRect(ctx, pillX, badgeY, pillW, badgeSize, badgeSize / 2, true, true)
        ctx.fillStyle = "#0f172a"
        ctx.textAlign = "center"
        ctx.textBaseline = "middle"
        ctx.fillText(trimRailNumber(widthIn), segX + segW / 2, railY + railH / 2 + 0.2)
        ctx.restore()
    }
    // R = finger stop-face bottom above the die top (R = 0 slides on the die).
    function backgaugeFingerContactR(pose) {
        return finite(pose ? pose.gaugeWorkR : 0, 0)
    }

    function trimRailNumber(value) {
        var rounded = Math.round(finite(value, 0) * 100) / 100
        return String(rounded).replace(/\.00$/, "").replace(/(\.\d)0$/, "$1")
    }

    function drawPlacementPunchCoverageRail(ctx, left, top, scale, data) {
        var frame = runRenderFrame && runRenderFrame.placement ? runRenderFrame.placement : null
        var plan = frame && frame.toolingPlan ? frame.toolingPlan : null
        var current = plan ? plan.current : null
        var phase = plan ? plan.phase : null
        if (!current || !phase)
            return
        var railX = left + 0.7 * scale
        var railY = top + 0.32 * scale
        var railW = (topMachineWidthIn - 1.4) * scale
        var railH = Math.max(12, 0.42 * scale)
        var visibleSpan = Math.max(topMachineWidthIn, Math.min(44, Math.max(Math.abs(current.requiredPunchSpan.startXIn), Math.abs(current.requiredPunchSpan.endXIn)) * 2))
        var bedMin = -visibleSpan / 2
        var bedMax = visibleSpan / 2
        ctx.fillStyle = "rgba(238,242,247,0.92)"
        ctx.strokeStyle = "rgba(148,163,184,0.85)"
        ctx.lineWidth = 1
        drawRoundRect(ctx, railX, railY, railW, railH, 8, true, true)
        ctx.fillStyle = "rgba(219,234,254,0.38)"
        drawRoundRect(ctx, left + ((topMachineWidthIn - topClearWidthIn) / 2) * scale, railY + 1, topClearWidthIn * scale, railH - 2, 7, true, false)
        for (var zoneIndex = 0; current.forbiddenZones && zoneIndex < current.forbiddenZones.length; zoneIndex++) {
            var zone = current.forbiddenZones[zoneIndex]
            var zoneStart = clampValue(zone.startXIn, bedMin, bedMax)
            var zoneEnd = clampValue(zone.endXIn, bedMin, bedMax)
            var zoneX = left + (topMachineWidthIn / 2 + zoneStart) * scale
            var zoneW = Math.max(0, (zoneEnd - zoneStart) * scale)
            if (zoneW <= 0.5)
                continue
            ctx.fillStyle = "rgba(254,202,202,0.62)"
            drawRoundRect(ctx, zoneX, railY + 1, zoneW, railH - 2, 7, true, false)
            ctx.strokeStyle = "rgba(239,68,68,0.9)"
            ctx.lineWidth = 1.2
            ctx.beginPath(); ctx.moveTo(zoneX, railY - 2); ctx.lineTo(zoneX, railY + railH + 3); ctx.moveTo(zoneX + zoneW, railY - 2); ctx.lineTo(zoneX + zoneW, railY + railH + 3); ctx.stroke()
        }
        var safe = current.allowedPunchWindow
        if (safe) {
            var safeStart = clampValue(safe.startXIn, bedMin, bedMax)
            var safeEnd = clampValue(safe.endXIn, bedMin, bedMax)
            var safeX = left + (topMachineWidthIn / 2 + safeStart) * scale
            var safeW = Math.max(0, (safeEnd - safeStart) * scale)
            ctx.setLineDash([4, 3])
            ctx.strokeStyle = "rgba(22,163,74,0.52)"
            ctx.lineWidth = 0.9
            drawRoundRect(ctx, safeX, railY + 1, safeW, railH - 2, 7, false, true)
            ctx.setLineDash([])
        }
        for (var segmentIndex = 0; phase.installedSegments && segmentIndex < phase.installedSegments.length; segmentIndex++) {
            var segment = phase.installedSegments[segmentIndex]
            var segStart = clampValue(segment.startXIn, bedMin, bedMax)
            var segEnd = clampValue(segment.endXIn, bedMin, bedMax)
            var segX = left + (topMachineWidthIn / 2 + segStart) * scale
            var segW = (segEnd - segStart) * scale
            if (segW <= 1)
                continue
            // Each punch is a distinct block with a visible seam so the
            // individual segment limits read clearly (Java app parity).
            var blockX = segX + 0.75
            var blockW = Math.max(1, segW - 1.5)
            var blockGrad = ctx.createLinearGradient(0, railY + 2, 0, railY + railH - 2)
            blockGrad.addColorStop(0, "#475569")
            blockGrad.addColorStop(1, "#1e293b")
            ctx.fillStyle = blockGrad
            drawRoundRect(ctx, blockX, railY + 2, blockW, railH - 4, 2, true, false)
            ctx.strokeStyle = "rgba(2,6,23,0.85)"
            ctx.lineWidth = 0.9
            drawRoundRect(ctx, blockX, railY + 2, blockW, railH - 4, 2, false, true)
            ctx.strokeStyle = "rgba(255,255,255,0.22)"
            ctx.beginPath(); ctx.moveTo(blockX + 2, railY + 3.2); ctx.lineTo(blockX + blockW - 2, railY + 3.2); ctx.stroke()
            // Limit ticks above/below the rail at both segment ends.
            ctx.strokeStyle = "rgba(15,23,42,0.7)"
            ctx.lineWidth = 1
            ctx.beginPath()
            ctx.moveTo(segX, railY - 3); ctx.lineTo(segX, railY + 1)
            ctx.moveTo(segX + segW, railY - 3); ctx.lineTo(segX + segW, railY + 1)
            ctx.moveTo(segX, railY + railH - 1); ctx.lineTo(segX, railY + railH + 3)
            ctx.moveTo(segX + segW, railY + railH - 1); ctx.lineTo(segX + segW, railY + railH + 3)
            ctx.stroke()
        }
        drawPlacementPunchContactArea(ctx, left, top, scale, data, current, phase, bedMin, bedMax, railY + railH)
        var spanStart = clampValue(current.requiredPunchSpan.startXIn, bedMin, bedMax)
        var spanEnd = clampValue(current.requiredPunchSpan.endXIn, bedMin, bedMax)
        var spanX = left + (topMachineWidthIn / 2 + spanStart) * scale
        var spanW = Math.max(0, (spanEnd - spanStart) * scale)
        ctx.strokeStyle = "#f59e0b"
        ctx.lineWidth = 2.1
        drawRoundRect(ctx, spanX, railY - 1, spanW, railH + 2, 7, false, true)
        for (var badgeIndex = 0; phase.installedSegments && badgeIndex < phase.installedSegments.length; badgeIndex++) {
            var badgeSegment = phase.installedSegments[badgeIndex]
            var badgeStart = clampValue(badgeSegment.startXIn, bedMin, bedMax)
            var badgeEnd = clampValue(badgeSegment.endXIn, bedMin, bedMax)
            var badgeX = left + (topMachineWidthIn / 2 + badgeStart) * scale
            var badgeW = (badgeEnd - badgeStart) * scale
            if (badgeW <= 1)
                continue
            var badgeKey = placementPunchBadgeKey(current.phaseIndex, badgeSegment)
            drawPunchSegmentWidthBadge(ctx, badgeX, railY, badgeW, railH, badgeSegment.widthIn,
                badgeKey === focusedPlacementPunchBadgeKey
                    || focusedPlacementPunchBadgeKey === "*")
        }
    }

    // Projects the installed punch stack onto the sheet: dashed stack limits
    // down to the bend axis, a contact strip where punches touch the bend
    // line, and red strips where a punch extends past the required span
    // (possible collision with flanges/other features).
    function drawPlacementPunchContactArea(ctx, left, top, scale, data, current, phase, bedMin, bedMax, railBottom) {
        var segments = phase.installedSegments || []
        if (segments.length === 0 || !isFinite(finite(data.bendAxisDepth, NaN)))
            return
        var axisY = top + data.bendAxisDepth * scale
        if (axisY <= railBottom + 4)
            return
        var reqStart = current.requiredPunchSpan.startXIn
        var reqEnd = current.requiredPunchSpan.endXIn
        var stackStart = Number.POSITIVE_INFINITY, stackEnd = Number.NEGATIVE_INFINITY
        var toX = function(xIn) { return left + (topMachineWidthIn / 2 + clampValue(xIn, bedMin, bedMax)) * scale }
        var stripH = Math.max(6, 0.16 * scale)
        ctx.save()
        for (var i = 0; i < segments.length; i++) {
            var s = segments[i]
            stackStart = Math.min(stackStart, s.startXIn)
            stackEnd = Math.max(stackEnd, s.endXIn)
            var cStart = Math.max(s.startXIn, reqStart), cEnd = Math.min(s.endXIn, reqEnd)
            if (cEnd > cStart) {
                ctx.fillStyle = "rgba(245,158,11,0.38)"
                ctx.fillRect(toX(cStart) + 0.5, axisY - stripH / 2, toX(cEnd) - toX(cStart) - 1, stripH)
            }
            var outside = [[s.startXIn, Math.min(s.endXIn, reqStart)], [Math.max(s.startXIn, reqEnd), s.endXIn]]
            for (var o = 0; o < outside.length; o++) {
                if (outside[o][1] - outside[o][0] <= 1e-3)
                    continue
                ctx.fillStyle = "rgba(239,68,68,0.32)"
                ctx.fillRect(toX(outside[o][0]), axisY - stripH / 2, toX(outside[o][1]) - toX(outside[o][0]), stripH)
            }
            // Seam ticks on the contact strip mark each punch boundary.
            ctx.strokeStyle = "rgba(120,53,15,0.75)"
            ctx.lineWidth = 1
            ctx.beginPath()
            ctx.moveTo(toX(s.startXIn), axisY - stripH / 2 - 2); ctx.lineTo(toX(s.startXIn), axisY + stripH / 2 + 2)
            ctx.moveTo(toX(s.endXIn), axisY - stripH / 2 - 2); ctx.lineTo(toX(s.endXIn), axisY + stripH / 2 + 2)
            ctx.stroke()
        }
        ctx.setLineDash([5, 4])
        ctx.lineWidth = 1.1
        var limits = [stackStart, stackEnd]
        for (var l = 0; l < limits.length; l++) {
            var beyond = l === 0 ? limits[l] < reqStart - 1e-3 : limits[l] > reqEnd + 1e-3
            ctx.strokeStyle = beyond ? "rgba(220,38,38,0.85)" : "rgba(217,119,6,0.8)"
            ctx.beginPath(); ctx.moveTo(toX(limits[l]), railBottom + 3); ctx.lineTo(toX(limits[l]), axisY + stripH); ctx.stroke()
        }
        ctx.setLineDash([])
        ctx.restore()
    }

    function drawPlacement(ctx, data) {
        var bend = data.currentBend
        var bendAxisDepth = data.bendAxisDepth
        var marginX = 16, marginY = 6
        var machineCenterX = topMachineWidthIn / 2
        var horizontalPadding = 0.55
        var worldBounds = data.worldBounds || ({ minX: 0, maxX: topMachineWidthIn, minY: 0, maxY: topMachineDepthIn })
        var halfWidth = Math.max(topMachineWidthIn / 2, Math.max(Math.abs(worldBounds.minX - machineCenterX), Math.abs(worldBounds.maxX - machineCenterX)) + horizontalPadding)
        var worldMinX = machineCenterX - halfWidth
        var worldMaxX = machineCenterX + halfWidth
        var worldMinY = 0
        var worldMaxY = Math.max(topMachineDepthIn, worldBounds.maxY + 0.7)
        var scale = Math.min((previewCanvas.width - marginX * 2) / Math.max(1e-6, worldMaxX - worldMinX), (previewCanvas.height - marginY * 2) / Math.max(1e-6, worldMaxY - worldMinY))
        if (!isFinite(scale) || scale <= 0)
            return
        var left = (previewCanvas.width - (worldMaxX - worldMinX) * scale) / 2 - worldMinX * scale
        var top = marginY - worldMinY * scale
        var sceneW = topMachineWidthIn * scale
        var sceneH = topMachineDepthIn * scale
        ctx.fillStyle = "#f8fafc"
        ctx.fillRect(0, 0, previewCanvas.width, previewCanvas.height)
        ctx.fillStyle = "#fff4e6"
        ctx.strokeStyle = "#5b6575"
        ctx.lineWidth = 1.3
        drawRoundRect(ctx, left, top, sceneW, sceneH, 16, true, true)
        var sideZoneW = ((topMachineWidthIn - topClearWidthIn) / 2) * scale
        var gaugeBandH = 1.15 * scale
        var frontBandH = 0.95 * scale
        ctx.fillStyle = "#fce7d6"
        ctx.fillRect(left, top, sideZoneW, sceneH)
        ctx.fillRect(left + sceneW - sideZoneW, top, sideZoneW, sceneH)
        ctx.fillStyle = "rgba(232,245,233,0.55)"
        ctx.fillRect(left + sideZoneW, top, topClearWidthIn * scale, sceneH)
        ctx.fillStyle = "rgba(216,222,233,0.42)"
        drawRoundRect(ctx, left + 1, top + 1, sceneW - 2, gaugeBandH, 16, true, false)
        ctx.fillStyle = "rgba(226,232,240,0.45)"
        drawRoundRect(ctx, left + 1, top + sceneH - frontBandH - 1, sceneW - 2, frontBandH, 16, true, false)
        ctx.strokeStyle = "#5b6575"
        ctx.lineWidth = 1.3
        drawRoundRect(ctx, left, top, sceneW, sceneH, 16, false, true)
        ctx.strokeStyle = "rgba(203,213,225,0.28)"
        for (var gx = 0; gx <= topMachineWidthIn; gx++) {
            ctx.lineWidth = gx % 2 === 0 ? 0.7 : 0.3
            ctx.beginPath(); ctx.moveTo(left + gx * scale, top); ctx.lineTo(left + gx * scale, top + sceneH); ctx.stroke()
        }
        for (var gy = 0; gy <= topMachineDepthIn; gy++) {
            ctx.lineWidth = gy % 2 === 0 ? 0.7 : 0.3
            ctx.beginPath(); ctx.moveTo(left, top + gy * scale); ctx.lineTo(left + sceneW, top + gy * scale); ctx.stroke()
        }
        ctx.setLineDash([6, 5])
        ctx.strokeStyle = "rgba(100,116,139,0.85)"
        ctx.lineWidth = 1.2
        ctx.beginPath(); ctx.moveTo(left + topMachineWidthIn * scale / 2, top); ctx.lineTo(left + topMachineWidthIn * scale / 2, top + sceneH); ctx.stroke()
        ctx.setLineDash([])
        ctx.fillStyle = "#475569"
        ctx.font = "bold 11px sans-serif"
        ctx.fillText("X0", left + topMachineWidthIn * scale / 2 + 6, top + 12)
        ctx.fillStyle = "#94a3b8"
        ctx.font = "11px sans-serif"
        for (var gridX = 0; gridX <= topMachineWidthIn; gridX += 4) {
            var signedX = gridX - topMachineWidthIn / 2
            if (Math.abs(signedX) < 0.01)
                continue
            ctx.fillText((signedX > 0 ? "+" : "") + Math.round(signedX), left + gridX * scale + 2, top + sceneH + 11)
        }
        for (var gridY = 0; gridY <= topMachineDepthIn; gridY += 2) {
            var relDepth = gridY - bendAxisDepth
            if (Math.abs(relDepth) < 0.5)
                continue
            ctx.fillText((relDepth > 0 ? "+" : "") + Math.round(relDepth), left - 18, top + gridY * scale + 4)
        }
        ctx.strokeStyle = "#f59e0b"
        ctx.lineWidth = 2.4
        ctx.beginPath(); ctx.moveTo(left, top + bendAxisDepth * scale); ctx.lineTo(left + sceneW, top + bendAxisDepth * scale); ctx.stroke()
        ctx.setLineDash([7, 6])
        ctx.strokeStyle = "#fb923c"
        ctx.lineWidth = 1.6
        ctx.beginPath(); ctx.moveTo(left + 1.1 * scale, top + data.referenceDepth * scale); ctx.lineTo(left + sceneW - 1.1 * scale, top + data.referenceDepth * scale); ctx.stroke()
        ctx.setLineDash([])
        drawPlacementTopFinger(ctx, left, top, scale, data.referenceDepth)
        var projectedLineMin = projectedLineCoord(resolveLineMin(data.bounds, bend), data.preview, data.bounds, bend)
        var projectedLineMax = projectedLineCoord(resolveLineMax(data.bounds, bend), data.preview, data.bounds, bend)
        var machineLineMin = mapWorldLineCoord(projectedLineMin, data.preview, data.bounds, bend)
        var machineLineMax = mapWorldLineCoord(projectedLineMax, data.preview, data.bounds, bend)
        var contourClipped = hasPlacementClipPath(data)
        var contourClipSaved = false
        if (contourClipped) {
            ctx.save()
            contourClipSaved = true
            ctx.beginPath()
            contourClipped = addPlacementClipPath(ctx, data, left, top, scale)
            if (contourClipped) {
                ctx.fillRule = Qt.OddEvenFill
                ctx.clip()
                ctx.fillRule = Qt.WindingFill
            } else {
                ctx.restore()
                contourClipSaved = false
            }
        }
        var surfaces = computePlacementSurfaces(data.projection)
        for (var surface = 0; surface < surfaces.length; surface++) {
            if (surfaces[surface].endDepth - surfaces[surface].startDepth < 0.01)
                continue
            drawPlacementSurfaceSegment(ctx, [
                { x: machineLineMin, y: surfaces[surface].startDepth },
                { x: machineLineMax, y: surfaces[surface].startDepth },
                { x: machineLineMax, y: surfaces[surface].endDepth },
                { x: machineLineMin, y: surfaces[surface].endDepth }
            ], left, top, scale, surfaces[surface].level, !contourClipped)
        }
        var foldEdges = computePlacementFoldEdges(data.projection)
        for (var edgeIndex = 0; edgeIndex < foldEdges.length; edgeIndex++)
            drawPlacementFoldEdge(ctx, left, top, scale, machineLineMin, machineLineMax, foldEdges[edgeIndex])
        if (contourClipSaved) {
            ctx.restore()
            contourClipSaved = false
        }
        for (var holeIndex = 0; holeIndex < data.projectedLoops.length; holeIndex++) {
            if (data.projectedLoops[holeIndex].outer !== false)
                continue
            var holePath = data.projectedLoops[holeIndex].points
            if (!isDrawablePlacementHoleLoop(holePath))
                continue
            ctx.save()
            ctx.beginPath()
            addPlacementLoopPath(ctx, holePath, left, top, scale)
            ctx.fillStyle = "rgba(248,250,252,0.98)"
            ctx.fill()
            ctx.restore()
        }
        for (var li = 0; li < data.projectedLoops.length; li++) {
            if (data.projectedLoops[li].outer === false && !isDrawablePlacementHoleLoop(data.projectedLoops[li].points))
                continue
            var path = placementStrokePoints(data.projectedLoops[li])
            if (path.length < 2)
                continue
            ctx.beginPath()
            if (flatPatternContourRenderer === "canonical")
                addPlacementCanonicalStrokePath(ctx, data.projectedLoops[li], left, top, scale, data.projectedBends)
            else if (flatPatternContourRenderer === "overlay") {
                addPlacementStrokePath(ctx, path, left, top, scale, placementShouldSplitLongStrokeEdges(data.projectedLoops[li]), data.projectedBends)
                ctx.strokeStyle = data.projectedLoops[li].outer ? "rgba(29,79,112,0.55)" : "rgba(100,116,139,0.45)"
                ctx.lineWidth = data.projectedLoops[li].outer ? 2.2 : 1.0
                ctx.stroke()
                ctx.beginPath()
                addPlacementCanonicalStrokePath(ctx, data.projectedLoops[li], left, top, scale, data.projectedBends)
                ctx.setLineDash(data.projectedLoops[li].outer ? [7, 4] : [3, 3])
            }
            else
                addPlacementStrokePath(ctx, path, left, top, scale, placementShouldSplitLongStrokeEdges(data.projectedLoops[li]), data.projectedBends)
            ctx.strokeStyle = flatPatternContourRenderer === "overlay" ? (data.projectedLoops[li].outer ? "#f97316" : "#94a3b8") : (data.projectedLoops[li].outer ? "#1d4f70" : "#64748b")
            ctx.lineWidth = data.projectedLoops[li].outer ? (flatPatternContourRenderer === "overlay" ? 1.4 : 1.8) : 1.0
            if (flatPatternContourRenderer !== "canonical" && data.projectedLoops[li].outer === false) {
                ctx.fillStyle = "rgba(248,250,252,0.98)"
                ctx.fill()
            }
            ctx.stroke()
            ctx.setLineDash([])
