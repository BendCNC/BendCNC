        var toolingKeyEndedNs = runFrameTimingActive
            ? runFrameTiming.timingTimestampNanoseconds() : -1
        if (runFrameTimingActive)
            runFrameTiming.recordStageNanoseconds(
                "v5-tooling-key", toolingKeyEndedNs - toolingKeyStartedNs)
        var cached = liveToolingBoundsCache
        if (!cached || liveToolingBoundsCacheKey !== cacheKey) {
            if (runFrameTimingActive)
                runFrameTiming.recordCount("v5-tooling-bounds-miss")
