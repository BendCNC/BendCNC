            var line = bendLines[i]
            if (line && line.start && line.end && placementSegmentsIntersect(a, b, line.start, line.end))
                return line
        }
        return null
    }

    function collectPlacementLineCrossings(points, lineStart, lineEnd, direction) {
        var crossings = []
        if (!points || points.length < 3 || !lineStart || !lineEnd || !direction)
            return crossings
        for (var i = 0; i < points.length; i++) {
            var a = points[i]
            var b = points[(i + 1) % points.length]
            if (!a || !b || !placementSegmentsIntersect(lineStart, lineEnd, a, b))
                continue
            var crossing = placementSegmentIntersectionPoint(lineStart, lineEnd, a, b)
            var along = placementScalarProjection(lineStart, direction, crossing)
            if (crossing && isFinite(along))
                crossings.push({ segmentIndex: i, point: crossing, along: along })
        }
        crossings.sort(function(a, b) { return a.segmentIndex - b.segmentIndex })
        return crossings
    }

    function placementSegmentIntersectionPoint(a1, a2, b1, b2) {
        if (!a1 || !a2 || !b1 || !b2)
            return null
        var r = { x: a2.x - a1.x, y: a2.y - a1.y }
        var s = { x: b2.x - b1.x, y: b2.y - b1.y }
        var denom = placementCross(r, s)
        if (Math.abs(denom) <= 0.000001) {
            if (placementDistance(a1, b1) <= placementDistance(a1, b2))
                return { x: b1.x, y: b1.y }
            return { x: b2.x, y: b2.y }
        }
        var qmp = { x: b1.x - a1.x, y: b1.y - a1.y }
        var t = placementCross(qmp, s) / denom
        return { x: a1.x + t * r.x, y: a1.y + t * r.y }
    }

    function closestPlacementReferenceIndex(reference, target) {
        var bestIndex = -1
        var bestDistance = Infinity
        for (var i = 0; reference && i < reference.length; i++) {
            var d = placementDistance(reference[i], target)
            if (isFinite(d) && d < bestDistance) {
                bestDistance = d
                bestIndex = i
            }
        }
        return { index: bestIndex, distance: bestDistance }
    }

    function placementReferenceIndicesNear(reference, target, radius) {
        // Every reference index within radius of target, sorted nearest first. A spike vertex often
        // has a near-duplicate twin that begins the dense contour run, so the bridge must consider
        // each twin as a possible anchor rather than only the single closest vertex.
        var hits = []
        for (var i = 0; reference && i < reference.length; i++) {
            var d = placementDistance(reference[i], target)
            if (isFinite(d) && d <= radius)
                hits.push({ index: i, distance: d })
        }
        hits.sort(function(a, b) { return a.distance - b.distance })
        return hits
    }

    function placementReferenceArcBetween(reference, startIndex, endIndex, forward) {
        if (!reference || startIndex < 0 || endIndex < 0 || startIndex === endIndex)
            return null
        var arc = []
        var i = startIndex
        while (true) {
            arc.push(reference[i])
            if (i === endIndex)
                break
            i = forward ? (i + 1) % reference.length : (i - 1 + reference.length) % reference.length
            if (arc.length > reference.length)
                return null
        }
        return arc.length >= 2 ? arc : null
    }

    function placementPolylineLength(points) {
        var total = 0
        for (var i = 0; points && i + 1 < points.length; i++) {
            var d = placementDistance(points[i], points[i + 1])
            if (isFinite(d))
                total += d
        }
        return total
    }

    function placementMaxPerpendicularDeviation(arc, a, b) {
        // Maximum perpendicular distance of arc vertices from the straight chord a->b. A bridge chord
        // that simply under-sampled a dense run has near-collinear samples (small deviation); a chord
        // that cut across a real concavity would have large deviation, which must NOT be bridged.
        var dx = b.x - a.x
        var dy = b.y - a.y
        var len = Math.hypot(dx, dy)
        if (!isFinite(len) || len <= 0.000001)
            return Infinity
        var ux = dx / len
        var uy = dy / len
        var maxDev = 0
        for (var i = 0; arc && i < arc.length; i++) {
            var p = arc[i]
            var dev = Math.abs((p.x - a.x) * (-uy) + (p.y - a.y) * ux)
            if (dev > maxDev)
                maxDev = dev
        }
        return maxDev
    }

    function bridgePlacementBendLineConnectorChords(points, reference, bendLines) {
        // General, non-hardcoded repair: a bridge chord is a long straight render edge that the dense
        // flat-pattern reference actually samples as many small near-collinear steps. The projection
        // sometimes drops those intermediate samples (or anchors them on a near-duplicate twin vertex),
        // leaving a single long straight edge that visibly deforms the contour. Replace such a chord
        // with the dense reference sub-path between near-duplicate anchors of its endpoints. The arc is
        // only accepted when it hugs the chord direction (small perpendicular deviation) and is clearly
        // denser, so genuine straight edges are never altered. Purely geometric, program-agnostic.
        if (!points || points.length < 6 || !reference || reference.length < 6)
            return points
        var threshold = Math.max(0.35, Math.min(1.25, placementLongStrokeEdgeThreshold(points)))
        // Reference vertices within this radius of a chord endpoint are treated as the same anchor.
        var anchorRadius = Math.max(0.06, Math.min(0.18, threshold * 0.25))
        var best = points
        var changed = true
        var guard = 0
        while (changed && guard < 8) {
            changed = false
            guard++
            for (var i = 0; i < best.length; i++) {
                var a = best[i]
                var b = best[(i + 1) % best.length]
                if (!a || !b)
                    continue
                var length = placementDistance(a, b)
                if (!isFinite(length) || length <= threshold)
                    continue
                var startHits = placementReferenceIndicesNear(reference, a, anchorRadius)
                var endHits = placementReferenceIndicesNear(reference, b, anchorRadius)
                if (startHits.length === 0 || endHits.length === 0)
                    continue
                var bestArc = null
                // Allowed perpendicular wander of the dense run from the chord line. The dense run is a
                // sampled version of the same straight span, so it must stay close to the chord line.
                var maxDeviation = Math.max(0.06, Math.min(0.18, length * 0.12))
                function arcQualifies(arc) {
                    if (!arc || arc.length < 5)
                        return false
                    var arcLen = placementPolylineLength(arc)
                    // Collinear dense sampling: total length close to the chord (not a real detour),
                    // many intermediate vertices, and low perpendicular deviation from the chord line.
                    if (arcLen < length * 0.8 || arcLen > length * 1.35)
                        return false
                    return placementMaxPerpendicularDeviation(arc, a, b) <= maxDeviation
                }
                for (var si = 0; si < startHits.length && !bestArc; si++) {
                    for (var ei = 0; ei < endHits.length && !bestArc; ei++) {
                        var sIdx = startHits[si].index
                        var eIdx = endHits[ei].index
                        if (sIdx === eIdx)
                            continue
                        var fwd = placementReferenceArcBetween(reference, sIdx, eIdx, true)
                        var bwd = placementReferenceArcBetween(reference, sIdx, eIdx, false)
                        var fOk = arcQualifies(fwd)
                        var bOk = arcQualifies(bwd)
                        if (fOk && (!bOk || fwd.length <= bwd.length))
                            bestArc = fwd
                        else if (bOk)
                            bestArc = bwd
                    }
                }
                if (!bestArc)
                    continue
                var candidate = []
                for (var k = 0; k <= i; k++)
                    candidate.push(best[k])
                for (var m = 1; m < bestArc.length - 1; m++)
                    candidate.push(bestArc[m])
                for (var n = (i + 1) % best.length; ; n = (n + 1) % best.length) {
                    if (n === 0)
                        break
                    candidate.push(best[n])
                    if (n === best.length - 1)
                        break
                }
                candidate = dedupePlacementLoop(candidate)
                if (candidate.length < 3
                        || placementLoopSelfIntersects(candidate)
                        || !placementBoundsNearlyMatch(candidate, best, 0.12)
                        || !placementLoopAreaRatioInRange(candidate, best, 0.96, 1.04))
                    continue
                best = candidate
                changed = true
                break
            }
        }
        return best
    }

    function collapsePlacementRedundantChordArc(points) {
        // General, non-hardcoded repair: when the loop revisits the SAME vertex (a near-duplicate pair
        // i,j that is not simply adjacent), the span between them is a self-touching excursion. If that
        // enclosed sub-loop carries negligible area relative to the whole contour it is a degenerate
        // spur the projection produced (e.g. a near-zero-width flange seen edge-on, or a connector
        // out-and-back) and must be spliced out so the visible outline matches the flat pattern. The
        // smaller enclosed span is removed and the result re-validated. Purely geometric; no hardcoding.
        if (!points || points.length < 8)
            return points
        var threshold = Math.max(0.35, Math.min(1.25, placementLongStrokeEdgeThreshold(points)))
        var clusterTol = Math.max(0.04, Math.min(0.12, threshold * 0.16))
        var totalArea = Math.abs(polygonArea(points))
        if (!isFinite(totalArea) || totalArea <= 0.0001)
            return points
        var best = points
        var changed = true
        var guard = 0
        while (changed && guard < 16) {
            changed = false
            guard++
            for (var i = 0; i < best.length && !changed; i++) {
                var maxSpan = Math.min(best.length - 2, 128)
                for (var step = 2; step <= maxSpan && !changed; step++) {
                    var j = (i + step) % best.length
                    // Skip the trivially-adjacent wrap pair.
                    if (j === i || (i === 0 && j === best.length - 1) || (j === 0 && i === best.length - 1))
                        continue
                    if (placementDistance(best[i], best[j]) > clusterTol)
                        continue
                    // Enclosed sub-loop (the smaller span) must be near-degenerate in area.
                    var sub = []
                    for (var t = i; ; t = (t + 1) % best.length) {
                        sub.push(best[t])
                        if (t === j)
                            break
                        if (sub.length > best.length)
                            break
                    }
                    if (sub.length < 3 || sub.length > best.length - 3)
                        continue
                    var subArea = Math.abs(polygonArea(sub))
                    if (!isFinite(subArea) || subArea > totalArea * 0.01)
                        continue
                    var candidate = placementSpliceLoopExcursion(best, i, j)
                    candidate = dedupePlacementLoop(candidate)
                    if (candidate.length < 3
                            || candidate.length >= best.length
                            || placementLoopSelfIntersects(candidate)
                            || !placementBoundsNearlyMatch(candidate, best, 0.12)
                            || !placementLoopAreaRatioInRange(candidate, best, 0.985, 1.015))
                        continue
                    best = candidate
                    changed = true
                }
            }
        }
        return best
    }

    function repairPlacementRenderLoopDuplicateBendEndpointCrossings(points, reference, bendLines) {
        if (!points || points.length < 6 || !reference || reference.length < 4 || !bendLines || bendLines.length === 0)
            return { points: points, repair: "" }
        var best = points
        var repair = ""
        for (var lineIndex = 0; lineIndex < bendLines.length; lineIndex++) {
            var line = bendLines[lineIndex]
            if (!line || !line.start || !line.end)
                continue
            var candidate = repairDuplicateEndpointCrossingsForLine(best, reference, line)
            candidate = repairEndpointSpursForLine(candidate, reference, line)
            candidate = repairLongNearParallelBendLineChords(candidate, reference, [line])
            candidate = repairDuplicateEndpointCrossingsForLine(candidate, reference, line)
            if (candidate !== best && candidate && candidate.length >= 3) {
                best = candidate
                repair = appendPlacementRenderRepair(repair, "render-bend-endpoint-crossing")
            }
        }
        var bridged = bridgePlacementBendLineConnectorChords(best, reference, bendLines)
        if (bridged !== best && bridged && bridged.length >= 3) {
            best = bridged
            repair = appendPlacementRenderRepair(repair, "render-bend-chord-bridge")
        }
        var collapsed = collapsePlacementRedundantChordArc(best)
        if (collapsed !== best && collapsed && collapsed.length >= 3) {
            best = collapsed
            repair = appendPlacementRenderRepair(repair, "render-redundant-chord-collapse")
        }
        return { points: best, repair: repair }
    }

    function repairEndpointSpursForLine(points, reference, line) {
        if (!points || points.length < 6 || !reference || !line || !line.start || !line.end)
            return points
        var direction = placementNormalizeVector(line.start, line.end)
        if (!direction)
            return points
        var normal = { x: -direction.y, y: direction.x }
        var lineLength = placementDistance(line.start, line.end)
        if (!isFinite(lineLength) || lineLength < 1.0)
            return points
        var endpointTolerance = Math.max(0.10, Math.min(0.45, lineLength * 0.025))
        var outwardThreshold = Math.max(0.45, Math.min(1.35, lineLength * 0.035))
        var best = points
        for (var endpointIndex = 0; endpointIndex < 2; endpointIndex++) {
            var endpointAlong = endpointIndex === 0 ? 0 : lineLength
            var crossings = collectPlacementLineCrossings(best, line.start, line.end, direction)
            for (var c = 0; c < crossings.length; c++) {
                var crossing = crossings[c]
                if (Math.abs(crossing.along - endpointAlong) > endpointTolerance)
                    continue
                var candidate = removeEndpointSpurAtCrossing(best, crossing, line.start, direction, normal, lineLength, outwardThreshold)
                if (candidate === best || !candidate || candidate.length < 3)
                    continue
                if (placementLoopSelfIntersects(candidate)
                        || !placementBoundsNearlyMatch(candidate, best, 0.12)
                        || !placementLoopAreaRatioInRange(candidate, best, 0.985, 1.015)
                        || !isValidPlacementRenderLoop(candidate, reference))
                    continue
                best = candidate
            }
        }
        return best
    }

    function removeEndpointSpurAtCrossing(points, crossing, lineStart, direction, normal, lineLength, outwardThreshold) {
        var segmentIndex = crossing ? crossing.segmentIndex : -1
        if (!points || !crossing || !lineStart || !direction || !normal || segmentIndex < 0 || segmentIndex >= points.length)
            return points
        var a = points[segmentIndex]
        var b = points[(segmentIndex + 1) % points.length]
        if (!a || !b)
            return points
        var aOffset = placementScalarProjection(crossing.point, normal, a)
        var bOffset = placementScalarProjection(crossing.point, normal, b)
        if (!isFinite(aOffset) || !isFinite(bOffset))
            return points
        var aOutward = Math.abs(aOffset) >= outwardThreshold
        var bOutward = Math.abs(bOffset) >= outwardThreshold
        var nearTolerance = Math.max(0.16, outwardThreshold * 0.35)
        var aNearCrossing = placementDistance(a, crossing.point) <= nearTolerance
        var bNearCrossing = placementDistance(b, crossing.point) <= nearTolerance
        if (aOutward === bOutward || aNearCrossing === bNearCrossing)
            return points
        var removeBackward = aOutward && bNearCrossing
        var removeIndex = removeBackward ? segmentIndex : ((segmentIndex + 1) % points.length)
        var crossingAlong = placementScalarProjection(lineStart, direction, crossing.point)
        var endpointAlong = crossingAlong <= lineLength / 2 ? 0 : lineLength
        var endpointRunTolerance = Math.max(0.45, Math.min(2.75, lineLength * 0.10))
        var removeStart = removeIndex
        var removeEnd = removeIndex
        while (removeStart > 0 && isEndpointSpurPoint(points[removeStart - 1], crossing.point, lineStart, direction, normal, endpointAlong, endpointRunTolerance, outwardThreshold))
            removeStart--
        while (removeEnd + 1 < points.length && isEndpointSpurPoint(points[removeEnd + 1], crossing.point, lineStart, direction, normal, endpointAlong, endpointRunTolerance, outwardThreshold))
            removeEnd++
        var candidate = []
        for (var i = 0; i < removeStart; i++)
            candidate.push(points[i])
        if (removeBackward) {
            var previous = removeStart > 0 ? points[removeStart - 1] : null
            var backwardCorner = endpointCornerPoint(previous, lineStart, direction, normal, endpointAlong)
            if (backwardCorner)
                candidate.push(backwardCorner)
        }
        candidate.push(crossing.point)
        if (!removeBackward) {
            var next = removeEnd + 1 < points.length ? points[removeEnd + 1] : null
            var forwardCorner = endpointCornerPoint(next, lineStart, direction, normal, endpointAlong)
            if (forwardCorner)
                candidate.push(forwardCorner)
        }
        for (var j = removeEnd + 1; j < points.length; j++)
            candidate.push(points[j])
        candidate = dedupePlacementLoop(candidate)
        return candidate.length >= 3 && candidate.length < points.length ? candidate : points
    }

    function endpointCornerPoint(retained, lineStart, direction, normal, endpointAlong) {
        if (!retained || !lineStart || !direction || !normal)
            return null
        var endpoint = {
            x: lineStart.x + direction.x * endpointAlong,
            y: lineStart.y + direction.y * endpointAlong
        }
        var offset = placementScalarProjection(endpoint, normal, retained)
        if (!isFinite(offset))
            return null
        return {
            x: endpoint.x + normal.x * offset,
            y: endpoint.y + normal.y * offset
        }
    }

    function isEndpointSpurPoint(point, crossing, lineStart, direction, normal, endpointAlong, endpointRunTolerance, outwardThreshold) {
        if (!point || !crossing || !lineStart || !direction || !normal)
            return false
        var along = placementScalarProjection(lineStart, direction, point)
        var offset = Math.abs(placementScalarProjection(crossing, normal, point))
        return isFinite(along)
                && isFinite(offset)
                && Math.abs(along - endpointAlong) <= endpointRunTolerance
                && offset >= outwardThreshold
    }

    function repairDuplicateEndpointCrossingsForLine(points, reference, line) {
        if (!points || points.length < 6 || !reference || !line || !line.start || !line.end)
            return points
        var lineLength = placementDistance(line.start, line.end)
        if (!isFinite(lineLength) || lineLength < 1.0)
            return points
        var direction = placementNormalizeVector(line.start, line.end)
        if (!direction)
            return points
        var crossings = collectPlacementLineCrossings(points, line.start, line.end, direction)
        if (crossings.length <= 2)
            return points
        var endpointTolerance = Math.max(0.12, Math.min(0.55, lineLength * 0.03))
        var clusterTolerance = Math.max(0.04, Math.min(0.14, lineLength * 0.006))
        var best = points
        var bestCrossings = crossings.length
        for (var endpointIndex = 0; endpointIndex < 2; endpointIndex++) {
            var endpointAlong = endpointIndex === 0 ? 0 : lineLength
            var cluster = []
            for (var c = 0; c < crossings.length; c++) {
                if (Math.abs(crossings[c].along - endpointAlong) <= endpointTolerance)
                    cluster.push(crossings[c])
            }
            if (cluster.length < 2)
                continue
            for (var left = 0; left < cluster.length - 1; left++) {
                for (var right = left + 1; right < cluster.length; right++) {
                    var first = cluster[left]
                    var last = cluster[right]
                    if (last.segmentIndex <= first.segmentIndex + 1 || Math.abs(first.along - last.along) > clusterTolerance)
                        continue
                    var candidate = removePlacementEndpointCrossingExcursion(best, first, last)
                    if (candidate === best || !candidate || candidate.length < 3)
                        continue
                    var candidateCrossings = collectPlacementLineCrossings(candidate, line.start, line.end, direction).length
                    // Pure predicates: cheap O(n) rejections run before the
                    // self-intersection scans; the accepted set is unchanged.
                    if (candidateCrossings >= bestCrossings
                            || !preservesDensePlacementRenderDetail(candidate, reference)
                            || !placementBoundsNearlyMatch(candidate, best, 0.12)
                            || !placementLoopAreaRatioInRange(candidate, best, 0.985, 1.015)
                            || placementLoopSelfIntersects(candidate)
                            || !isValidPlacementRenderLoop(candidate, reference))
                        continue
                    best = candidate
                    bestCrossings = candidateCrossings
                }
            }
        }
        return best
    }

    function removePlacementEndpointCrossingExcursion(points, first, last) {
        if (!points || !first || !last || first.segmentIndex < 0 || last.segmentIndex >= points.length || last.segmentIndex <= first.segmentIndex + 1)
            return points
        var crossing = { x: (first.point.x + last.point.x) / 2, y: (first.point.y + last.point.y) / 2 }
        var candidate = []
        for (var i = 0; i <= first.segmentIndex; i++)
            candidate.push(points[i])
        candidate.push(crossing)
        for (var j = last.segmentIndex + 1; j < points.length; j++)
            candidate.push(points[j])
        candidate = dedupePlacementLoop(candidate)
        return candidate.length === points.length ? points : candidate
    }

    function appendPlacementRenderRepair(repair, suffix) {
        if (!suffix || suffix.length === 0)
            return repair || ""
        var base = repair && repair.length > 0 ? repair : "none"
        if (base.indexOf(suffix) >= 0)
            return base
        return base === "none" ? suffix : base + "+" + suffix
    }

    function appendPlacementStrokeDiagnostics(lines, currentBendNumber, loop, bendLines) {
        var points = placementStrokePoints(loop)
        if (!points || points.length < 2)
            return
        var threshold = placementLongStrokeEdgeThreshold(points)
        for (var i = 0; i < points.length; i++) {
            var a = points[i]
            var b = points[(i + 1) % points.length]
            var length = placementDistance(a, b)
            var bendLine = placementSegmentIntersectsAnyBendLine(a, b, bendLines)
            if (length <= threshold && !placementIsFalseBendChord(a, b, bendLines) && !bendLine)
                continue
                var strokeKey = " current=B" + currentBendNumber + " idx=" + loop.sourceIndex + " edge=" + i + "/" + points.length
                lines.push("QML-PLACEMENT-STROKE" + strokeKey + " outer=" + loop.outer)
                lines.push("QML-PLACEMENT-STROKE-LEN" + strokeKey + " len=" + fmt(length) + " th=" + fmt(threshold))
                lines.push("QML-PLACEMENT-STROKE-FLAGS" + strokeKey + " falseBend=" + placementIsFalseBendChord(a, b, bendLines) + " hitBend=" + (bendLine !== null))
                lines.push("QML-PLACEMENT-STROKE-BEND" + strokeKey + " " + placementLineText(bendLine))
                lines.push("QML-PLACEMENT-STROKE-A" + strokeKey + " [" + fmt(a.x) + "," + fmt(a.y) + "]")
                lines.push("QML-PLACEMENT-STROKE-B" + strokeKey + " [" + fmt(b.x) + "," + fmt(b.y) + "]")
        }
    }

    function placementDebugSignature(data) {
        if (!data)
            return ""
        var bendNumber = data.currentBend && data.currentBend.number !== undefined ? data.currentBend.number : currentSelectedBendIndex() + 1
        var outerIndex = -1
        var projectedCount = 0
        var renderCount = 0
        var renderRepair = "none"
        var boundsText = ""
        for (var i = 0; data.projectedLoops && i < data.projectedLoops.length; i++) {
            var loop = data.projectedLoops[i]
            if (!loop || loop.outer !== true)
                continue
            outerIndex = loop.sourceIndex
            projectedCount = loop.points ? loop.points.length : 0
            renderCount = loop.renderPoints ? loop.renderPoints.length : 0
            renderRepair = loop.renderRepair || "none"
            boundsText = placementBoundsText(loop.renderPoints || loop.points || [])
            break
        }
        return String(sceneMode) + "|B" + bendNumber
                + "|loops=" + (data.projectedLoops ? data.projectedLoops.length : 0)
                + "|outer=" + outerIndex
                + "|proj=" + projectedCount
                + "|render=" + renderCount
                + "|repair=" + renderRepair
                + "|bounds=" + boundsText
    }

    function emitPlacementDebugLog(data, force) {
        if (!data || !data.ready || !runDebugLoggingActive || (!runSequenceDebugCaptureEnabled && !force))
            return
        var currentSeqForSweep = bendSequence(data.currentBend, currentSelectedBendIndex() + 1)
        if (!force && runAutoSweepEnabled && !autoSweepCompleted)
            return
        if (!force && autoSweepCompleted && autoSweepLoggedBends[String(currentSeqForSweep)] === true)
            return
        pendingPlacementDebugData = null
        var signature = placementDebugSignature(data)
        if (!force && signature === lastPlacementDebugSignature)
            return
        lastPlacementDebugSignature = signature
        var currentBendNumber = data.currentBend && data.currentBend.number !== undefined ? data.currentBend.number : currentSelectedBendIndex() + 1
        var lines = []
        var outerIndices = []
        for (var oi = 0; oi < data.projectedLoops.length; oi++) {
            if (data.projectedLoops[oi].outer === true)
                outerIndices.push(data.projectedLoops[oi].sourceIndex)
        }
        lines.push("PLACEMENT-FRAME frame=" + finite(data.debugFrameId, 0) + " current=B" + currentBendNumber + " loops=" + data.projectedLoops.length + " bendLines=" + data.projectedBends.length + " outerIndices=[" + outerIndices.join(",") + "]")
        appendPlacementSummaryDiagnostics(lines, data, currentBendNumber)
        for (var i = 0; i < data.projectedLoops.length; i++) {
            var loop = data.projectedLoops[i]
            lines.push(placementLoopSummaryLine(loop, currentBendNumber))
        }
        writeRunDebugLog(lines)
    }

    function liveDebugSignature(data, frame) {
        if (!data || !frame || !frame.ready)
            return ""
        var artifacts = frame.frameArtifacts || ({})
        var renderedRoots = []
