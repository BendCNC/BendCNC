        var bodyWidth = Math.abs(sx(bodyMaxWorldX) - sx(bodyMinWorldX))
        var bodyHeight = Math.abs(sy(bodyMaxWorldR) - sy(bodyMinWorldR))
        var fontSize = Math.max(8.5, Math.min(12.2,
            bodyWidth / Math.max(4.25, displayText.length * 0.515),
            Math.max(9.2, (bodyHeight - 6) * 0.64)))
        ctx.save()
        ctx.font = "800 " + fontSize.toFixed(1) + "px sans-serif"
        ctx.textAlign = "center"
        ctx.textBaseline = "middle"
        ctx.strokeStyle = "rgba(15,23,42,0.90)"
        ctx.lineWidth = 1.15
        ctx.fillStyle = "rgba(248,250,252,0.98)"
