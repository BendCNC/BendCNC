        var runs = normalizedToolingSegmentRuns(segments)
        if (runs.length === 0)
            return drawLiveDxfModel(ctx, model, sx, sy, anchorLocalX, anchorLocalY,
                                    worldX, worldR, scaleFactor, strokeColor,
                                    fillColor, flipX, flipY, rotationCwDeg)
        var drawn = false
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        runs.sort(function(left, right) {
