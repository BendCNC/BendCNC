        anchors.fill: parent
        active: runCanvasRoot.nativeRenderRequested
        source: "NativeRunExecutionLayer.qml"
        visible: status === Loader.Ready && item
        z: 2

        onLoaded: {
            runCanvasRoot.nativeRenderUsable = true
            runCanvasRoot.rebuildNativeRenderCommands()
            if (runCanvasRoot.runPerfDebug)
                console.log("RUN-NATIVE ready", item.backendName)
        }
        Connections {
            target: nativeRendererLoader.item
            enabled: nativeRendererLoader.status === Loader.Ready
            function onPacketValidChanged() {
                if (nativeRendererLoader.item.packetValid) {
                    runCanvasRoot.nativeRenderUsable = true
                    runCanvasRoot.nativeRenderError = ""
                } else {
                    runCanvasRoot.nativeRenderUsable = false
                    runCanvasRoot.nativeRenderError = nativeRendererLoader.item.packetError
                    if (runCanvasRoot.runPerfDebug)
                        console.warn("RUN-NATIVE packet fallback", runCanvasRoot.nativeRenderError)
                    previewCanvas.requestPaint()
                }
            }
            function onPacketErrorChanged() {
                if (!nativeRendererLoader.item.packetValid) {
                    runCanvasRoot.nativeRenderError = nativeRendererLoader.item.packetError
                    if (runCanvasRoot.runPerfDebug)
                        console.warn("RUN-NATIVE packet error", runCanvasRoot.nativeRenderError)
                }
            }
            function onAcceptedRevisionChanged() {
                if (runCanvasRoot.runPerfDebug && nativeRendererLoader.item.packetValid)
                    console.log("RUN-NATIVE packet",
                                "revision=" + String(nativeRendererLoader.item.acceptedRevision),
                                "batches=" + String(nativeRendererLoader.item.batchCount),
                                "vertices=" + String(nativeRendererLoader.item.vertexCount),
                                "texts=" + String(nativeRendererLoader.item.textCommandCount),
                                "parseMs=" + String(nativeRendererLoader.item.parseMilliseconds),
                                "coalesced=" + String(nativeRendererLoader.item.coalescedFrameCount),
                                "cache=" + String(nativeRendererLoader.item.tessellationCacheHits)
                                    + "/" + String(nativeRendererLoader.item.tessellationCacheMisses),
                                "transforms=" + String(nativeRendererLoader.item.retainedTransformUpdates),
                                "qsg=" + String(nativeRendererLoader.item.sceneGraphGeometryUpdates)
                                    + " geometry/" + String(nativeRendererLoader.item.sceneGraphTransformUpdates)
                                    + " transforms")
            }
            function onPresentedRevisionChanged() {
                if (nativeRendererLoader.item.presentedRevision <= 0)
                    return
                runCanvasRoot.nativeRenderRevision = nativeRendererLoader.item.presentedRevision
                if (runCanvasRoot.runFrameTimingActive)
                    runFrameTiming.recordEvent("native-revision-installed")
                if (nativeRendererLoader.item.batchCount > 0
                        && nativeRendererLoader.item.vertexCount > 0)
                    runCanvasRoot.recordLivePaintedFrame()
            }
        }
        onStatusChanged: {
            if (status === Loader.Error) {
                runCanvasRoot.nativeRenderUsable = false
                runCanvasRoot.nativeRenderError = "Native renderer component failed to load"
                previewCanvas.requestPaint()
            }
        }
    }

    Loader {
        id: canvasPainterRendererLoader
        anchors.fill: parent
        active: runCanvasRoot.canvasPainterRenderRequested
        source: "CanvasPainterRunExecutionLayer.qml"
        visible: status === Loader.Ready && item
        z: 2

        onLoaded: {
            runCanvasRoot.nativeRenderUsable = true
            runCanvasRoot.rebuildNativeRenderCommands()
            if (runCanvasRoot.runPerfDebug)
                console.log("RUN-CANVAS-PAINTER ready", item.backendName)
        }
        Connections {
            target: canvasPainterRendererLoader.item
            enabled: canvasPainterRendererLoader.status === Loader.Ready
            function onPacketValidChanged() {
                if (canvasPainterRendererLoader.item.packetValid) {
                    runCanvasRoot.nativeRenderUsable = true
                    runCanvasRoot.nativeRenderError = ""
                } else {
                    runCanvasRoot.nativeRenderUsable = false
                    runCanvasRoot.nativeRenderError = canvasPainterRendererLoader.item.packetError
                    previewCanvas.requestPaint()
                }
            }
            function onPresentedRevisionChanged() {
                if (canvasPainterRendererLoader.item.presentedRevision <= 0)
                    return
                runCanvasRoot.nativeRenderRevision = canvasPainterRendererLoader.item.presentedRevision
                if (runCanvasRoot.runFrameTimingActive)
                    runFrameTiming.recordEvent("canvas-painter-revision-installed")
                if (canvasPainterRendererLoader.item.batchCount > 0)
                    runCanvasRoot.recordLivePaintedFrame()
            }
        }
        onStatusChanged: {
            if (status === Loader.Error) {
                runCanvasRoot.nativeRenderUsable = false
                runCanvasRoot.nativeRenderError = "Canvas Painter component failed to load"
                previewCanvas.requestPaint()
            }
        }
    }

    Canvas {
        id: staticLiveCanvas
        objectName: "run-static-live-canvas"
        anchors.fill: parent
        z: 1
        visible: runCanvasRoot.sceneMode === "LIVE"
            && (runCanvasRoot.experimentalRenderRequested
                || runCanvasRoot.canvasLiveLayerSplitActive)
        renderTarget: Canvas.Image
        renderStrategy: Canvas.Immediate
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        onPaint: {
            if (runCanvasRoot.runFrameTimingActive)
                runFrameTiming.beginStage("canvas-static-paint")
            var ctx = getContext("2d")
            ctx.clearRect(0, 0, width, height)
            var data = runCanvasRoot.sceneData
            if (runCanvasRoot.runFrameTimingActive)
                runFrameTiming.endStage("canvas-static-paint")
        }
    }

    Canvas {
        id: previewCanvas
        objectName: "run-preview-canvas"
        property bool livePaintPending: false
        anchors.fill: parent
        z: 3
        visible: runCanvasRoot.sceneMode !== "LIVE"
            || !runCanvasRoot.experimentalRenderActive
        renderTarget: Canvas.Image
        renderStrategy: runCanvasRoot.argumentFlag("--run-canvas-threaded")
            ? Canvas.Threaded : Canvas.Immediate
        // Canvas.Immediate is the Qt default and is measurably faster on the
        // target Panfrost renderer. Keep Threaded as a diagnostic fallback.
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        onPainted: {
            if (runCanvasRoot.runFrameTimingActive)
                runFrameTiming.recordEvent("canvas-painted")
            runCanvasRoot.recordLivePaintedFrame()
        }
        onPaint: {
            if (runCanvasRoot.runFrameTimingActive)
                runFrameTiming.beginStage("canvas-paint")
            var paintStarted = Date.now()
            var ctx = getContext("2d")
            ctx.clearRect(0, 0, width, height)
            var data = runCanvasRoot.sceneData
            if (data.ready && runCanvasRoot.sceneMode === "PLACEMENT")
                runCanvasRoot.drawPlacement(ctx, data)
            else if (runCanvasRoot.sceneMode === "LIVE") {
                // LIVE renders only in Qt Quick 3D (LiveScene3D). The 2D Canvas
                // engine is archived at git tag legacy-canvas-live-engine.
                ctx.fillStyle = "#eef2f7"
                ctx.fillRect(0, 0, width, height)
                if (!runCanvasRoot.live3DActive) {
                    ctx.fillStyle = "#475569"
                    ctx.font = "bold 12px sans-serif"
                    ctx.fillText("LIVE 3D LOADING...", 24, 36)
                }
            } else {
                ctx.fillStyle = "#fbfbfb"
                ctx.fillRect(0, 0, width, height)
                ctx.strokeStyle = "#94a3b8"
                ctx.lineWidth = 2
                ctx.strokeRect(14, 14, Math.max(0, width - 28), Math.max(0, height - 28))
                ctx.fillStyle = "#475569"
                ctx.font = "bold 12px sans-serif"
                ctx.fillText("NO CAD PREVIEW DATA", 24, 36)
            }
            if (runCanvasRoot.runPerfDebug)
                console.log("RUN-PERF paint", runCanvasRoot.label, "mode=" + runCanvasRoot.sceneMode, "bend=" + String(runCanvasRoot.currentSelectedBendIndex() + 1), "ms=" + String(Date.now() - paintStarted), "ready=" + String(data && data.ready))
            if (runCanvasRoot.runCanvasTimingActive) {
                runCanvasRoot.canvasTimingPaintCount += 1
                runCanvasRoot.canvasTimingPaintMs += Date.now() - paintStarted
            }
            if (runCanvasRoot.runFrameTimingActive)
                runFrameTiming.endStage("canvas-paint")
        }
    }

    Item {
        id: liveMaterialFaceLegendOverlay
        objectName: "run-live-material-face-legend"
        readonly property var descriptor:
            runCanvasRoot.liveMaterialFaceLegendOverlayDescriptor
        readonly property color accentColor: descriptor ? descriptor.border : "#64748b"
        x: 12
        y: 12
        width: Math.max(196, legendBody.implicitWidth + 20)
        height: 30 + legendBody.implicitHeight + 12
        z: 4
        visible: runCanvasRoot.sceneMode === "LIVE"
            && String(runCanvasRoot.liveProjectionMode).toUpperCase()
                === "ISOMETRIC"
            && descriptor !== null

        Rectangle {
            anchors.fill: parent
            radius: 8
            color: "#F2FFFFFF"
            border.color: "#CBD5E1"
            border.width: 1
        }

        // Coloured header strip with the material face
        Rectangle {
            x: 0; y: 0
            width: parent.width
            height: 28
            radius: 8
            color: liveMaterialFaceLegendOverlay.accentColor
            Rectangle {
                anchors.left: parent.left; anchors.right: parent.right; anchors.bottom: parent.bottom
                height: 8
                color: parent.color
            }
            Text {
                anchors.left: parent.left
                anchors.leftMargin: 10
                anchors.verticalCenter: parent.verticalCenter
                color: "white"
                font.pixelSize: 12
                font.weight: Font.ExtraBold
                font.letterSpacing: 0.4
                text: liveMaterialFaceLegendOverlay.descriptor
                    ? liveMaterialFaceLegendOverlay.descriptor.title : ""
            }
        }

        Column {
            id: legendBody
            x: 10
            y: 36
            spacing: 6

            Row {
                spacing: 6
                Rectangle {
                    height: 18; radius: 9
                    width: viewChip.implicitWidth + 14
                    color: "#F1F5F9"; border.color: "#CBD5E1"
                    Text {
                        id: viewChip
                        anchors.centerIn: parent
                        color: "#334155"
                        font.pixelSize: 11
                        font.weight: Font.Bold
                        text: liveMaterialFaceLegendOverlay.descriptor
                            ? liveMaterialFaceLegendOverlay.descriptor.view : ""
                    }
                }
                Rectangle {
                    height: 18; radius: 9
                    width: dieChip.implicitWidth + 14
                    color: "#FFF7ED"; border.color: "#FDBA74"
                    Text {
                        id: dieChip
                        anchors.centerIn: parent
                        color: "#9A3412"
                        font.pixelSize: 11
                        font.weight: Font.Bold
                        text: liveMaterialFaceLegendOverlay.descriptor
                            ? liveMaterialFaceLegendOverlay.descriptor.die : ""
                    }
                }
            }

            Row {
                spacing: 14
                Row {
                    spacing: 5
                    Row {
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: 3
                        Repeater {
                            model: 4
                            Rectangle { width: 4; height: 2; color: "#5b21b6" }
                        }
                    }
                    Text { text: qsTr("PUNCH"); color: "#475569"; font.pixelSize: 11; font.weight: Font.Bold }
                }
                Row {
                    spacing: 5
                    Rectangle { anchors.verticalCenter: parent.verticalCenter; width: 22; height: 2; color: "#b45309" }
                    Text { text: qsTr("DIE"); color: "#475569"; font.pixelSize: 11; font.weight: Font.Bold }
                }
            }
        }
    }

    MouseArea {
        anchors.fill: parent
        enabled: runCanvasRoot.sceneMode === "PLACEMENT"
        acceptedButtons: Qt.LeftButton
        onPressed: function(mouse) {
            runCanvasRoot.focusPlacementPunchBadge(mouse.x, mouse.y)
        }
    }

    Text {
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.margins: 16
        visible: sceneMode !== "PLACEMENT"
        text: label + "\n" + detail
        color: "#1f2937"
        font.bold: true
        font.pixelSize: 13
    }

}
