        if (!loop || loop.length < 3)
            return false
        var bounds = placementBounds(loop)
        var width = bounds.maxX - bounds.minX
        var height = bounds.maxY - bounds.minY
        if (!isFinite(width) || !isFinite(height) || width <= 0.002 || height <= 0.002)
            return false
        return Math.abs(polygonArea(loop)) > Math.max(0.00001, width * height * 0.002)
    }

    function placementStrokeSegments(points, splitLongEdges, bendLines) {
