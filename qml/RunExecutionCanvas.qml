    function livePanelScreenDepthPlane(panel, sx, sy) {
        var points = panel && panel.polygon && panel.polygon.length >= 3
            ? panel.polygon : (panel ? panel.corners : null)
        for (var first = 0; points && first < points.length - 2; first++) {
            for (var second = first + 1; second < points.length - 1; second++) {
                for (var third = second + 1; third < points.length; third++) {
                    var p1 = points[first], p2 = points[second], p3 = points[third]
                    var d1 = Number(p1 ? p1.viewDepth : NaN)
                    var d2 = Number(p2 ? p2.viewDepth : NaN)
                    var d3 = Number(p3 ? p3.viewDepth : NaN)
                    if (!isFinite(d1) || !isFinite(d2) || !isFinite(d3))
                        continue
                    var x1 = sx(p1.x), y1 = sy(p1.r)
                    var x2 = sx(p2.x), y2 = sy(p2.r)
                    var x3 = sx(p3.x), y3 = sy(p3.r)
                    var determinant = x1 * (y2 - y3) + x2 * (y3 - y1)
                        + x3 * (y1 - y2)
                    if (Math.abs(determinant) <= 1.0e-8)
                        continue
                    return {
                        a: (d1 * (y2 - y3) + d2 * (y3 - y1)
                            + d3 * (y1 - y2)) / determinant,
                        b: (x1 * (d3 - d2) + x2 * (d1 - d3)
                            + x3 * (d2 - d1)) / determinant,
                        c: (d1 * (x2 * y3 - x3 * y2)
                            + d2 * (x3 * y1 - x1 * y3)
                            + d3 * (x1 * y2 - x2 * y1)) / determinant
                    }
