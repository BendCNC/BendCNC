        if (!live || !live.ready || !artifacts || artifacts.v5Direct !== true
                || !artifacts.v5Pose || !artifacts.v5SectionFrame)
            return null
        var pose = live.pose || ({})
        var compiled = artifacts.v5Pose
        var descriptors = v5StaticDescriptors(sceneData)
        var states = ({})
        if (descriptors && live3DPanelStatesCache.descriptors === descriptors
                && live3DPanelStatesCache.sequence === descriptors.currentSequence) {
            states = live3DPanelStatesCache.states
        } else if (descriptors) {
            for (var i = 0; i < descriptors.descriptors.length; i++) {
                var descriptor = descriptors.descriptors[i]
                var owner = Number(descriptor.ownerSequence)
                states[descriptor.panelId] = owner === descriptors.currentSequence
                    ? "current" : (owner > descriptors.currentSequence ? "future" : "completed")
            }
