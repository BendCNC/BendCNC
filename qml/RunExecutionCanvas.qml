            overlay.directions.push({
                edgeId: edge.bendId,
                childPanelId: edge.childPanelId,
                sequenceHint: edge.sequenceHint,
                current: Number(edge.sequenceHint) === Number(currentSequence),
                from: hingeMidpoint,
                to: childCentroid
            })
        }
        return overlay
    }

    function v5LoopAreaCentroid(points) {
        if (!points || points.length < 3)
            return null
        var twiceArea = 0
        var weightedX = 0
        var weightedY = 0
        for (var pointIndex = 0; pointIndex < points.length; pointIndex++) {
            var current = points[pointIndex]
            var next = points[(pointIndex + 1) % points.length]
            var cross = Number(current.x_in) * Number(next.y_in)
                    - Number(next.x_in) * Number(current.y_in)
            twiceArea += cross
            weightedX += (Number(current.x_in) + Number(next.x_in)) * cross
            weightedY += (Number(current.y_in) + Number(next.y_in)) * cross
        }
        if (Math.abs(twiceArea) <= 1.0e-10)
            return null
        return {
            x_in: weightedX / (3 * twiceArea),
            y_in: weightedY / (3 * twiceArea),
            area: Math.abs(twiceArea) * 0.5
        }
    }

    function v5PanelAreaCentroid(panel) {
        var outer = v5LoopAreaCentroid(panel && panel.outerLoop ? panel.outerLoop : [])
        if (!outer)
            return null
        var weightedX = outer.x_in * outer.area
        var weightedY = outer.y_in * outer.area
        var materialArea = outer.area
        var holes = panel && panel.holeLoops ? panel.holeLoops : []
        for (var holeIndex = 0; holeIndex < holes.length; holeIndex++) {
            var hole = v5LoopAreaCentroid(holes[holeIndex])
            if (!hole)
                continue
            weightedX -= hole.x_in * hole.area
            weightedY -= hole.y_in * hole.area
            materialArea -= hole.area
        }
        if (materialArea <= 1.0e-10)
            return null
        return { x_in: weightedX / materialArea, y_in: weightedY / materialArea }
    }

    function v5PlacementLiveWitness(data, compiled, currentEdge, sectionFrame) {
        var result = {
            panelId: "",
            sequence: 0,
            placementDepthDelta: 0,
            liveDeltaX: 0,
            status: "INDETERMINATE"
        }
        if (!data || !data.preview || !data.currentBend || !data.bounds
                || !data.projection || !compiled || !compiled.model
                || !currentEdge || !sectionFrame)
            return result

        var candidates = []
        var currentSequence = Number(currentEdge.sequenceHint)
        for (var edgeIndex = 0; edgeIndex < compiled.model.edges.length; edgeIndex++) {
            var candidateEdge = compiled.model.edges[edgeIndex]
            var candidateSequence = Number(candidateEdge.sequenceHint)
            if (candidateSequence > 0 && candidateSequence < currentSequence) {
                candidates.push({
                    panelId: String(candidateEdge.childPanelId),
                    sequence: candidateSequence
                })
            }
        }
        candidates.sort(function(a, b) { return b.sequence - a.sequence })
        candidates.push({ panelId: String(currentEdge.parentPanelId), sequence: 0 })

        var rawHinge = {
            x_in: (Number(currentEdge.hingeStart.x_in)
                   + Number(currentEdge.hingeEnd.x_in)) * 0.5,
            y_in: (Number(currentEdge.hingeStart.y_in)
                   + Number(currentEdge.hingeEnd.y_in)) * 0.5
        }
        var placementHinge = projectPlacementRawPointToWorld(
            rawHinge, data.preview, data.bounds, data.currentBend, data.projection)
        var hinge = SheetMetalPoseEvaluator.worldHinge(compiled, currentEdge)
        if (!hinge)
            return result

        var tolerance = 0.01
        for (var candidateIndex = 0; candidateIndex < candidates.length; candidateIndex++) {
            var candidate = candidates[candidateIndex]
            var panel = compiled.model.panelsById[candidate.panelId]
            var rawWitness = v5PanelAreaCentroid(panel)
            var witnessTransform = compiled.transforms[candidate.panelId]
            if (!rawWitness || !witnessTransform)
                continue
            var placementWitness = projectPlacementRawPointToWorld(
                rawWitness, data.preview, data.bounds, data.currentBend, data.projection)
            var worldWitness = RigidTransform3D.transformPoint(witnessTransform, {
                x: Number(rawWitness.x_in), y: Number(rawWitness.y_in), z: 0
            })
            // PLACEMENT screen X runs along the active bend line. LIVE screen X
            // runs normal to that line, away from/toward the tooling. Compare
            // LIVE X with PLACEMENT depth (screen Y), never PLACEMENT line X.
            var placementDelta = placementWitness.y - placementHinge.y
            var worldDelta = RigidTransform3D.sub(worldWitness, hinge.midpoint)
            var liveDelta = RigidTransform3D.dot(worldDelta, sectionFrame.horizontal)
            if (String(liveProjectionMode).toUpperCase() === "ISOMETRIC") {
                var basis = isometricCameraBasis()
                liveDelta += RigidTransform3D.dot(worldDelta, sectionFrame.viewAxis)
                    * basis.depthXPerIn
            }
            if (Math.abs(placementDelta) <= tolerance || Math.abs(liveDelta) <= tolerance)
                continue
            result.panelId = candidate.panelId
            result.sequence = candidate.sequence
            result.placementDepthDelta = placementDelta
            result.liveDeltaX = liveDelta
            result.status = placementDelta * liveDelta > 0 ? "PASS" : "FAIL"
            return result
        }
        return result
    }

    // hingeSectionFrame() puts the topology child toward the backgauge, but
    // the topology root is arbitrary. The bend's gauge side (closestSide, the
    // same rule PLACEMENT and the BG X use) decides which panel is gauged;
    // mirror the horizontal basis when the child is on the front side.
    function v5PlanFlipActive(currentBend) {
        if (!currentBend)
            return false
        if (currentBend.unfoldFlip === true)
            return true
        var programBend = currentSelectedBendValue()
        return bendSequence(currentBend, -1) === currentSelectedBendIndex() + 1
            && !!programBend && programBend.unfoldFlip === true
    }

    function v5OrientSectionToGaugeSide(currentBend, compiled, currentEdge, sectionFrame) {
        if (!currentBend || !compiled || !compiled.model || !currentEdge || !sectionFrame)
            return sectionFrame
        var oriented = v5OrientSectionToGaugeSideRule(currentBend, compiled, currentEdge, sectionFrame)
        // The unfold plan's flip is a 180 deg turn about the ram (Z) axis that
        // the planner collision-checked; it swaps the part's die side.
        // Only the program bend of this same stroke; during transfers the
        // selection can already point at the next stage.
        if (!v5PlanFlipActive(currentBend))
            return oriented
        var mirrored = {}
        for (var key in oriented)
            mirrored[key] = oriented[key]
        mirrored.horizontal = RigidTransform3D.mul(oriented.horizontal, -1)
        return mirrored
    }

    // Imported unfold plan: the planner's collision-checked machine pose is the
    // authority. stage.panelX holds each panel's mean X at stage entry (mm,
    // +X toward the backgauge); LIVE horizontal is +X toward the operator, so
    // the farthest panel must land on the opposite sign. Returns null without
    // a planned pose (legacy programs keep the closestSide + flip rule).
    function v5OrientSectionToPlannerPose(data, compiled, currentEdge, sectionFrame) {
        var stage = data && data.preview ? currentPreviewStage(data.preview) : null
        if (!stage || !stage.panelX || !data.currentBend || !compiled || !currentEdge || !sectionFrame
                || String(stage.bendId) !== String(bendId(data.currentBend)))
            return null
        var bestId = "", bestX = 0
        for (var id in stage.panelX) {
            var x = Number(stage.panelX[id])
            if (isFinite(x) && Math.abs(x) > Math.abs(bestX) && compiled.model.panelsById[id]) {
                bestId = id
                bestX = x
            }
        }
        if (!bestId || Math.abs(bestX) < 1)
            return null
        var centroid = SheetMetalPoseEvaluator.worldPanelCentroid(compiled, bestId)
        var hinge = SheetMetalPoseEvaluator.worldHinge(compiled, currentEdge)
        if (!centroid || !hinge)
            return null
        var liveDelta = RigidTransform3D.dot(RigidTransform3D.sub(centroid, hinge.midpoint),
                                             sectionFrame.horizontal)
        var oriented = {}
        for (var key in sectionFrame)
            oriented[key] = sectionFrame[key]
        oriented.plannerPanelId = bestId
        // A 180 deg turn about the ram axis (horizontal and longitudinal both
        // reverse; the latter is applied after centring), never a mirror.
        oriented.plannerTurned = liveDelta * bestX > 0
        if (oriented.plannerTurned)
            oriented.horizontal = RigidTransform3D.mul(sectionFrame.horizontal, -1)
        return oriented
    }

    // A CAD bend split into coaxial spans (e.g. by a cut-out) is one bend line
    // under one punch: the planner centres the whole line on its tooling
    // stations. Centre the section along the bend axis on the union of every
    // span, not on the single span chosen as currentEdge (otherwise the part
    // slides along the die and formed flanges land under the punch). Only a
    // plan that strokes spans separately (stage.spanFrom) keeps the one span.
    function v5CentreSectionOnCoaxialSpans(data, compiled, currentEdge, sectionFrame) {
        if (!compiled || !compiled.model || !currentEdge || !sectionFrame)
            return sectionFrame
        var stage = data && data.preview ? currentPreviewStage(data.preview) : null
        var plannerOrigin = v5PlannerOriginShift(stage, compiled, currentEdge, sectionFrame)
        if (plannerOrigin !== null)
            return v5ShiftSectionAlongAxis(sectionFrame, plannerOrigin)
        if (stage && stage.spanFrom && stage.spanTo) {
            // Keep the one span only when this stroke advances a single span.
            var advancing = 0
            for (var sk in stage.spanTo)
                if ((Number(stage.spanTo[sk]) || 0) > (Number(stage.spanFrom[sk]) || 0))
                    advancing++
            if (advancing < 2)
                return sectionFrame
        }
        var source = String(currentEdge.sourceBendId)
        var edges = compiled.model.edges || []
        var lo = Infinity, hi = -Infinity, spans = 0
        for (var i = 0; i < edges.length; i++) {
            var edge = edges[i]
            if (String(edge.sourceBendId) !== source)
                continue
            var hinge = SheetMetalPoseEvaluator.worldHinge(compiled, edge)
            if (!hinge)
                continue
            var a = RigidTransform3D.dot(hinge.start, sectionFrame.viewAxis)
            var b = RigidTransform3D.dot(hinge.end, sectionFrame.viewAxis)
            lo = Math.min(lo, a, b)
            hi = Math.max(hi, a, b)
            spans++
        }
        if (spans < 2)
            return sectionFrame
        return v5ShiftSectionAlongAxis(sectionFrame,
            (lo + hi) / 2 - RigidTransform3D.dot(sectionFrame.origin, sectionFrame.viewAxis))
    }

    // Planner-emitted placement origin (unfold-v6 stage.placementOrigin, flat
    // mm): the exact point machinePlacement put at machine Y = stationYmm.
    // Returns the along-axis shift of sectionFrame.origin, or null when the
    // plan predates the field.
    function v5PlannerOriginShift(stage, compiled, currentEdge, sectionFrame) {
        var po = stage && stage.placementOrigin ? stage.placementOrigin.pointMm : null
        if (!po || po.length < 2)
            return null
        var px = Number(po[0]) / 25.4, py = Number(po[1]) / 25.4
        if (!isFinite(px) || !isFinite(py))
            return null
        var source = String(currentEdge.sourceBendId)
        var edges = compiled.model.edges || []
        var best = null, bestDist = Infinity
        for (var i = 0; i < edges.length; i++) {
            var edge = edges[i]
            if (String(edge.sourceBendId) !== source || !edge.hingeStart || !edge.hingeEnd)
                continue
            var ax = Number(edge.hingeStart.x_in), ay = Number(edge.hingeStart.y_in)
            var dx = Number(edge.hingeEnd.x_in) - ax, dy = Number(edge.hingeEnd.y_in) - ay
            var len2 = dx * dx + dy * dy
            if (!(len2 > 1e-12))
                continue
            var u = ((px - ax) * dx + (py - ay) * dy) / len2
            var dist = Math.abs((px - ax) * dy - (py - ay) * dx) / Math.sqrt(len2)
            if (dist < bestDist) {
                bestDist = dist
                best = { edge: edge, u: u }
            }
        }
        if (!best || bestDist > 0.5)
            return null
        var hinge = SheetMetalPoseEvaluator.worldHinge(compiled, best.edge)
        if (!hinge)
            return null
        var a = RigidTransform3D.dot(hinge.start, sectionFrame.viewAxis)
        var b = RigidTransform3D.dot(hinge.end, sectionFrame.viewAxis)
        return a + best.u * (b - a) - RigidTransform3D.dot(sectionFrame.origin, sectionFrame.viewAxis)
    }

    function v5ShiftSectionAlongAxis(sectionFrame, shift) {
        if (!isFinite(shift) || Math.abs(shift) < 1e-6)
            return sectionFrame
        var centred = {}
        for (var key in sectionFrame)
            centred[key] = sectionFrame[key]
        centred.origin = RigidTransform3D.add(sectionFrame.origin,
                                              RigidTransform3D.mul(sectionFrame.viewAxis, shift))
        centred.coaxialSpanShift = shift
        return centred
    }

    function v5OrientSectionToGaugeSideRule(currentBend, compiled, currentEdge, sectionFrame) {
        var childPanel = compiled.model.panelsById[currentEdge.childPanelId]
        var centroid = childPanel ? v5PanelAreaCentroid(childPanel) : null
        if (!centroid)
            return sectionFrame
        var axisX = bendAxisValue(currentBend).toUpperCase() === "X"
        var childCoord = Number(axisX ? centroid.y_in : centroid.x_in)
        var lineCoord = liveSectionCoord(currentBend)
        if (!isFinite(childCoord) || !isFinite(lineCoord) || Math.abs(childCoord - lineCoord) < 0.01)
            return sectionFrame
        var childOnGauge = gaugeSideNegative(currentBend) ? childCoord < lineCoord : childCoord > lineCoord
        if (childOnGauge)
            return sectionFrame
        var mirrored = {}
        for (var key in sectionFrame)
            mirrored[key] = sectionFrame[key]
        mirrored.horizontal = RigidTransform3D.mul(sectionFrame.horizontal, -1)
        return mirrored
    }

    function v5AlignSectionFrameToPlacement(data, compiled, currentEdge, sectionFrame) {
        var witness = v5PlacementLiveWitness(data, compiled, currentEdge, sectionFrame)
        // hingeSectionFrame() owns the machine-safety camera contract: the
        // active parent stays opposite the negative-X backgauge. Placement
        // parity is diagnostic and must never mirror this horizontal basis.
        var alignedFrame = sectionFrame
        var alignedLiveDelta = witness.liveDeltaX
        return {
            frame: alignedFrame,
            flipped: false,
            witnessPanelId: witness.panelId,
            witnessSequence: witness.sequence,
            placementDepthDelta: witness.placementDepthDelta,
            preAlignmentLiveDeltaX: witness.liveDeltaX,
            alignedLiveDeltaX: alignedLiveDelta,
            status: Math.abs(witness.placementDepthDelta) > 0.01
                    && Math.abs(alignedLiveDelta) > 0.01
                ? (witness.placementDepthDelta * alignedLiveDelta > 0 ? "PASS" : "FAIL")
                : "INDETERMINATE"
        }
    }

    // PLACEMENT and LIVE use different projections, so contour winding cannot
    // prove that the operator-visible branch stayed on the same side. Track one
    // physical witness instead: the most recently completed panel, or the active
    // parent before any bend is complete. Both deltas are measured from the
    // active hinge in their existing operation frames.
    function buildV5PlacementLiveOrientationParity(data, compiled, currentEdge,
                                                     sectionFrame, pose) {
        var result = {
            authority: "topology-witness-v5",
            status: "INDETERMINATE",
            currentEdgeId: currentEdge ? String(currentEdge.bendId) : "",
            parentPanelId: currentEdge ? String(currentEdge.parentPanelId) : "",
            witnessPanelId: "",
            witnessSequence: 0,
            placementAxis: normalizePlacementAxis(
                data && data.currentBend ? bendAxisValue(data.currentBend) : "Y"),
            placementMirrored: data && data.currentBend
                ? shouldMirrorPlacementLine(data.preview, data.currentBend) : false,
            placementDepthDelta: 0,
            liveDeltaX: 0,
            parentLiveDeltaX: 0,
            gaugeFaceX: finite(pose ? pose.gaugeFaceX : 0, 0)
        }
        if (!data || !data.preview || !data.currentBend || !data.bounds
                || !data.projection || !compiled || !compiled.model
                || !currentEdge || !sectionFrame)
            return result

        var witness = v5PlacementLiveWitness(data, compiled, currentEdge, sectionFrame)
        var parentCentroid = SheetMetalPoseEvaluator.worldPanelCentroid(
            compiled, currentEdge.parentPanelId)
        var hinge = SheetMetalPoseEvaluator.worldHinge(compiled, currentEdge)
        var parentLiveDelta = parentCentroid
            ? RigidTransform3D.dot(
                RigidTransform3D.sub(parentCentroid, hinge.midpoint),
                sectionFrame.horizontal) : 0
        result.witnessPanelId = witness.panelId
        result.witnessSequence = witness.sequence
        result.placementDepthDelta = witness.placementDepthDelta
        result.liveDeltaX = witness.liveDeltaX
        result.parentLiveDeltaX = parentLiveDelta
        result.status = witness.status
        return result
    }

    // PLACEMENT is a top view while LIVE is observed from the machine's left.
    // Keep the SIDE camera basis intact: only canonicalize the longitudinal
    // axis used for oblique depth and section-plane sign. Machine depth remains
    // on horizontal, so bend animation and parent/finger safety do not change.
    function v5LeftViewLongitudinalAxis(currentBend) {
        return placementUsesRawY(currentBend)
            ? RigidTransform3D.v(1, 0, 0)
            : RigidTransform3D.v(0, -1, 0)
    }

    function v5IsometricOperationLongitudinalAxis(currentBend) {
        var canonical = v5LeftViewLongitudinalAxis(currentBend)
        // PLACEMENT rotates the same sheet face end-for-end when the gauge
        // side changes. ISOMETRIC must observe the same longitudinal feature
        // order, but only through its oblique depth axis: physical poses and
        // the fixed-left SIDE horizontal/vertical basis remain untouched.
        return normalizeClosestSide(bendClosestSide(currentBend, "")) === "NEG"
            ? RigidTransform3D.mul(canonical, -1)
            : canonical
    }

    function v5OrientSectionViewAxis(sectionFrame, desired) {
        if (!sectionFrame || !desired
                || RigidTransform3D.dot(sectionFrame.viewAxis, desired) >= 0)
            return sectionFrame
        return {
            origin: sectionFrame.origin,
            hingeStart: sectionFrame.hingeStart,
            hingeEnd: sectionFrame.hingeEnd,
            viewAxis: RigidTransform3D.mul(sectionFrame.viewAxis, -1),
            horizontal: sectionFrame.horizontal,
            vertical: sectionFrame.vertical,
            parentOutward: sectionFrame.parentOutward,
            childOutward: sectionFrame.childOutward,
            angleRadians: sectionFrame.angleRadians
        }
    }

    function v5OrientSectionViewAxisFromLeft(currentBend, sectionFrame) {
        if (!currentBend || !sectionFrame)
            return sectionFrame
        return v5OrientSectionViewAxis(
            sectionFrame, v5LeftViewLongitudinalAxis(currentBend))
    }

    function v5OrientSectionViewAxisForIsometricOperation(currentBend,
                                                            sectionFrame) {
        if (!currentBend || !sectionFrame
                || String(liveProjectionMode).toUpperCase() !== "ISOMETRIC")
            return sectionFrame
        return v5OrientSectionViewAxis(
            sectionFrame, v5IsometricOperationLongitudinalAxis(currentBend))
    }

    function v5MapInternalSharedCapsToProjection(rawCaps, projection) {
        var mapped = []
        if (!projection)
            return mapped
        if (!projection.sectionSegment) {
            for (var areaIndex = 0; rawCaps && areaIndex < rawCaps.length; areaIndex++) {
                if (rawCaps[areaIndex] && rawCaps[areaIndex].a && rawCaps[areaIndex].b)
                    mapped.push(rawCaps[areaIndex])
            }
            return mapped
        }
        var polygon = liveSectionSegmentPolygon(projection.sectionSegment)
        if (polygon.length !== 4)
            return mapped
        var endpointCaps = [
            { endpoint: "start", anchor: projection.sectionSegment.start, a: polygon[3], b: polygon[0] },
            { endpoint: "end", anchor: projection.sectionSegment.end, a: polygon[1], b: polygon[2] }
        ]
        var usedEndpoints = ({})
        var mountAnchor = projection.sectionSegment.mountAnchor
        if (mountAnchor) {
            var mountEndpoint = null
            var mountEndpointDistance = Infinity
            for (var mountEndpointIndex = 0; mountEndpointIndex < endpointCaps.length; mountEndpointIndex++) {
                var mountCandidate = endpointCaps[mountEndpointIndex]
                var mountDistance = Math.hypot(mountAnchor.x - mountCandidate.anchor.x,
                                               mountAnchor.r - mountCandidate.anchor.r)
                if (mountDistance < mountEndpointDistance) {
                    mountEndpoint = mountCandidate
                    mountEndpointDistance = mountDistance
                }
            }
            if (mountEndpoint && mountEndpointDistance <= 0.0001) {
                usedEndpoints[mountEndpoint.endpoint] = true
                mapped.push({
                    endpoint: "representative-mount:" + mountEndpoint.endpoint,
                    a: mountEndpoint.a,
                    b: mountEndpoint.b,
                    representativeMount: true
                })
            }
        }
        var halfThickness = Math.max(0.0005, finite(projection.sectionSegment.halfThickness, 0.018))
        var endpointTolerance = Math.max(0.002, halfThickness * 0.25)
        for (var capIndex = 0; rawCaps && capIndex < rawCaps.length; capIndex++) {
            var cap = rawCaps[capIndex]
            if (!cap)
                continue
            var anchor = cap.point
            if (!anchor && cap.a && cap.b) {
                anchor = { x: (cap.a.x + cap.b.x) * 0.5, r: (cap.a.r + cap.b.r) * 0.5 }
            }
            if (!anchor)
                continue
            var selected = null
            var selectedDistance = Infinity
            for (var endpointIndex = 0; endpointIndex < endpointCaps.length; endpointIndex++) {
                var candidate = endpointCaps[endpointIndex]
                var distance = Math.hypot(anchor.x - candidate.anchor.x,
                                          anchor.r - candidate.anchor.r)
                if (distance < selectedDistance) {
                    selected = candidate
                    selectedDistance = distance
                }
            }
            if (!selected || selectedDistance > endpointTolerance || usedEndpoints[selected.endpoint])
                continue
            usedEndpoints[selected.endpoint] = true
            mapped.push({
                endpoint: String(cap.endpoint || "hinge") + ":" + selected.endpoint,
                a: selected.a,
                b: selected.b,
                sourceCollapsed: cap.collapsed === true
            })
        }
        return mapped
    }

    function v5LiveInternalEdges(compiled, sectionFrame, pose, currentSequence,
                                 displayProjection,
                                 projectedPanelVerticesById) {
        var result = ({})
        var edges = compiled && compiled.model ? compiled.model.edges : []
        var visibleIds = ({})
        var visiblePanelIds = SheetMetalPoseGraph.physicalPanelIds(compiled ? compiled.model : null)
        for (var visibleIndex = 0; visibleIndex < visiblePanelIds.length; visibleIndex++)
            visibleIds[String(visiblePanelIds[visibleIndex])] = true
        for (var i = 0; i < edges.length; i++) {
            var edge = edges[i]
            if (!edge)
                continue
            var projectedSpans = null
            if (displayProjection && projectedPanelVerticesById) {
                projectedSpans = v5ProjectedDisplayHingeSegmentsFromPanelProjection(
                    edge, projectedPanelVerticesById[edge.parentPanelId])
            }
            if (!projectedSpans) {
                projectedSpans = displayProjection
                    ? v5ProjectedDisplayHingeSegments(
                        compiled, edge, sectionFrame, pose)
                    : v5ProjectedHingeSegments(
                        compiled, edge, sectionFrame, pose)
            }
            for (var spanIndex = 0; spanIndex < projectedSpans.length; spanIndex++) {
                var cap = projectedSpans[spanIndex]
                if (visibleIds[String(edge.parentPanelId)] && !result[edge.parentPanelId])
                    result[edge.parentPanelId] = []
                if (visibleIds[String(edge.childPanelId)] && !result[edge.childPanelId])
                    result[edge.childPanelId] = []
                if (visibleIds[String(edge.parentPanelId)])
                    result[edge.parentPanelId].push(cap)
                if (visibleIds[String(edge.childPanelId)])
                    result[edge.childPanelId].push(cap)
            }
        }
        return result
    }

    function v5StaticDescriptors(data) {
        var bend = data && data.currentBend ? data.currentBend : ({})
        var currentSequence = bendSequence(bend, currentSelectedBendIndex() + 1)
        var key = liveRevisionKey()
            + "|bend=" + String(bendId(bend))
            + "|seq=" + String(currentSequence)
            + "|index=" + String(currentSelectedBendIndex())
            + "|stage=" + JSON.stringify(currentPreviewStage(parsePreview()) || null)
        if (v5StaticDescriptorCache
                && v5StaticDescriptorCacheKey === key) {
            if (runFrameTimingActive)
                runFrameTiming.recordCount("v5-static-descriptor-cache-hit")
            return v5StaticDescriptorCache
        }
        if (runFrameTimingActive)
            runFrameTiming.recordCount("v5-static-descriptor-cache-miss")
        var topology = v5CachedTopology(data)
        if (!topology)
            return null
        var currentEdges = topology.edgesBySourceSequence[
            String(bendId(bend)) + ":" + String(currentSequence)] || []
        var currentEdge = currentEdges.length > 0 ? currentEdges[0] : null
        // Split hinge: the punch/section frame sits on the span the active
        // stage folds, not on relation index 0.
        var activeStage = currentPreviewStage(parsePreview())
        var activeRel = activeStage && activeStage.relationId ? String(activeStage.relationId) : ""
        for (var ce = 0; activeRel && ce < currentEdges.length; ce++)
            if (String(currentEdges[ce].bendId) === activeRel)
                currentEdge = currentEdges[ce]
        if (!currentEdge)
            return null
        var descriptors = []
        var bendKeys = []
        for (var bendKey in topology.bendsById)
            bendKeys.push(String(bendKey))
        bendKeys.sort()
        for (var panelIndex = 0;
                panelIndex < topology.normalized.panelOrder.length;
                panelIndex++) {
            var panelId = topology.normalized.panelOrder[panelIndex]
            var edge = topology.normalized.edgeByChildId[panelId] || null
            var ownerSequence = edge ? Number(edge.sequenceHint) : 0
            descriptors.push({
                panelId: panelId,
                edge: edge,
                sourceBend: edge
