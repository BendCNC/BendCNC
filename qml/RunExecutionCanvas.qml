        for (var l = 0; l < model.lines.length; l++) {
            points.push({ x: model.lines[l].x1, y: model.lines[l].y1 })
            points.push({ x: model.lines[l].x2, y: model.lines[l].y2 })
        }
        for (var c = 0; model.circles && c < model.circles.length; c++) {
            points.push({ x: model.circles[c].cx - model.circles[c].radius, y: model.circles[c].cy })
            points.push({ x: model.circles[c].cx + model.circles[c].radius, y: model.circles[c].cy })
            points.push({ x: model.circles[c].cx, y: model.circles[c].cy - model.circles[c].radius })
            points.push({ x: model.circles[c].cx, y: model.circles[c].cy + model.circles[c].radius })
        }
        for (var a = 0; model.arcs && a < model.arcs.length; a++) {
            points.push({ x: model.arcs[a].cx - model.arcs[a].radius, y: model.arcs[a].cy })
            points.push({ x: model.arcs[a].cx + model.arcs[a].radius, y: model.arcs[a].cy })
            points.push({ x: model.arcs[a].cx, y: model.arcs[a].cy - model.arcs[a].radius })
            points.push({ x: model.arcs[a].cx, y: model.arcs[a].cy + model.arcs[a].radius })
        }
