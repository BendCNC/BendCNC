        for (var segmentIndex = 0; segmentIndex < allSegments.length; segmentIndex++) {
            toolingOffsets.push(toolingStationDisplayOffset(
                allSegments[segmentIndex].startXIn, liveProjectionMode))
            toolingOffsets.push(toolingStationDisplayOffset(
                allSegments[segmentIndex].endXIn, liveProjectionMode))
        }
        var staticBounds = emptyLiveBounds()
        var punchBounds = emptyLiveBounds()
        if (tableModel)
            includeTransformedDxfBounds(staticBounds, tableModel, (tableModel.bounds.minX + tableModel.bounds.maxX) / 2, tableAnchorY, 0, stack.tableTopR, false, false, 0, 1, extrusion)
        if (holderModel && stack.usesRiser)
