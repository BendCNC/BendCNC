    }

    function resolvePunchProfile(model) {
        if (!model || !model.bounds)
            return { tipLocalX: 0, tipLocalY: 0 }
        var cacheKey = String(model._cachePath || "") + "|" + String(dxfModelGeometryCount(model))
        if (punchProfileCache && punchProfileCache[cacheKey])
            return punchProfileCache[cacheKey]
        var points = collectDxfModelPoints(model)
        var tipLocalY = model.bounds.minY
        var tipLocalX = (model.bounds.minX + model.bounds.maxX) / 2
        var epsilon = Math.max(0.01, (model.bounds.maxY - model.bounds.minY) * 0.01)
        var tipXSum = 0
        var tipCount = 0
        for (var i = 0; i < points.length; i++) {
            if (Math.abs(points[i].y - tipLocalY) <= epsilon) {
                tipXSum += points[i].x
                tipCount++
            }
        }
        if (tipCount > 0)
            tipLocalX = tipXSum / tipCount
        var profile = { tipLocalX: tipLocalX, tipLocalY: tipLocalY }
        if (cacheKey.length > 1)
            punchProfileCache[cacheKey] = profile
        return profile
    }

    function resolveSupportSurfaceY(model, upperSurface, minSpanFraction) {
        if (!model)
            return 0
        var points = collectDxfModelPoints(model)
        if (points.length === 0)
            return upperSurface ? model.bounds.maxY : model.bounds.minY
        var minSpan = Math.max(0.01, (model.bounds.maxX - model.bounds.minX) * minSpanFraction)
        var spans = ({})
        for (var i = 0; i < points.length; i++) {
            var bucket = Math.round(points[i].y * 100) / 100
            var key = String(bucket)
            if (!spans[key])
                spans[key] = { y: bucket, minX: points[i].x, maxX: points[i].x }
            spans[key].minX = Math.min(spans[key].minX, points[i].x)
            spans[key].maxX = Math.max(spans[key].maxX, points[i].x)
        }
        var best = NaN
        for (var spanKey in spans) {
            if (spans[spanKey].maxX - spans[spanKey].minX < minSpan)
                continue
            if (!isFinite(best))
                best = spans[spanKey].y
            else if (upperSurface)
                best = Math.max(best, spans[spanKey].y)
            else
                best = Math.min(best, spans[spanKey].y)
        }
        return isFinite(best) ? best : (upperSurface ? model.bounds.maxY : model.bounds.minY)
    }

    function resolveHolderSeatLocalY(model) {
        if (!model || !model.bounds)
            return 0
        var points = collectDxfModelPoints(model)
        if (points.length === 0)
            return model.bounds.maxY
        var minSpan = Math.max(0.01, (model.bounds.maxX - model.bounds.minX) * 0.55)
        var outerTopLocalY = model.bounds.maxY
        var topExclusion = Math.max(0.02, (model.bounds.maxY - model.bounds.minY) * 0.08)
        var spans = ({})
        for (var i = 0; i < points.length; i++) {
            var bucket = Math.round(points[i].y * 1000) / 1000
            var key = String(bucket)
            if (!spans[key])
                spans[key] = { y: bucket, minX: points[i].x, maxX: points[i].x }
            spans[key].minX = Math.min(spans[key].minX, points[i].x)
            spans[key].maxX = Math.max(spans[key].maxX, points[i].x)
        }
        var best = NaN
        for (var spanKey in spans) {
            var span = spans[spanKey]
            if (span.y >= outerTopLocalY - topExclusion)
                continue
            if (span.maxX - span.minX < minSpan)
                continue
            if (!isFinite(best) || span.y > best)
                best = span.y
        }
        return isFinite(best) ? best : outerTopLocalY
    }

    function drawLiveTableAndDieDxf(ctx, sx, sy, staticScene) {
        var palette = liveToolingAppearancePalette()
        var tableModel = staticScene && staticScene.tableModel ? staticScene.tableModel : loadDxfModel(dxfAssetPath("table", ""))
        var holderModel = staticScene && staticScene.holderModel ? staticScene.holderModel : loadDxfModel(dxfAssetPath("holder", ""))
        var dieModel = staticScene && staticScene.dieModel ? staticScene.dieModel : loadDxfModel(dxfAssetPath("die", selectedToolToken("die")))
        var stack = staticScene && staticScene.stack ? staticScene.stack : ({ dieSeatR: 0, tableTopR: -0.45, usesRiser: false, holderBottomLocalY: 0, holderSeatLocalY: 0 })
        var activeDieFace = staticScene && staticScene.activeDieFace ? staticScene.activeDieFace : resolveActiveDieFace(dieModel)
