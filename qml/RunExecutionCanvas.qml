                    activeDieFace.anchorLocalX, activeDieFace.anchorLocalY,
                    offset.x, offset.r, false, false,
                    activeDieFace.rotationCwDeg, 1, null)
            if (punchModel) {
                var segmentPunchProfile = staticScene && staticScene.punchProfile
                    ? staticScene.punchProfile : resolvePunchProfile(punchModel)
                includeTransformedDxfBounds(punchBounds, punchModel,
                    segmentPunchProfile.tipLocalX, segmentPunchProfile.tipLocalY,
                    offset.x, offset.r,
