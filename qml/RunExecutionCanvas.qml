    function prepareBackgaugeFingerProfile(profile) {
        if (!profile)
            return null
        var outer = displayProfileWorldLoop(
            profile.outerLoop, profile.anchorLocalX, profile.anchorLocalY, 0, 0)
        var holes = []
        for (var holeIndex = 0; holeIndex < profile.holeLoops.length; holeIndex++) {
            holes.push(displayProfileWorldLoop(
                profile.holeLoops[holeIndex],
                profile.anchorLocalX, profile.anchorLocalY, 0, 0))
        }
        var vector = backgaugeFingerExtrusionVector("ISOMETRIC")
        var outerVisibleEdges = visibleExtrusionEdgeIndices(outer, vector, false)
        var holeVisibleEdges = []
        for (var preparedHoleIndex = 0;
                preparedHoleIndex < holes.length; preparedHoleIndex++) {
            holeVisibleEdges.push(visibleExtrusionEdgeIndices(
                holes[preparedHoleIndex], vector, true))
        }
