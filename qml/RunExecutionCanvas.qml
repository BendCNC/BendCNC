            var sideDrawn = drawDxfModel(ctx, model, sx, sy, anchorLocalX,
                                         anchorLocalY, worldX, worldR, scaleFactor,
                                         strokeColor, fillColor, flipX, flipY,
                                         rotationCwDeg)
