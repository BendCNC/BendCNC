    function buildLiveToolingBoundsCache(staticScene) {
        var tableModel = staticScene && staticScene.tableModel ? staticScene.tableModel : loadDxfModel(dxfAssetPath("table", ""))
        var holderModel = staticScene && staticScene.holderModel ? staticScene.holderModel : loadDxfModel(dxfAssetPath("holder", ""))
        var dieModel = staticScene && staticScene.dieModel ? staticScene.dieModel : loadDxfModel(dxfAssetPath("die", selectedToolToken("die")))
        var punchModel = staticScene && staticScene.punchModel ? staticScene.punchModel : loadDxfModel(dxfAssetPath("punch", selectedToolToken("punch")))
        var stack = staticScene && staticScene.stack ? staticScene.stack : ({ dieSeatR: 0, tableTopR: -0.45, usesRiser: false, holderBottomLocalY: 0, holderSeatLocalY: 0 })
        var activeDieFace = staticScene && staticScene.activeDieFace ? staticScene.activeDieFace : resolveActiveDieFace(dieModel, selectedToolToken("die"), String(selectedToolToken("die")).indexOf("+ Riser") >= 0)
        var tableAnchorY = staticScene && isFinite(staticScene.tableAnchorY) ? staticScene.tableAnchorY : (tableModel ? resolveSupportSurfaceY(tableModel, true, 0.60) : 0)
