        var input = output
        output = []
        for (var index = 0; index < input.length; index++) {
            var current = input[index]
            var next = input[(index + 1) % input.length]
            var currentSide = side(current)
            var nextSide = side(next)
            var currentInside = keepFront ? currentSide >= -1.0e-7
                                          : currentSide <= 1.0e-7
            var nextInside = keepFront ? nextSide >= -1.0e-7
                                       : nextSide <= 1.0e-7
            if (currentInside)
                output.push(current)
            if (currentInside === nextInside)
                continue
            var denominator = currentSide - nextSide
            if (Math.abs(denominator) <= 1.0e-12)
                continue
            var parameter = currentSide / denominator
            output.push({
                x: current.x + (next.x - current.x) * parameter,
                y: current.y + (next.y - current.y) * parameter
            })
        }
        return output
    }

