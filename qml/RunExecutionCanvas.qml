    // render frame, so reuse the result for the same frame object.
    property var live3DToolingFrameMemo: null
    property var live3DToolingFrameResult: null
    function live3DTooling() {
        var memoFrame = runRenderFrame
        if (memoFrame && live3DToolingFrameMemo === memoFrame && live3DToolingFrameResult)
            return live3DToolingFrameResult
        var result = computeLive3DTooling()
        live3DToolingFrameMemo = result ? memoFrame : null
        live3DToolingFrameResult = result
        return result
    }

    function computeLive3DTooling() {
        var staticScene = liveStaticSceneCache
        var sectionFrame = activeV5SectionFrame()
        if (!staticScene || !sectionFrame)
            return null
        var rawSegments = { die: toolingSegmentsForLive("die", true),
                            punch: toolingSegmentsForLive("punch", true),
                            table: toolingSegmentsForLive("table", true) }
        var cacheKey = liveStaticSceneKeyFor() + "|finger=" + backgaugeFingerStyle
            + "|bend=" + String(currentSelectedBendIndex())
            + "|frame=" + String(sectionFrame.viewAxis.x) + ":" + String(sectionFrame.viewAxis.y)
            + "|stage=" + JSON.stringify(currentPreviewStage(parsePreview()) || null)
            + "|seg=" + JSON.stringify(rawSegments) + "|flipX=" + String(activeLivePunchFlipX())
        // Called twice per 3D frame: never reload co-station DXFs on a hit.
        if (live3DToolingCache && live3DToolingCache.key === cacheKey)
            return live3DToolingCache
        // Co-station punches carry their own tool (planner bank): draw each
        // with its profile and orientation instead of the active punch.
        // Programs saved before 1.0.10 may carry a bank name ("long") as the
        // token; with no DXF for it, draw that station with the active punch.
        var ownPunch = function(s) {
            return s.coStation === true && String(s.punchToken || "").length > 0
                && !!loadDxfModel(dxfAssetPath("punch", s.punchToken))
        }
        var punchExtras = []
        var extraByCo = ({})
        var activePunchSegments = []
        for (var ps = 0; ps < rawSegments.punch.length; ps++) {
            var seg = rawSegments.punch[ps]
            if (!ownPunch(seg)) {
                activePunchSegments.push(seg)
                continue
            }
            var a0 = toolingStationCoordinate(seg.startXIn), a1 = toolingStationCoordinate(seg.endXIn)
            if (Math.abs(a1 - a0) <= 1e-4)
                continue
            if (!extraByCo[seg.coIndex]) {
                var extraModel = loadDxfModel(dxfAssetPath("punch", seg.punchToken))
                var extraProfile = resolvePunchProfile(extraModel)
                extraByCo[seg.coIndex] = {
                    outer: extraModel ? toolingSegmentExteriorContour(
                        extraModel, extraProfile.tipLocalX, extraProfile.tipLocalY,
                        0, 0, 1, livePunchFlipX(seg.punchMirror), false, 0) : [],
                    runs: []
                }
                punchExtras.push(extraByCo[seg.coIndex])
            }
            extraByCo[seg.coIndex].runs.push({ z0: Math.min(a0, a1), z1: Math.max(a0, a1) })
        }
        rawSegments.punch = activePunchSegments
        function runsFor(kind) {
            var runs = normalizedToolingSegmentRuns(rawSegments[kind])
            var result = []
            for (var i = 0; i < runs.length; i++) {
                var a = toolingStationCoordinate(runs[i].startXIn)
                var b = toolingStationCoordinate(runs[i].endXIn)
                result.push({ z0: Math.min(a, b), z1: Math.max(a, b) })
            }
            if (result.length === 0)
                result.push({ z0: -toolingVisualDepthIn / 2, z1: toolingVisualDepthIn / 2 })
            return result
        }
        // One prism per installed segment so LiveProfileSolid can outline
        // each segment's ends (adjacent segments otherwise read as one bar).
        function segmentRunsFor(kind) {
            var segments = rawSegments[kind] || []
            var result = []
            for (var i = 0; i < segments.length; i++) {
                var a = toolingStationCoordinate(segments[i].startXIn)
                var b = toolingStationCoordinate(segments[i].endXIn)
                if (Math.abs(b - a) > 1e-4)
                    result.push({ z0: Math.min(a, b), z1: Math.max(a, b) })
            }
            return result.length > 0 ? result : runsFor(kind)
        }
        // Individual segments (Placement width badges) for the 3D top view.
        function segmentsFor(kind) {
            var segments = rawSegments[kind] || []
            var result = []
            for (var i = 0; i < segments.length; i++) {
                var s = segments[i]
                var a = toolingStationCoordinate(s.startXIn)
                var b = toolingStationCoordinate(s.endXIn)
                var width = finite(s.widthIn, Math.abs(b - a))
                if (!(width > 0))
                    continue
                result.push({ z: (a + b) / 2, label: trimRailNumber(width) })
            }
            return result
        }
        var tableModel = staticScene.tableModel
        var holderModel = staticScene.holderModel
        var dieModel = staticScene.dieModel
        var stack = staticScene.stack || ({ tableTopR: -0.45, usesRiser: false })
        var dieFace = staticScene.activeDieFace
        var tableAnchorY = isFinite(staticScene.tableAnchorY) ? staticScene.tableAnchorY : 0
        var table = tableModel ? toolingSegmentExteriorContour(
            tableModel, (tableModel.bounds.minX + tableModel.bounds.maxX) / 2,
            tableAnchorY, 0, stack.tableTopR, 1, false, false, 0) : []
        if (table.length < 3) {
            var top = finite(stack.tableTopR, -0.45)
            table = [{ x: -4.6, r: top - 3 }, { x: 4.6, r: top - 3 },
                     { x: 4.6, r: top }, { x: -4.6, r: top }]
        }
        var holder = holderModel && stack.usesRiser ? toolingSegmentExteriorContour(
            holderModel, (holderModel.bounds.minX + holderModel.bounds.maxX) / 2,
            stack.holderBottomLocalY, 0, stack.tableTopR, 1, false, false, 0) : []
        var die = dieModel && dieFace ? toolingSegmentExteriorContour(
            dieModel, dieFace.anchorLocalX, dieFace.anchorLocalY, 0, 0, 1,
            false, false, dieFace.rotationCwDeg) : []
        var punchPlan = currentLivePunchPaintPlan()
        var finger = liveBackgaugeFingerGeometry()
        var fingerProfile = finger ? finger.preparedProfile : null
        var fingerDepth = fingerSolidDepthIn()
        live3DToolingCache = {
            key: cacheKey,
            table: { outer: table, runs: runsFor("table") },
            holder: { outer: holder, runs: runsFor("die") },
            die: { outer: die, runs: segmentRunsFor("die"), segments: segmentsFor("die") },
            punch: { outer: punchPlan ? punchPlan.contour : [], runs: segmentRunsFor("punch"),
                     segments: segmentsFor("punch") },
            punchExtras: punchExtras,
            finger: {
                outer: fingerProfile ? fingerProfile.outerLoop : [],
                meshPoints: fingerProfile ? fingerProfile.meshPoints : null,
                meshTriangles: fingerProfile ? fingerProfile.meshTriangles : null,
                holes: fingerProfile ? fingerProfile.holeLoops : [],
                depth: fingerDepth,
                runs: [{ z0: -fingerDepth / 2, z1: fingerDepth / 2 }]
            }
        }
        return live3DToolingCache
    }

    function activeV5SectionFrame() {
        var live = runRenderFrame && runRenderFrame.live
            ? runRenderFrame.live : null
        var artifacts = live && live.frameArtifacts ? live.frameArtifacts : null
        return artifacts && artifacts.v5Direct === true
            ? artifacts.v5SectionFrame : null
    }

    function toolingStationCoordinate(positionIn) {
        var station = finite(positionIn, 0)
        var frame = activeV5SectionFrame()
        if (!frame || !frame.viewAxis)
            return station
        // Unfold-planned stations are relative to the planner's bend-band
        // centre (the whole stroke span). frame.origin is the selected graph
        // edge midpoint, so a joint stroke (Inverter Cover B1: two hinges
        // ~+-128 mm apart) needs the span-centre offset; no per-edge mirror.
        var plannedStage = currentPreviewStage(parsePreview())
        var current = sceneData && sceneData.currentBend
            ? sceneData.currentBend : currentPreviewBend(parsePreview())
        if (!current)
            return station
        var descriptors = v5StaticDescriptors(sceneData)
        var edge = descriptors ? descriptors.currentEdge : null
        if (!edge || !edge.hingeStart || !edge.hingeEnd)
            return station
        // Material viewDepth is sectionSignedDistance from frame.origin, whose
        // origin is the selected graph-edge midpoint. Planner stations are
        // bounds-center-relative. A compound operation can span several
        // disconnected graph edges, so its full required-span midpoint is not
        // necessarily the selected edge midpoint (Inverter Cover B1 is one
        // such case). Express that selected midpoint in planner coordinates
        // and preserve the endpoint order chosen by the oriented V5 frame.
        var usesY = bendAxisValue(current).toUpperCase() === "Y"
        var edgeStart = usesY
            ? finite(edge.hingeStart.y_in, NaN)
            : finite(edge.hingeStart.x_in, NaN)
        var edgeEnd = usesY
            ? finite(edge.hingeEnd.y_in, NaN)
            : finite(edge.hingeEnd.x_in, NaN)
        // Planner stations are centred on the bend's full hinge span (all
        // graph edges of this stroke, e.g. both sides of a flat-pattern
        // notch). sceneData.bounds may be expressed in a 0-based frame that
        // does not match graph hinge coordinates, so never use it here.
        var spanEdges = descriptors.topology.edgesBySourceSequence[
            String(bendId(current)) + ":" + String(descriptors.currentSequence)] || [edge]
        var spanLo = Infinity, spanHi = -Infinity
        for (var se = 0; se < spanEdges.length; se++) {
            var sEdge = spanEdges[se]
            if (!sEdge || !sEdge.hingeStart || !sEdge.hingeEnd)
                continue
            var sa = finite(usesY ? sEdge.hingeStart.y_in : sEdge.hingeStart.x_in, NaN)
            var sb = finite(usesY ? sEdge.hingeEnd.y_in : sEdge.hingeEnd.x_in, NaN)
            if (!isFinite(sa) || !isFinite(sb))
                continue
            spanLo = Math.min(spanLo, sa, sb)
            spanHi = Math.max(spanHi, sa, sb)
        }
        var plannerCenter = isFinite(spanLo) ? (spanLo + spanHi) / 2 : (edgeStart + edgeEnd) / 2
        if (!isFinite(edgeStart) || !isFinite(edgeEnd))
            return station
        var frameStart = RigidTransform3D.dot(
            RigidTransform3D.sub(frame.hingeStart, frame.origin), frame.viewAxis)
        var frameEnd = RigidTransform3D.dot(
            RigidTransform3D.sub(frame.hingeEnd, frame.origin), frame.viewAxis)
        // The section frame may be built on a different hinge of this stroke
        // than descriptors.currentEdge (notch-split bends): use the span edge
        // whose length matches the frame's hinge.
        var frameLength = Math.abs(frameEnd - frameStart)
        var bestErr = Math.abs(Math.abs(edgeEnd - edgeStart) - frameLength)
        for (var me = 0; me < spanEdges.length; me++) {
            var mEdge = spanEdges[me]
            if (!mEdge || !mEdge.hingeStart || !mEdge.hingeEnd)
                continue
            var ma = finite(usesY ? mEdge.hingeStart.y_in : mEdge.hingeStart.x_in, NaN)
            var mb = finite(usesY ? mEdge.hingeEnd.y_in : mEdge.hingeEnd.x_in, NaN)
            var err = Math.abs(Math.abs(mb - ma) - frameLength)
            if (isFinite(err) && err < bestErr - 1.0e-6) {
                bestErr = err
                edgeStart = ma
                edgeEnd = mb
            }
        }
        var sourceDelta = edgeEnd - edgeStart
        if (Math.abs(sourceDelta) < 1.0e-9)
            return station
        // Affine source->frame map along the hinge (handles sign, and an
        // origin that is not the hinge midpoint).
        var source = plannerCenter + station
        var mapped = frameStart + (source - edgeStart) * (frameEnd - frameStart) / sourceDelta
        // Planned stages: the section is already centred on the stroked
        // spans (v5CentreSectionOnCoaxialSpans), stations are frame-native.
        if (plannedStage)
            return station
        return mapped
    }

    function toolingStationDisplayOffset(positionIn, mode) {
        if (String(mode || liveProjectionMode).toUpperCase() !== "ISOMETRIC")
            return { x: 0, r: 0 }
        var station = toolingStationCoordinate(positionIn)
        var basis = isometricCameraBasis()
        return {
            x: basis.depthXPerIn * station,
            r: basis.depthRPerIn * station
        }
    }

    function normalizedToolingSegmentRuns(segments) {
        var normalized = []
        for (var index = 0; segments && index < segments.length; index++) {
            var start = finite(segments[index].startXIn, NaN)
            var end = finite(segments[index].endXIn, NaN)
            if (!isFinite(start) || !isFinite(end) || Math.abs(end - start) < 1.0e-6)
                continue
            normalized.push({
                startXIn: Math.min(start, end),
                endXIn: Math.max(start, end)
            })
        }
        normalized.sort(function(left, right) {
            return left.startXIn - right.startXIn
        })
        var runs = []
        var tolerance = 1.0e-5
        for (var segmentIndex = 0; segmentIndex < normalized.length; segmentIndex++) {
            var segment = normalized[segmentIndex]
            var run = runs.length > 0 ? runs[runs.length - 1] : null
            if (!run || segment.startXIn > run.endXIn + tolerance) {
                runs.push({
                    startXIn: segment.startXIn,
                    endXIn: segment.endXIn,
                    seamPositionsIn: []
                })
                continue
            }
            if (segment.startXIn > run.startXIn + tolerance
                    && segment.startXIn < run.endXIn + tolerance)
                run.seamPositionsIn.push(segment.startXIn)
            run.endXIn = Math.max(run.endXIn, segment.endXIn)
        }
        return runs
    }

    function punchDepthReference(segments) {
        var runs = normalizedToolingSegmentRuns(segments)
        if (runs.length === 0)
            return 0
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        var contactDepth = 0
        var nearestContactDistance = Infinity
        for (var runIndex = 0; runIndex < runs.length; runIndex++) {
            var start = toolingStationCoordinate(runs[runIndex].startXIn)
            var end = toolingStationCoordinate(runs[runIndex].endXIn)
            var minimum = Math.min(start, end)
            var maximum = Math.max(start, end)
            var candidate = minimum <= 0 && maximum >= 0
                ? 0 : (minimum + maximum) * 0.5
            var contactDistance = Math.abs(candidate)
            if (contactDistance < nearestContactDistance - 1.0e-9
                    || (Math.abs(contactDistance - nearestContactDistance) <= 1.0e-9
                        && candidate * cameraSign > contactDepth * cameraSign)) {
                nearestContactDistance = contactDistance
                contactDepth = candidate
            }
        }
        return contactDepth
    }

    function livePanelPunchDepthLayer(panel, punchDepth) {
        if (String(liveProjectionMode).toUpperCase() !== "ISOMETRIC"
                || !panel || !isFinite(Number(panel.viewDepthMin))
                || !isFinite(Number(panel.viewDepthMax)))
            return "FRONT"
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        var minimum = Math.min(Number(panel.viewDepthMin) * cameraSign,
                               Number(panel.viewDepthMax) * cameraSign)
        var maximum = Math.max(Number(panel.viewDepthMin) * cameraSign,
                               Number(panel.viewDepthMax) * cameraSign)
        var toolingDepth = finite(punchDepth, 0) * cameraSign
        var tolerance = 1.0e-5
        if (maximum < toolingDepth - tolerance)
            return "BEHIND"
        if (minimum > toolingDepth + tolerance)
            return "FRONT"
        return "STRADDLING"
    }

    function partitionLivePanelsAroundPunch(panels, punchSegments) {
        var result = { behind: [], front: [], straddling: [], punchDepth: 0 }
        result.punchDepth = punchDepthReference(punchSegments)
        for (var panelIndex = 0; panels && panelIndex < panels.length; panelIndex++) {
            var layer = livePanelPunchDepthLayer(panels[panelIndex], result.punchDepth)
            if (layer === "BEHIND")
                result.behind.push(panels[panelIndex])
            else if (layer === "STRADDLING")
                result.straddling.push(panels[panelIndex])
            else
                result.front.push(panels[panelIndex])
        }
        return result
    }

    // Punch prism in section coordinates (X, R, z): contour relative to the
    // tip, lifted to punchTipR, extruded over every installed run's station
    // interval. z is recovered from the run display offsets (offset = k*z).
    function livePunchSectionPrism(punchPlan, punchTipR) {
        if (!punchPlan || !punchPlan.contour || punchPlan.contour.length < 3)
            return null
        var basis = isometricCameraBasis()
        var kx = finite(basis.depthXPerIn, 0), kr = finite(basis.depthRPerIn, 0)
        var useX = Math.abs(kx) >= Math.abs(kr)
        var kDominant = useX ? kx : kr
        if (Math.abs(kDominant) < 1.0e-6)
            return null
        function depthOf(offset) {
            return (useX ? finite(offset.x, 0) : finite(offset.r, 0)) / kDominant
        }
        var tipR = finite(punchTipR, 0)
        var runs = []
        for (var runIndex = 0; runIndex < punchPlan.runs.length; runIndex++) {
            var run = punchPlan.runs[runIndex]
            runs.push({ run: run, zFar: depthOf(run.farOffset),
                        zNear: depthOf(run.nearOffset) })
        }
        return { contour: punchPlan.contour, tipR: tipR, runs: runs,
                 kx: kx, kr: kr, sign: finite(basis.viewAxisSign, 1) }
    }

    // Exact painter test of one planar panel against the punch prism. The
    // camera-ward ray direction in section coordinates is d = s*(-kx,-kr,1);
    // a punch vertex is in front of the panel when it lies on the side of the
    // panel plane that d points to. A centroid/station depth split is not
    // valid here: a bend wing spans the whole punch length and its order
    // with the punch is decided by the X-R cross-section, not by z.
    function livePanelPlaneAgainstPunch(panel, prism) {
        var points = panel && panel.polygon && panel.polygon.length >= 3
            ? panel.polygon : (panel ? panel.corners : null)
        if (!prism || !points || points.length < 3)
            return null
        var section = []
        for (var index = 0; index < points.length; index++) {
            var depth = Number(points[index].viewDepth)
            if (!isFinite(depth))
                return null
            section.push({ x: points[index].x - prism.kx * depth,
                           r: points[index].r - prism.kr * depth, z: depth })
        }
        var nx = 0, nr = 0, nz = 0, cx = 0, cr = 0, cz = 0
        for (var i = 0; i < section.length; i++) {
            var a = section[i], b = section[(i + 1) % section.length]
            nx += (a.r - b.r) * (a.z + b.z)
            nr += (a.z - b.z) * (a.x + b.x)
            nz += (a.x - b.x) * (a.r + b.r)
            cx += a.x; cr += a.r; cz += a.z
        }
        var length = Math.sqrt(nx * nx + nr * nr + nz * nz)
        if (length < 1.0e-9)
            return null
        nx /= length; nr /= length; nz /= length
        cx /= section.length; cr /= section.length; cz /= section.length
        var towardCamera = prism.sign * (-prism.kx * nx - prism.kr * nr + nz)
        if (Math.abs(towardCamera) < 1.0e-6)
            return null
        var cameraSide = towardCamera > 0 ? 1 : -1
        var plane = { nx: nx * cameraSide, nr: nr * cameraSide,
                      nz: nz * cameraSide,
                      offset: (nx * cx + nr * cr + nz * cz) * cameraSide }
        var tolerance = 1.0e-4
        var anyFront = false, anyBehind = false
        for (var runIndex = 0; runIndex < prism.runs.length; runIndex++) {
            var zs = [prism.runs[runIndex].zFar, prism.runs[runIndex].zNear]
            for (var c = 0; c < prism.contour.length; c++) {
                for (var zi = 0; zi < 2; zi++) {
                    var side = plane.nx * prism.contour[c].x
                        + plane.nr * (prism.contour[c].r + prism.tipR)
                        + plane.nz * zs[zi] - plane.offset
                    if (side > tolerance) anyFront = true
                    else if (side < -tolerance) anyBehind = true
                }
            }
        }
        var layer = anyFront && anyBehind ? "CUT"
            : (anyFront ? "BEHIND" : "FRONT")
        return { layer: layer, plane: plane,
                 zParallel: Math.abs(plane.nz) < 1.0e-3 }
    }

    // Screen footprint (display coordinates) of the punch part on the camera
    // side of a z-parallel panel plane: contour clipped by the X-R half-plane,
    // swept along each run's extrusion vector. Each loop is a positive-area
    // subpath so a nonzero clip yields their union.
    function livePunchNearPieceFootprint(prism, plane) {
        var clipped = []
        var contour = prism.contour
        function side(point) {
            return plane.nx * point.x + plane.nr * (point.r + prism.tipR)
                - plane.offset
        }
        for (var index = 0; index < contour.length; index++) {
            var current = contour[index]
            var next = contour[(index + 1) % contour.length]
            var currentSide = side(current), nextSide = side(next)
            if (currentSide >= 0)
                clipped.push({ x: current.x, r: current.r + prism.tipR })
            if ((currentSide >= 0) !== (nextSide >= 0)) {
                var t = currentSide / (currentSide - nextSide)
                clipped.push({ x: current.x + (next.x - current.x) * t,
                               r: current.r + prism.tipR
                                  + (next.r - current.r) * t })
            }
        }
        if (clipped.length < 3)
            return []
        var loops = []
        for (var runIndex = 0; runIndex < prism.runs.length; runIndex++) {
            var run = prism.runs[runIndex].run
            var far = [], near = []
            for (var p = 0; p < clipped.length; p++) {
                far.push({ x: clipped[p].x + run.farOffset.x,
                           r: clipped[p].r + run.farOffset.r })
                near.push({ x: clipped[p].x + run.nearOffset.x,
                            r: clipped[p].r + run.nearOffset.r })
            }
            loops.push(far, near)
            for (var e = 0; e < clipped.length; e++) {
                var n = (e + 1) % clipped.length
                loops.push([far[e], far[n], near[n], near[e]])
            }
        }
        return loops
    }

    function drawLivePunchClippedToFootprint(ctx, loops, sx, sy, pose) {
        if (!loops || loops.length === 0)
            return
        ctx.save()
        ctx.beginPath()
        for (var loopIndex = 0; loopIndex < loops.length; loopIndex++) {
            var loop = loops[loopIndex]
            var screen = []
            var area = 0
            for (var p = 0; p < loop.length; p++)
                screen.push({ x: sx(loop[p].x), y: sy(loop[p].r) })
            for (var q = 0; q < screen.length; q++) {
                var nextPoint = screen[(q + 1) % screen.length]
                area += screen[q].x * nextPoint.y - nextPoint.x * screen[q].y
            }
            if (Math.abs(area) < 1.0e-6)
                continue
            if (area < 0)
                screen.reverse()
            ctx.moveTo(screen[0].x, screen[0].y)
            for (var s = 1; s < screen.length; s++)
                ctx.lineTo(screen[s].x, screen[s].y)
            ctx.closePath()
        }
        ctx.clip()
        drawLivePunchDxf(ctx, sx, sy, pose)
        ctx.restore()
    }

    function livePanelPunchPaintPlan(panels, punchSegments, punchTipR) {
        var layers = partitionLivePanelsAroundPunch(panels, punchSegments)
        var plan = {
            behind: layers.behind,
            fullStraddlingRear: layers.straddling,
            clippedStraddlingFront: layers.straddling,
            front: layers.front,
            cut: [],
            punchDepth: layers.punchDepth
        }
        var prism = punchTipR === undefined ? null
            : livePunchSectionPrism(currentLivePunchPaintPlan(), punchTipR)
        if (!prism)
            return plan
        var behind = [], straddling = [], front = [], cut = []
        for (var index = 0; panels && index < panels.length; index++) {
            var panel = panels[index]
            var test = livePanelPlaneAgainstPunch(panel, prism)
            var layer = test ? test.layer
                : livePanelPunchDepthLayer(panel, layers.punchDepth)
            if (layer === "CUT" && test.zParallel) {
                var loops = livePunchNearPieceFootprint(prism, test.plane)
                if (loops.length > 0)
                    cut.push({ panel: panel, footprint: loops })
                else
                    front.push(panel)
            } else if (layer === "CUT") {
                var depthLayer = livePanelPunchDepthLayer(panel, layers.punchDepth)
                if (depthLayer === "BEHIND") behind.push(panel)
                else if (depthLayer === "FRONT") front.push(panel)
                else straddling.push(panel)
            } else if (layer === "BEHIND") {
                behind.push(panel)
            } else if (layer === "STRADDLING") {
                straddling.push(panel)
            } else {
                front.push(panel)
            }
        }
        plan.behind = behind
        plan.fullStraddlingRear = straddling
        plan.clippedStraddlingFront = straddling
        plan.front = front
        plan.cut = cut
        return plan
    }

    function retainedLivePanelPunchPaintPlan(frameArtifacts, panels,
                                              punchSegments, punchTipR) {
        if (frameArtifacts
