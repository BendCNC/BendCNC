        for (var d = 0; d < descriptors.descriptors.length; d++) {
            var descriptor = descriptors.descriptors[d]
            if (descriptor && isFinite(descriptor.materialThickness))
                thicknessById[descriptor.panelId] = descriptor.materialThickness
