            }
        }
        return null
    }

    function clipScreenPolygonByDepth(points, plane, punchDepth, keepFront) {
        var output = points ? points.slice(0) : []
        if (!plane || output.length < 3)
            return []
        var cameraSign = finite(isometricCameraBasis().viewAxisSign, 1)
        var threshold = finite(punchDepth, 0) * cameraSign
        function side(point) {
            return (plane.a * point.x + plane.b * point.y + plane.c)
                * cameraSign - threshold
