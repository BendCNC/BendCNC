            var offset = finite(phase.stationOffsetIn, 0)
            var half = topMachineWidthIn / 2
            return [{ startXIn: -half - offset, endXIn: half - offset, widthIn: topMachineWidthIn }]
        }
        // 3D is a true scene (no left-view mirror): use the stack order as planned.
